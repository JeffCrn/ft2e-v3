---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

// Transition de page — amendement A13 (2026-08-27) : le fondu uniforme de
// 300 ms devient un FONDU MONTANT — la page entrante fond en montant de
// 12 px (350 ms), la sortante fond en 200 ms. Les keyframes vivent dans
// motion.css ; la courbe est la courbe unique. Rien au premier chargement :
// les View Transitions ne jouent qu'en navigation interne, le LCP n'est
// pas concerné. prefers-reduced-motion coupe tout (garde dans motion.css).
const COURBE_UNIQUE = 'cubic-bezier(0.2, 0.7, 0.2, 1)';
const fonduMontant = {
  old: { name: 'vt-fondu-sortant', duration: '200ms', easing: COURBE_UNIQUE, fillMode: 'both' },
  new: { name: 'vt-fondu-montant', duration: '350ms', easing: COURBE_UNIQUE, fillMode: 'both' },
};
const transitionPage = { forwards: fonduMontant, backwards: fonduMontant };

/**
 * Les trois fontes du chemin critique, préchargées.
 *
 * Elles sont déclarées par `@import` dans `global.css` : le navigateur ne les
 * découvre donc qu'APRÈS avoir analysé la feuille, soit deux sauts de réseau
 * après le HTML. Avec `font-display: swap`, la première peinture se fait aux
 * métriques de la police de repli, puis tout se recompose à l'arrivée
 * d'Archivo — et la vedette de l'accueil est composée en `font-stretch: 125%`,
 * un axe `wdth` que le repli système ne possède pas. L'écart de chasse est
 * donc maximal, le titre change de nombre de lignes, et tout le bloc suivant
 * descend.
 *
 * Mesuré le 2026-08-16 sur le déploiement : CLS 0,098 pour un plafond de
 * 0,05, en UN SEUL décalage que Lighthouse impute explicitement — sous-tableau
 * `layout-shifts`, `cause: "Web font loaded"`, ces trois fichiers nommés.
 *
 * ⚠ `crossorigin` est obligatoire même en même origine : une fonte est
 * toujours cherchée en mode CORS anonyme, et un `preload` sans l'attribut
 * remplit un autre seau de cache que celui où `@font-face` viendra puiser —
 * le fichier part deux fois et le préchargement ne sert à rien.
 */
import archivoWdth from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import plexMono400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plexMono500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/accueil.jpg',
  ogType = 'website',
  canonical,
  // TEMPORAIRE : noindex global tant que le site est en démo sur ft2e-v3.vercel.app.
  // Remettre à `false` lors de la migration sur ft2e.fr (phase de production).
  noindex = true,
} = Astro.props;

const siteUrl = 'https://ft2e.fr';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Avant tout le reste du head : le préchargement ne vaut que s'il est
        découvert tôt. Voir le commentaire du frontmatter — c'est la
        correction du CLS de 0,098 relevé sur l'accueil. */}
    <link rel="preload" href={archivoWdth} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono500} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="FT2E" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-calcaire text-encre font-body">
    <a
      href="#contenu-principal"
      class="mono-label sr-only focus:not-sr-only focus:absolute focus:top-20 focus:left-4 focus:z-50 focus:bg-encre focus:text-papier focus:px-4 focus:py-3"
    >
      Aller au contenu principal
    </a>

    {/* La planche de page (charte v3 § 09) : le site est une feuille papier
        posée sur le calcaire, portée par l'ombre de page (0 0 90px encre 18 %).
        La trame 28 px à 7 % d'encre porte le fond ; les plans posés l'occultent. */}
    <div class="min-h-screen flex flex-col max-w-[1440px] mx-auto bg-papier trame-fond shadow-[var(--shadow-page)]">
      <slot name="header" />

      <main id="contenu-principal" class="flex-1" transition:animate={transitionPage}>
        <slot />
      </main>

      <slot name="footer" />
    </div>

    <slot name="json-ld" />

    {/* Révélation de plan (charte v3 § 13, amendement A11) : 1000 ms, 28 px,
        à l'entrée dans la vue, une seule fois par élément [data-plan] — et
        les grilles de cartes [data-plan-groupe] révèlent leurs enfants en
        cascade (80 ms par rang, le CSS de motion.css porte les rangs). Le
        CSS ne masque rien tant que html.js-plans n'est pas posé (fallback
        sans JS). */}
    <script>
      function initPlans() {
        document.documentElement.classList.add('js-plans');

        const plans = document.querySelectorAll<HTMLElement>('[data-plan], [data-plan-groupe]');
        if (!plans.length) return;

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const io = new IntersectionObserver(
          (entries, observer) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('plan-revele');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );

        plans.forEach((el) => {
          if (el.dataset.planBound) return;
          el.dataset.planBound = '1';
          if (reduced) {
            el.classList.add('plan-revele');
            return;
          }
          // Plan déjà dans le viewport (au-dessus du fold) : posé d'emblée,
          // sans fondu — l'élément LCP n'attend pas les 760 ms de révélation.
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add('plan-immediat', 'plan-revele');
            return;
          }
          io.observe(el);
        });
      }

      document.addEventListener('astro:page-load', initPlans);
    </script>
  </body>
</html>
