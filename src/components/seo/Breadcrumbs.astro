---
import JsonLd from './JsonLd.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
  theme?: 'light' | 'dark';
}

const { items, theme = 'light' } = Astro.props;

const siteUrl = 'https://ft2e.fr';

const jsonLdData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: `${siteUrl}${item.href}`,
  })),
};

const themeClasses = {
  light: {
    container: 'text-slate',
    separator: 'text-mist',
    link: 'hover:text-copper transition-colors duration-[400ms] ease-[var(--ease-blueprint)]',
    current: 'text-marine',
  },
  dark: {
    container: 'text-mist',
    separator: 'text-mist/50',
    link: 'hover:text-bright-copper transition-colors duration-[400ms] ease-[var(--ease-blueprint)]',
    current: 'text-cool-white',
  },
};

const t = themeClasses[theme];
---

<nav aria-label="Fil d’Ariane" class="max-w-[1200px] mx-auto px-4 md:px-6 py-4">
  <ol class:list={['mono-label font-normal flex flex-wrap items-center gap-2', t.container]} role="list">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && (
          <span aria-hidden="true" class={t.separator}>/</span>
        )}
        {index < items.length - 1 ? (
          <a href={item.href} class={t.link}>
            {item.label}
          </a>
        ) : (
          <span aria-current="page" class={t.current}>
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>

<JsonLd data={jsonLdData} />
