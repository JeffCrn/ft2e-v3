---
import type { HTMLAttributes } from 'astro/types';

// Boutons — charte v3 (§ 10) : rectangulaires, mono uppercase.
// Le survol bascule le fond (260 ms), le filet ne bouge pas.
// primary   → .btn-principal : aplat encre, filet clair 3 px à gauche,
//             survol → profond ; flèche « → » admise dans le libellé
// secondary → .btn-filaire : filaire 1 px à 28 % d'encre (fond clair)
// ghost     → alias legacy de secondary (.btn-filaire)
// profond   → .btn-blueprint-solid : filaire clair, sur réserve profonde uniquement
interface Props extends HTMLAttributes<'a'> {
  variante?: 'primary' | 'secondary' | 'ghost' | 'profond';
  href: string;
  externe?: boolean;
}

const { variante = 'primary', href, externe = false, class: className, ...rest } = Astro.props;

const classes: Record<string, string> = {
  primary: 'btn-principal',
  secondary: 'btn-filaire',
  ghost: 'btn-filaire',
  profond: 'btn-blueprint-solid',
};

const externeAttrs = externe
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<a
  href={href}
  class:list={[classes[variante], className]}
  {...externeAttrs}
  {...rest}
>
  <slot />
  {externe && (
    <span class="sr-only">(ouvre une nouvelle fenêtre)</span>
  )}
</a>
