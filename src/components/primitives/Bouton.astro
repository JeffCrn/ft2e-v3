---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variante?: 'primary' | 'secondary' | 'ghost';
  href: string;
  externe?: boolean;
}

const { variante = 'primary', href, externe = false, class: className, ...rest } = Astro.props;

const classes: Record<string, string> = {
  primary: 'bg-apple-blue text-white hover:bg-apple-blue/90',
  secondary: 'bg-near-black text-white hover:bg-near-black/90',
  ghost: 'bg-transparent text-link-blue border border-link-blue hover:bg-link-blue/5',
};

const externeAttrs = externe
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 px-4 py-2 rounded-[980px] font-normal text-sm tracking-tight transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-apple-blue focus-visible:ring-offset-2',
    classes[variante],
    className,
  ]}
  {...externeAttrs}
  {...rest}
>
  <slot />
  {externe && (
    <span class="sr-only">(ouvre une nouvelle fenêtre)</span>
  )}
</a>
