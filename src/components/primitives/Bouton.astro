---
import type { HTMLAttributes } from 'astro/types';

// Boutons blueprint : rectangulaires, mono uppercase, 1 px de bordure.
// primary   → plein encre sur fond clair (hover fond cuivre)
// secondary → plein clair sur fond encre (hover fond cuivre)
// ghost     → filaire (hover bordure + texte cuivre) — fonds clair et sombre
interface Props extends HTMLAttributes<'a'> {
  variante?: 'primary' | 'secondary' | 'ghost';
  href: string;
  externe?: boolean;
}

const { variante = 'primary', href, externe = false, class: className, ...rest } = Astro.props;

const classes: Record<string, string> = {
  primary: 'btn-blueprint-dark',
  secondary: 'btn-blueprint-solid',
  ghost: 'btn-blueprint text-slate hover:text-bright-copper',
};

const externeAttrs = externe
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<a
  href={href}
  class:list={[classes[variante], className]}
  {...externeAttrs}
  {...rest}
>
  <slot />
  {externe && (
    <span class="sr-only">(ouvre une nouvelle fenêtre)</span>
  )}
</a>
