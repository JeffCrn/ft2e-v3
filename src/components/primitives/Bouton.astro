---
import type { HTMLAttributes } from 'astro/types';

// Boutons : rectangulaires, mono uppercase, filaires — aucun bouton plein
// sans nécessité (charte v2, interdit 04). Le survol épaissit le filet
// d'un cran, sans changement de teinte ni déplacement.
// primary   → filet fort 2 px à l'encre (fond clair)
// secondary → filet clair 2 px (réserve profonde ou aplat encre)
// ghost     → filet d'indication 1 px (fond clair)
interface Props extends HTMLAttributes<'a'> {
  variante?: 'primary' | 'secondary' | 'ghost';
  href: string;
  externe?: boolean;
}

const { variante = 'primary', href, externe = false, class: className, ...rest } = Astro.props;

const classes: Record<string, string> = {
  primary: 'btn-blueprint-dark',
  secondary: 'btn-blueprint-solid',
  ghost: 'btn-blueprint',
};

const externeAttrs = externe
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<a
  href={href}
  class:list={[classes[variante], className]}
  {...externeAttrs}
  {...rest}
>
  <slot />
  {externe && (
    <span class="sr-only">(ouvre une nouvelle fenêtre)</span>
  )}
</a>
