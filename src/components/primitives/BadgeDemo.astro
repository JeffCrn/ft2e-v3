---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const isLiminaire = import.meta.env.PUBLIC_MODE === 'liminaire';
---

{isLiminaire && (
  <span
    class:list={[
      'mono-label inline-flex items-center px-2 py-0.5 border border-line-strong text-pivot',
      className,
    ]}
    aria-label="Contenu de démonstration"
  >
    Démo
  </span>
)}
