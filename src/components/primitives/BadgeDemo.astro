---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const isLiminaire = import.meta.env.PUBLIC_MODE === 'liminaire';
---

{isLiminaire && (
  <span
    class:list={[
      'inline-flex items-center px-2.5 py-0.5 rounded-[980px] text-[10px] uppercase tracking-widest font-medium bg-text-tertiary/15 text-text-secondary',
      className,
    ]}
    aria-label="Contenu de démonstration"
  >
    Démo
  </span>
)}
