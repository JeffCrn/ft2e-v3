---
// Cellule de cartouche : étiquette mono, valeur vedette statique.
// Charte v2 : aucun compteur qui s'incrémente — le chiffre est posé.
// Les vedettes chiffrées sont en Archivo 118/600 tabulaire (planche 08) ;
// les données de cartouche restent en mono.
interface Props {
  valeur: number;
  prefixe?: string;
  suffixe?: string;
  label: string;
  demo?: boolean;
}

const { valeur, prefixe = '', suffixe = '', label, demo = false } = Astro.props;

// Espace insécable avant une unité alphabétique (« 17 ans ») ; collé pour un symbole (« 150+ »).
const suffixeAffiche = suffixe && /^[a-zA-Zà-ÿ]/.test(suffixe) ? ` ${suffixe}` : suffixe;
---

<div class="bg-papier p-5">
  <p class="mono-label text-pivot font-normal">{label}</p>
  <p
    class="font-heading font-semibold text-[32px] leading-none text-profond tabular-nums mt-3"
    style="font-stretch: 118%; letter-spacing: -0.02em;"
  >
    {prefixe}{valeur.toLocaleString('fr-FR')}{suffixeAffiche}
  </p>
  {demo && <p class="mono-label text-pivot mt-1.5" aria-label="Donnée de démonstration">[démo]</p>}
</div>
