---
// Tracé de flux — le seul tracé animé du système (charte v3, § 13) :
// une polyligne verticale qui « câble » les grandes sections entre elles et
// se dessine UNE FOIS au chargement, en 900 ms, sur la courbe unique
// cubic-bezier(0.2, 0.7, 0.2, 1). Aucun suivi de défilement.
//
// Les nœuds carrés 7 px sont posés EXACTEMENT sur les frontières entre les
// sections marquées `data-trace-jalon` (mesurées dans le DOM au chargement),
// et la polyligne fait son coude sur chaque nœud. ResizeObserver recale la
// géométrie quand la hauteur de la zone change (images, polices, responsive).
//
// Géométrie générée en pixels réels (viewBox = hauteur mesurée) : dasharray,
// dashoffset et getTotalLength partagent la même unité — pas d'étirement SVG.
//
// Purement décoratif (aria-hidden). À placer dans un parent `relative`
// dimensionné qui contient (ou côtoie) les sections jalons.
interface Props {
  class?: string;
  /** Sélecteur des sections dont les frontières portent les nœuds. */
  jalons?: string;
}

const { class: className, jalons = '[data-trace-jalon]' } = Astro.props;
---

<div
  class:list={['pointer-events-none', className]}
  data-trace-flux
  data-trace-jalons={jalons}
  aria-hidden="true"
>
  <svg viewBox="0 0 40 1000" preserveAspectRatio="none" class="block w-full h-full">
    <polyline points="20,0 20,1000" fill="none" class="stroke-encre" stroke-width="1" />
  </svg>
</div>

<script>
  const X_GAUCHE = 20;
  const X_DROITE = 32;
  const DEMI_COUDE = 8; // le coude s'étend sur ±8 px autour du nœud
  const DUREE = 900; // ms — un seul tracé, une fois par chargement

  function initTraceFlux() {
    document.querySelectorAll<HTMLElement>('[data-trace-flux]').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = '1';

      const svg = el.querySelector('svg');
      const line = el.querySelector('polyline');
      if (!svg || !line) return;

      let len = 0;
      let noeudEls: HTMLElement[] = [];

      // Frontières entre sections jalons consécutives, en px depuis le haut
      // du tracé (milieu entre le bas de l'une et le haut de la suivante).
      const frontieres = (h: number) => {
        const sel = el.dataset.traceJalons;
        if (!sel) return [];
        const sections = Array.from(document.querySelectorAll(sel));
        const elTop = el.getBoundingClientRect().top;
        const ys: number[] = [];
        for (let i = 0; i < sections.length - 1; i++) {
          const a = sections[i].getBoundingClientRect();
          const b = sections[i + 1].getBoundingClientRect();
          const y = (a.bottom + b.top) / 2 - elTop;
          if (y > DEMI_COUDE + 4 && y < h - DEMI_COUDE - 4) ys.push(Math.round(y));
        }
        return ys;
      };

      // Régénère polyligne + nœuds en pixels réels : un coude par frontière,
      // le nœud centré sur l'amorce du coude.
      const layout = () => {
        const h = Math.max(el.clientHeight, 1);
        svg.setAttribute('viewBox', `0 0 40 ${h}`);

        const ys = frontieres(h);
        let x = X_GAUCHE;
        const pts: string[] = [`${x},0`];
        const noeuds: Array<{ x: number; y: number }> = [];

        ys.forEach((y) => {
          pts.push(`${x},${y - DEMI_COUDE}`);
          noeuds.push({ x, y: y - DEMI_COUDE });
          x = x === X_GAUCHE ? X_DROITE : X_GAUCHE;
          pts.push(`${x},${y + DEMI_COUDE}`);
        });
        pts.push(`${x},${h}`);
        line.setAttribute('points', pts.join(' '));

        noeudEls.forEach((n) => n.remove());
        noeudEls = noeuds.map(({ x: nx, y: ny }) => {
          const s = document.createElement('span');
          s.className = 'trace-noeud absolute w-[7px] h-[7px] bg-encre';
          s.style.cssText = `top:${ny}px;left:${nx}px;transform:translate(-50%,-50%);`;
          s.dataset.noeudAt = String(ny / h);
          el.appendChild(s);
          return s;
        });

        len = line.getTotalLength();
        line.style.strokeDasharray = String(len);
      };

      layout();

      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        line.style.strokeDashoffset = '0';
        noeudEls.forEach((n) => n.classList.add('revealed'));
        return;
      }

      // Dessin unique : dashoffset len → 0 en 900 ms ; chaque nœud se pose
      // au moment où la pointe le franchit.
      const dessine = () => {
        line.style.transition = `stroke-dashoffset ${DUREE}ms var(--ease-blueprint)`;
        line.style.strokeDashoffset = '0';
        el.dataset.dessine = '1';
        noeudEls.forEach((n) => {
          const t = Number(n.dataset.noeudAt ?? 0) * DUREE;
          setTimeout(() => n.classList.add('revealed'), t);
        });
      };

      line.style.strokeDashoffset = String(len);
      requestAnimationFrame(() => requestAnimationFrame(dessine));

      // Recalage silencieux : une fois dessiné, le tracé reste posé.
      if ('ResizeObserver' in window) {
        const ro = new ResizeObserver(() => {
          if (!el.isConnected) {
            ro.disconnect();
            return;
          }
          const dessineDeja = el.dataset.dessine === '1';
          layout();
          if (dessineDeja) {
            line.style.transition = 'none';
            line.style.strokeDashoffset = '0';
            noeudEls.forEach((n) => n.classList.add('revealed'));
          } else {
            line.style.strokeDashoffset = String(len);
          }
        });
        ro.observe(el);
      }
    });
  }

  document.addEventListener('astro:page-load', initTraceFlux);
</script>
