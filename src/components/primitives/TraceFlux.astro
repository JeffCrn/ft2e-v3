---
// Tracé de flux cuivre — signature motion de la planche système (section 02) :
// une polyligne verticale qui « câble » les sections entre elles et se dessine
// au fil du défilement, avec des nœuds carrés 7 px révélés au passage.
// Purement décoratif (aria-hidden). À placer dans un parent `relative`
// dimensionné ; la hauteur du tracé suit celle du parent.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Nœuds de connexion posés sur les coudes de la polyligne
// (top en % de la hauteur, left en px dans la colonne de 40 px).
const noeuds = [
  { top: 17, left: 20 },
  { top: 43, left: 32 },
  { top: 70, left: 20 },
];
---

<div class:list={['pointer-events-none', className]} data-trace-flux aria-hidden="true">
  <svg viewBox="0 0 40 1000" preserveAspectRatio="none" class="block w-full h-full">
    <polyline
      points="20,0 20,168 32,172 32,428 20,432 20,698 32,702 32,1000"
      fill="none"
      stroke="#c46a38"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
    />
  </svg>
  {noeuds.map((n) => (
    <span
      class="trace-noeud absolute w-[7px] h-[7px] bg-copper"
      style={`top: ${n.top}%; left: ${n.left}px; transform: translate(-50%, -50%);`}
      data-noeud-at={n.top}
    ></span>
  ))}
</div>

<script>
  function initTraceFlux() {
    document.querySelectorAll<HTMLElement>('[data-trace-flux]').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = '1';

      const line = el.querySelector('polyline');
      if (!line) return;
      const noeuds = el.querySelectorAll<HTMLElement>('.trace-noeud');

      // stroke-dasharray/offset opèrent en unités viewBox : getTotalLength
      // reste valide malgré l'étirement preserveAspectRatio="none".
      const len = line.getTotalLength();
      line.style.strokeDasharray = String(len);

      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        line.style.strokeDashoffset = '0';
        noeuds.forEach((n) => n.classList.add('revealed'));
        return;
      }

      line.style.strokeDashoffset = String(len);

      let ticking = false;
      const onScroll = () => {
        if (!el.isConnected) {
          window.removeEventListener('scroll', onScroll);
          return;
        }
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const r = el.getBoundingClientRect();
          const vh = window.innerHeight || 800;
          // La pointe du tracé suit le bas du viewport : p = fraction du
          // tracé déjà « traversée » par le lecteur, sans inertie.
          const p = Math.min(1, Math.max(0, (vh - r.top) / r.height));
          line.style.strokeDashoffset = String(len * (1 - p));
          noeuds.forEach((n) => {
            if (p * 100 >= Number(n.dataset.noeudAt ?? 0)) n.classList.add('revealed');
          });
        });
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    });
  }

  document.addEventListener('astro:page-load', initTraceFlux);
</script>
