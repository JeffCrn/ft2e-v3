---
// Équerres d'image — charte v3 (§ 13) : quatre équerres d'un pixel au
// voile (#E1F4F4), 18 px de côté UNIFORMES, posées DANS les angles avec
// un retrait de 5 px — collées au bord, elles se confondaient avec le
// cadre du média. Repère de tirage, pas un encadrement décoratif.
// Les deux mesures viennent des jetons `--equerre-cote` / `--equerre-retrait`,
// dont dérive aussi l'implantation de la légende (`.legende-media`) : les
// deux ne peuvent donc pas se chevaucher par dérive de l'un ou de l'autre.
// Parent `relative` requis (média duotone) ; purement décoratif. Nom de
// fichier conservé pour l'historique (le cuivre n'existe plus).
// `coins="deux"` n'affiche que haut-gauche / bas-droite (variante mobile).
interface Props {
  coins?: 'quatre' | 'deux';
  /** Ignoré depuis la charte v3 — les équerres sont uniformes (18 px). */
  taille?: 18 | 16 | 14;
}

const { coins = 'quatre' } = Astro.props;
const dim = 'w-[var(--equerre-cote)] h-[var(--equerre-cote)]';
const pos = {
  hg: 'left-[var(--equerre-retrait)] top-[var(--equerre-retrait)] border-l border-t',
  hd: 'right-[var(--equerre-retrait)] top-[var(--equerre-retrait)] border-r border-t',
  bg: 'left-[var(--equerre-retrait)] bottom-[var(--equerre-retrait)] border-l border-b',
  bd: 'right-[var(--equerre-retrait)] bottom-[var(--equerre-retrait)] border-r border-b',
};
---

<div aria-hidden="true">
  <div class:list={['absolute border-voile', pos.hg, dim]}></div>
  {coins === 'quatre' && <div class:list={['absolute border-voile', pos.hd, dim]}></div>}
  {coins === 'quatre' && <div class:list={['absolute border-voile', pos.bg, dim]}></div>}
  <div class:list={['absolute border-voile', pos.bd, dim]}></div>
</div>
