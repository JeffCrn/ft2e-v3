---
// Capsule technique blueprint : rectangle mono 1 px, pas de rayon.
interface Props {
  variante?: 'secteur' | 'typologie' | 'mission';
  class?: string;
}

const { variante = 'secteur', class: className } = Astro.props;

const classes: Record<string, string> = {
  secteur: 'text-encre border-line-strong',
  typologie: 'text-pivot',
  mission: 'text-pivot',
};
---

<span
  class:list={['chip-blueprint', classes[variante], className]}
>
  <slot />
</span>
