---
interface Props {
  variante?: 'secteur' | 'typologie' | 'mission';
  class?: string;
}

const { variante = 'secteur', class: className } = Astro.props;

const classes: Record<string, string> = {
  secteur: 'bg-apple-blue/10 text-apple-blue',
  typologie: 'bg-near-black/8 text-near-black',
  mission: 'bg-apple-blue/10 text-apple-blue',
};
---

<span
  class:list={[
    'inline-flex items-center px-3 py-1 rounded-[980px] text-xs tracking-tight font-normal',
    classes[variante],
    className,
  ]}
>
  <slot />
</span>
