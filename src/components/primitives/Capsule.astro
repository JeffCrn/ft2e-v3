---
// Étiquette de mission — charte v3 (§ 10) : mono 10 px, filet 1 px à
// 28 % d'encre, jamais d'aplat. Six au maximum par bloc. Étiquette
// passive : le chip interactif (.chip-blueprint) reste réservé aux filtres.
interface Props {
  variante?: 'secteur' | 'typologie' | 'mission';
  class?: string;
}

const { variante = 'secteur', class: className } = Astro.props;

const classes: Record<string, string> = {
  secteur: 'text-encre',
  typologie: '',
  mission: '',
};
---

<span
  class:list={['etiquette-mission', classes[variante], className]}
>
  <slot />
</span>
