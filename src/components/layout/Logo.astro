---
// Monogramme FT2E — charte v2 (planche 04).
// Un cadre ouvert sur ses flancs (l'ouvrage) traversé par un tracé qui en
// sort de 6,5 unités : le réseau. Extrémités arrondies pour le flux, angles
// vifs pour le cadre — la distinction tient à la forme, pas à la valeur.
//
// version :
//   principal     → sur papier : flux au profond, cadre et mot au pivot
//   inverse       → sur réserve profonde : cadre au clair, flux au voile
//   valeur-unique → une seule encre (tampon, gravure, marquage)
// forme :
//   complet → cadre + mot FT2E (+ baseline optionnelle)
//   cadre   → cadre seul, trait épaissi (sous 180 px, le mot tombe)
interface Props {
  class?: string;
  version?: 'principal' | 'inverse' | 'valeur-unique';
  forme?: 'complet' | 'cadre';
  baseline?: boolean;
  decoratif?: boolean;
}

const {
  class: className,
  version = 'principal',
  forme = 'complet',
  baseline = false,
  decoratif = true,
} = Astro.props;

const couleurs = {
  principal: { cadre: '#336667', flux: '#001718' },
  inverse: { cadre: '#99CCCD', flux: '#E1F4F4' },
  'valeur-unique': { cadre: '#00393A', flux: '#00393A' },
}[version];

const a11y = decoratif
  ? ({ 'aria-hidden': 'true' } as const)
  : ({ role: 'img', 'aria-label': "FT2E — bureau d'études techniques" } as const);
---

{forme === 'cadre' ? (
  <svg
    viewBox="0 0 90 90"
    class:list={['block shrink-0', className]}
    focusable="false"
    {...a11y}
  >
    <g fill="none" stroke-width="9">
      <path stroke={couleurs.cadre} stroke-linejoin="miter" d="M8,42 V8 H82 V42 M82,64 V82 H8 V64" />
      <path stroke={couleurs.flux} stroke-linecap="round" stroke-linejoin="round" d="M0,54 H28 V26 H58 V54 H90" />
    </g>
  </svg>
) : (
  <svg
    viewBox="0 0 330 90"
    class:list={['block shrink-0', className]}
    focusable="false"
    {...a11y}
  >
    <g transform="translate(5,5)" fill="none" stroke-width="7">
      <path stroke={couleurs.cadre} stroke-linejoin="miter" d="M3.5,42 V3.5 H76.5 V42 M76.5,66 V76.5 H3.5 V66" />
      <path stroke={couleurs.flux} stroke-linecap="round" stroke-linejoin="round" d="M-3,54 H26 V26 H54 V54 H83" />
    </g>
    <g transform="translate(104,16)">
      <path fill={couleurs.cadre} d="M0,0 H24 V7 H7 V17.5 H19 V24.5 H7 V40 H0 Z" />
      <path fill={couleurs.cadre} transform="translate(35,0)" d="M0,0 H26 V7 H16.5 V40 H9.5 V7 H0 Z" />
      <g transform="translate(72,0)" fill="none" stroke={couleurs.flux} stroke-width="7">
        <path d="M3.5,12 A8.5,8.5 0 0 1 20.5,12 C20.5,19 17,27.5 3,36.5" />
        <path d="M0,36.5 H24" />
      </g>
      <path fill={couleurs.cadre} transform="translate(107,0)" d="M0,0 H24 V7 H7 V16.5 H18 V23.5 H7 V33 H24 V40 H0 Z" />
    </g>
    {baseline && (
      <text
        x="104"
        y="74"
        font-family="'IBM Plex Mono', monospace"
        font-size="8.5"
        letter-spacing="2.6"
        fill={couleurs.cadre}
      >BUREAU D'ÉTUDES TECHNIQUES</text>
    )}
  </svg>
)}
