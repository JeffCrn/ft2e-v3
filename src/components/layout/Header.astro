---
import { NAV_LINKS, SITE_TAGLINE } from '../../lib/constants';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 inset-x-0 z-50 h-14 md:h-[74px] bg-papier border-b border-line">
  <nav class="max-w-[1200px] mx-auto px-4 md:px-6 flex items-center gap-6 md:gap-8 h-full" aria-label="Navigation principale">
    <a href="/" class="flex items-center shrink-0" aria-label="FT2E — Accueil">
      {/* Sous 180 px de large, le mot tombe : cadre seul sur mobile */}
      <Logo forme="cadre" class="h-[30px] md:hidden" />
      <Logo forme="complet" class="hidden md:block h-[44px] w-auto" />
    </a>

    <span class="mono-label hidden xl:inline text-pivot" aria-hidden="true">{SITE_TAGLINE}</span>

    <ul class="hidden md:flex items-center gap-6 ml-auto" role="list">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'mono-label pb-1 border-b-2 motion-safe:transition-colors motion-safe:duration-200 motion-safe:ease-[var(--ease-blueprint)]',
              currentPath === link.href
                ? 'text-encre border-encre'
                : 'text-pivot border-transparent hover:text-encre',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      class="md:hidden ml-auto p-2 text-encre"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true" focusable="false">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </nav>

  <div class="hidden md:hidden bg-papier border-t border-line" data-menu-panel>
    <ul class="max-w-[1200px] mx-auto px-4 py-4" role="list">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'mono-label block py-3 border-b border-line motion-safe:transition-colors motion-safe:duration-200 motion-safe:ease-[var(--ease-blueprint)]',
              currentPath === link.href ? 'text-encre' : 'text-pivot hover:text-encre',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<div class="h-14 md:h-[74px]" aria-hidden="true" data-nav-spacer></div>

<script>
  function initMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    if (!toggle || !panel) return;

    if (toggle.dataset.menuBound) return;
    toggle.dataset.menuBound = '1';

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      panel.classList.toggle('hidden');
    });
  }

  document.addEventListener('astro:page-load', initMenu);
</script>
