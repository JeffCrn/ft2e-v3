---
import { NAV_LINKS, SITE_TAGLINE } from '../../lib/constants';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 inset-x-0 z-50 h-14 md:h-[74px] bg-encre border-b border-mist/25">
  <nav class="max-w-[1200px] mx-auto px-4 md:px-6 flex items-center gap-6 md:gap-8 h-full" aria-label="Navigation principale">
    <a href="/" class="group flex items-center gap-3 shrink-0" aria-label="FT2E — Accueil">
      <Logo class="h-[30px] md:h-[36px]" />
      <span aria-hidden="true" class="font-heading font-bold uppercase tracking-tight text-lg leading-none text-cool-white group-hover:text-bright-copper motion-safe:transition-colors motion-safe:duration-500 motion-safe:ease-[var(--ease-blueprint)]" style="font-stretch: 118%;">FT<span class="text-bright-copper group-hover:text-cool-white motion-safe:transition-colors motion-safe:duration-500 motion-safe:ease-[var(--ease-blueprint)]">2</span>E</span>
    </a>

    <span class="mono-label hidden xl:inline text-mist" aria-hidden="true">{SITE_TAGLINE}</span>

    <ul class="hidden md:flex items-center gap-6 ml-auto" role="list">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'mono-label motion-safe:transition-colors motion-safe:duration-[400ms] motion-safe:ease-[var(--ease-blueprint)]',
              currentPath === link.href
                ? 'text-cool-white border-b border-copper pb-1'
                : 'text-mist hover:text-bright-copper',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      class="md:hidden ml-auto p-2 text-cool-white"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true" focusable="false">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </nav>

  <div class="hidden md:hidden bg-encre border-t border-mist/25" data-menu-panel>
    <ul class="max-w-[1200px] mx-auto px-4 py-4" role="list">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'mono-label block py-3 border-b border-mist/15 motion-safe:transition-colors motion-safe:duration-[400ms] motion-safe:ease-[var(--ease-blueprint)]',
              currentPath === link.href ? 'text-cool-white' : 'text-mist hover:text-bright-copper',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<div class="h-14 md:h-[74px]" aria-hidden="true" data-nav-spacer></div>

<script>
  function initMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    if (!toggle || !panel) return;

    if (toggle.dataset.menuBound) return;
    toggle.dataset.menuBound = '1';

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      panel.classList.toggle('hidden');
    });
  }

  document.addEventListener('astro:page-load', initMenu);
</script>
