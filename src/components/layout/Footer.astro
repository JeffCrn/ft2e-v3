---
import { NAV_LINKS, SITE_NAME, FT2E_BUSINESS } from '../../lib/constants';
import JsonLd from '../seo/JsonLd.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="bg-encre border-t border-copper mt-auto" role="contentinfo">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 py-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-3">
          <Logo />
          <span class="font-heading font-bold uppercase tracking-tight text-lg leading-none text-cool-white" aria-hidden="true" style="font-stretch: 118%;">FT<span class="text-bright-copper">2</span>E</span>
        </div>
        <p class="mono-data text-mist mt-4 leading-relaxed max-w-[36ch]">
          Bureau d’études techniques pluridisciplinaire à La Rochelle. Fluides, thermique, électricité, SSI, BIM. Au service des architectes et maîtres d’ouvrage depuis 2008.
        </p>
      </div>

      <div>
        <p class="mono-label text-mist mb-4">Plan du site</p>
        <ul class="space-y-2" role="list">
          {NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="mono-data text-cool-white hover:text-bright-copper motion-safe:transition-colors motion-safe:duration-[400ms] motion-safe:ease-[var(--ease-blueprint)]">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="mono-label text-mist mb-4">Contact</p>
        <address class="not-italic mono-data text-cool-white space-y-2 leading-relaxed">
          <p>35 Rue Nicolas Denys de Fronsac<br />17000 La Rochelle</p>
          <p>
            <a href="tel:+33546278593" class="hover:text-bright-copper motion-safe:transition-colors motion-safe:duration-[400ms] motion-safe:ease-[var(--ease-blueprint)]">05&nbsp;46&nbsp;27&nbsp;85&nbsp;93</a>
          </p>
          <p>
            <a href="mailto:ft2e@ft2e.fr" class="hover:text-bright-copper motion-safe:transition-colors motion-safe:duration-[400ms] motion-safe:ease-[var(--ease-blueprint)]">ft2e@ft2e.fr</a>
          </p>
        </address>
        <p class="mono-label text-copper mt-4">réponse sous 48&nbsp;h ouvrées</p>
      </div>

      <div>
        <p class="mono-label text-mist mb-4">Interventions</p>
        <p class="mono-data text-mist leading-relaxed">
          La Rochelle · Rochefort · Royan · Saintes · Île de Ré · Île d’Oléron · Niort · La Roche-sur-Yon
        </p>
      </div>
    </div>

    <div class="border-t border-mist/25 mt-10 pt-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
      <p class="mono-data text-mist">© {year} {SITE_NAME}. Tous droits réservés.</p>
      <nav aria-label="Mentions légales" class="flex flex-wrap gap-5">
        <a href="/mentions-legales" class="mono-data text-mist hover:text-bright-copper motion-safe:transition-colors motion-safe:duration-[400ms] motion-safe:ease-[var(--ease-blueprint)]">Mentions légales</a>
        <a href="/politique-confidentialite" class="mono-data text-mist hover:text-bright-copper motion-safe:transition-colors motion-safe:duration-[400ms] motion-safe:ease-[var(--ease-blueprint)]">Confidentialité</a>
        <a href="/accessibilite" class="mono-data text-mist hover:text-bright-copper motion-safe:transition-colors motion-safe:duration-[400ms] motion-safe:ease-[var(--ease-blueprint)]">Accessibilité</a>
      </nav>
    </div>
  </div>
  <JsonLd data={FT2E_BUSINESS} />
</footer>
