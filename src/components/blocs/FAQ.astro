---
// FAQ — charte v3 : filets 1 px de rang 2 entre items, aucun rayon,
// chevron sobre (bascule d'état instantanée — les quatre mouvements du
// système, § 13, n'incluent aucune rotation animée). Le focus du summary
// est porté par le cadre global 2 px pivot (:focus-visible).
interface FaqItem {
  question: string;
  reponse: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <div class="divide-y divide-filet-2">
    {items.map((item) => (
      <details class="group py-2.5">
        <summary class="flex items-center justify-between cursor-pointer font-heading font-semibold text-encre text-base leading-[1.3] list-none" style="font-stretch: 112%;">
          <span>{item.question}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="square"
            class="shrink-0 ml-4 text-pivot group-open:rotate-180"
            aria-hidden="true"
            focusable="false"
          >
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </summary>
        <div class="mt-2 pb-2 text-[15px] text-pivot leading-[1.55]">
          {item.reponse}
        </div>
      </details>
    ))}
  </div>
)}
