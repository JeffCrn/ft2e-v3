---
import type { CollectionEntry } from 'astro:content';

interface Props {
  expertise: CollectionEntry<'expertises'>;
}

const { expertise } = Astro.props;
const { titre, accroche, ordre, missions_liees } = expertise.data;

const numero = String(ordre).padStart(2, '0');
const missions = (missions_liees ?? []).join(' · ').toLowerCase();
---

<a
  href={`/expertises/${expertise.id}`}
  class="group block bg-cool-white p-6 transition-colors duration-[400ms] ease-[var(--ease-blueprint)] hover:bg-paper"
>
  <div class="flex justify-between items-baseline gap-4">
    <span class="mono-label font-normal text-copper tabular-nums">{numero}</span>
    {missions && <span class="mono-label font-normal text-mist normal-case tracking-[0.1em]">{missions}</span>}
  </div>
  <h3 class="type-h2 text-marine text-[19px] leading-[1.1] mt-4 group-hover:text-copper transition-colors duration-[400ms] ease-[var(--ease-blueprint)]">
    {titre}
  </h3>
  <p class="mt-3 text-[15px] font-light text-slate leading-[1.55] line-clamp-3">
    {accroche}
  </p>
</a>
