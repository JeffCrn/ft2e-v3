---
import Bouton from '../primitives/Bouton.astro';

interface Props {
  titre?: string;
  texte?: string;
}

const {
  titre = 'Un projet en tête ? Parlons-en.',
  texte = 'Nous répondons sous 48 h ouvrées.',
} = Astro.props;
---

<section class="bg-encre border-t border-copper py-16 md:py-20">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 flex flex-col md:flex-row md:items-center gap-8">
    <div class="md:flex-1" data-reveal data-parallax>
      <h2 class="type-h2 text-cool-white text-xl" style="font-stretch: 118%;">
        {titre}
      </h2>
      <p class="mono-label text-copper mt-4">
        {texte}
      </p>
    </div>
    <div data-reveal>
      <Bouton href="/contact" variante="secondary">
        Parlons de votre projet
      </Bouton>
    </div>
  </div>
</section>
