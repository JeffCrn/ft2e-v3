---
import Bouton from '../primitives/Bouton.astro';

// Bande d'appel finale — claire (le papier gouverne ; la réserve profonde
// est réservée aux relevés mesurés). Filet de tête au rang ouvrage (4 px).
interface Props {
  titre?: string;
  texte?: string;
}

const {
  titre = 'Un projet en tête ? Parlons-en.',
  texte = 'Nous répondons sous 48 h ouvrées.',
} = Astro.props;
---

<section class="bg-calcaire border-t-4 border-encre py-16 md:py-20">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 flex flex-col md:flex-row md:items-center gap-8">
    <div class="md:flex-1">
      <h2 class="type-h2 text-encre text-xl">
        {titre}
      </h2>
      <p class="mono-label text-pivot mt-4">
        {texte}
      </p>
    </div>
    <div>
      <Bouton href="/contact" variante="primary">
        Parlons de votre projet
      </Bouton>
    </div>
  </div>
</section>
