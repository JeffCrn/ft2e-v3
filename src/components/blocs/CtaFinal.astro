---
import Bouton from '../primitives/Bouton.astro';

interface Props {
  titre?: string;
  texte?: string;
}

const {
  titre = 'Un projet en tête ?',
  texte = 'Parlons-en. Nous répondons sous 48 h ouvrées.',
} = Astro.props;
---

<section class="bg-marine-deep py-24">
  <div class="max-w-[980px] mx-auto px-4 md:px-6 text-center">
    <h2 class="font-heading font-semibold text-white tracking-tight" style="font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.10;" data-reveal data-parallax>
      {titre}
    </h2>
    <p class="mt-4 text-mist text-lg tracking-tight max-w-xl mx-auto" data-reveal>
      {texte}
    </p>
    <div class="mt-8" data-reveal>
      <Bouton href="/contact" variante="primary">
        Parlons de votre projet
      </Bouton>
    </div>
  </div>
</section>
