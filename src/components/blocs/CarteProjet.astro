---
import type { CollectionEntry } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import CoinsCuivre from '../primitives/CoinsCuivre.astro';

// Vignette cartouche — charte v2 (planche 07, format « vignette ») :
// média duotone à équerres 14 px, puis bandeau à barre de rang 4 px,
// intitulé et référence mono. Même ordre de lecture que le cartouche
// plein : intitulé, référence, date.
interface Props {
  projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { titre, lieu, annee, demo, image_principale, image_principale_alt } = projet.data;

const imageExiste = fs.existsSync(path.join(process.cwd(), 'public', image_principale));

const reference = `FT2E—${annee}`;
---

<a
  href={`/references/${projet.id}`}
  class="group block border border-line-strong transition-[box-shadow,border-color] duration-200 ease-[var(--ease-blueprint)] hover:border-encre hover:shadow-[inset_0_0_0_1px_var(--color-encre)]"
>
  <div class:list={['aspect-[3/2] relative', imageExiste ? 'duotone-photo' : 'duotone-media']}>
    {imageExiste && (
      <img
        src={image_principale}
        alt={image_principale_alt}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    )}
    <CoinsCuivre taille={14} />
    {demo && (
      <span class="absolute right-3 top-2.5 mono-label font-normal text-voile z-10">[démo]</span>
    )}
  </div>
  <div class="grid grid-cols-[4px_1fr] border-t border-line">
    <div class="bg-encre" aria-hidden="true"></div>
    <div class="px-4 py-3.5">
      <h3 class="type-intitule text-profond text-[15px]">
        {titre}
      </h3>
      <p class="mono-data text-[11px] text-pivot mt-1.5">{reference} · {lieu}</p>
    </div>
  </div>
</a>
