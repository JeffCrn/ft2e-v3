---
import type { CollectionEntry } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import BadgeDemo from '../primitives/BadgeDemo.astro';
import Capsule from '../primitives/Capsule.astro';

interface Props {
  projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { titre, secteur, moa, annee, demo, image_principale, image_principale_alt } = projet.data;

const imageExiste = fs.existsSync(path.join(process.cwd(), 'public', image_principale));
---

<a
  href={`/references/${projet.id}`}
  class="group block bg-light-gray rounded-lg overflow-hidden transition-all hover:shadow-soft"
  data-card-tilt
>
  <div class="h-48 bg-dark-surface-1 flex items-center justify-center relative overflow-hidden">
    {imageExiste ? (
      <img
        src={image_principale}
        alt={image_principale_alt}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <p class="text-white/40 text-sm" aria-hidden="true">[Photo à venir]</p>
    )}
    {demo && (
      <div class="absolute top-3 right-3">
        <BadgeDemo />
      </div>
    )}
  </div>
  <div class="p-4">
    <div class="flex items-start justify-between gap-2 mb-2">
      <Capsule variante="secteur">{secteur}</Capsule>
      <span class="text-xs text-text-secondary">{annee}</span>
    </div>
    <h3 class="font-heading font-semibold text-marine text-sm leading-snug tracking-tight group-hover:text-apple-blue transition-colors">
      {titre}
    </h3>
    <p class="mt-1 text-xs text-text-secondary tracking-tight">{moa}</p>
  </div>
</a>
