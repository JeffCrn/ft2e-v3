---
import type { CollectionEntry } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import CoinsCuivre from '../primitives/CoinsCuivre.astro';

// Vignette de projet — charte v3 (§ 09/10) : un plan posé (bordure 1 px
// filet-2, ombre de rang 1), média duotone 3:2 à équerres, pied cartouche
// calcaire avec intitulé et données mono. Le survol bascule le pied du
// calcaire au papier (300 ms) — aucun déplacement, le plan ne bouge pas.
interface Props {
  projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { titre, lieu, annee, demo, image_principale, image_principale_alt } = projet.data;

const imageExiste = fs.existsSync(path.join(process.cwd(), 'public', image_principale));

const reference = `FT2E—${annee}`;
---

<a href={`/references/${projet.id}`} class="group block plan-pose">
  <div class:list={['aspect-[3/2] relative', imageExiste ? 'duotone-photo' : 'duotone-media']}>
    {imageExiste && (
      <img
        src={image_principale}
        alt={image_principale_alt}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    )}
    <CoinsCuivre />
    {demo && (
      <span class:list={['absolute right-3 top-2.5 mono-label font-normal z-10', imageExiste ? 'text-voile' : 'text-pivot']}>[démo]</span>
    )}
  </div>
  <div class="bg-calcaire border-t border-filet-2 px-4 py-3.5 transition-colors duration-300 ease-[var(--ease-blueprint)] group-hover:bg-papier">
    <h3 class="type-intitule text-encre text-[15px]">
      {titre}
    </h3>
    <p class="mono-data text-pivot mt-1.5">{reference} · {lieu}</p>
  </div>
</a>
