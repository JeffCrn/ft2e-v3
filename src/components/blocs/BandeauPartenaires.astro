---
// Maîtres d'ouvrage et clients réels cités dans la plaquette FT2E 2024
// (docs/20-source-plaquette-2024.md) — données vérifiées, pas de badge démo.
const partenaires = [
  'Fountaine Pajot',
  'Clairsienne',
  'Compagnie Vendéenne du Logement',
  'Dufour',
  'Catana Group',
  'Carl Zeiss Meditec',
  'Altarea',
  'Port de Plaisance de La Rochelle',
  'Groupe hospitalier La Rochelle-Ré-Aunis',
];
---

{/* Bande calcaire — charte v3 : surface secondaire opaque sur la trame,
    filet haut 1 px de rang 1 (l'épaisseur ne porte plus le rang),
    intitulés à l'encre. */}
<section class="py-12 md:py-14 bg-calcaire border-t border-filet-1">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <h2 class="mono-label text-pivot mb-5">ils ont confié leurs projets à FT2E</h2>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      {partenaires.map((nom) => (
        <span class="type-intitule text-encre text-base">
          {nom}
        </span>
      ))}
    </div>
  </div>
</section>
