---
import BadgeDemo from '../primitives/BadgeDemo.astro';

const partenaires = [
  'Domidylle',
  'Médiatim',
  'Édouard Denis',
  'Pitch',
  'Réalités',
  'Bouygues',
  'OPH La Rochelle',
  'Habitat 17',
  'Ville de Rochefort',
];
---

<section class="py-16 bg-white">
  <div class="max-w-[980px] mx-auto px-4 md:px-6">
    <div class="flex items-center justify-center gap-3 mb-8" data-reveal>
      <h2 class="text-xs font-semibold text-text-secondary uppercase tracking-widest">
        Ils nous font confiance
      </h2>
      <BadgeDemo />
    </div>
    <div class="flex flex-wrap justify-center gap-3" data-reveal-stagger>
      {partenaires.map((nom) => (
        <span class="px-4 py-2 bg-light-gray rounded-[980px] text-sm text-text-secondary tracking-tight">
          {nom}
        </span>
      ))}
    </div>
  </div>
</section>
