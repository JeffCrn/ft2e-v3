---
// Maîtres d'ouvrage et clients réels cités dans la plaquette FT2E 2024
// (docs/20-source-plaquette-2024.md) — données vérifiées, pas de badge démo.
const partenaires = [
  'Fountaine Pajot',
  'Clairsienne',
  'Compagnie Vendéenne du Logement',
  'Dufour',
  'Catana Group',
  'Carl Zeiss Meditec',
  'Altarea',
  'Port de Plaisance de La Rochelle',
  'Groupe hospitalier La Rochelle-Ré-Aunis',
];
---

{/* Bande claire — le clair gouverne (charte v2) : surface calcaire,
    filet de section 2 px, intitulés à l'encre. */}
<section class="py-14 bg-calcaire border-t-2 border-encre">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="flex items-center gap-3 mb-5">
      <h2 class="mono-label text-pivot font-medium">ils ont confié leurs projets à FT2E</h2>
    </div>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      {partenaires.map((nom) => (
        <span class="type-h2 text-encre text-base">
          {nom}
        </span>
      ))}
    </div>
  </div>
</section>
