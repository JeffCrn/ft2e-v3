---
import BadgeDemo from '../primitives/BadgeDemo.astro';

const partenaires = [
  'Domidylle',
  'Médiatim',
  'Édouard Denis',
  'Pitch',
  'Réalités',
  'Bouygues',
  'OPH La Rochelle',
  'Habitat 17',
  'Ville de Rochefort',
];
---

<section class="py-14 bg-cool-white">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 border-t border-line pt-5">
    <div class="flex items-center gap-3 mb-4" data-reveal>
      <h2 class="mono-label text-slate font-medium">maîtres d’ouvrage et partenaires cités</h2>
      <BadgeDemo />
    </div>
    <div class="flex flex-wrap gap-x-6 gap-y-2" data-reveal-stagger>
      {partenaires.map((nom) => (
        <span class="type-h2 text-slate text-base">
          {nom}
        </span>
      ))}
    </div>
  </div>
</section>
