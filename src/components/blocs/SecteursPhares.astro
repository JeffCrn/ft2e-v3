---
import { getCollection } from 'astro:content';

// Liste blueprint des six secteurs.
const secteurs = (await getCollection('secteurs'))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .map((s) => ({
    ...s,
    numero: String(s.data.ordre).padStart(2, '0'),
  }));
---

<section class="py-16 md:py-20 bg-papier">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 mb-5">
      <h2 class="type-h2 text-encre text-[22px]">Six secteurs</h2>
      <p class="mono-label font-normal text-pivot">charente-maritime, vendée, deux-sèvres</p>
    </div>
    <ul class="border-t-2 border-encre" role="list">
      {secteurs.map((secteur) => (
        <li class="border-b border-line transition-colors duration-200 ease-[var(--ease-blueprint)] hover:bg-calcaire">
          <a
            href={`/secteurs/${secteur.id}`}
            class="group grid grid-cols-[44px_1fr] md:grid-cols-[44px_200px_1fr] gap-x-6 gap-y-1 py-4 items-baseline"
          >
            <span class="mono-label font-normal text-pivot tabular-nums" aria-hidden="true">{secteur.numero}</span>
            <h3 class="type-h2 text-encre text-[19px] group-hover:text-profond transition-colors duration-200 ease-[var(--ease-blueprint)]">{secteur.data.titre}</h3>
            <p class="col-start-2 md:col-start-3 text-[15px] text-pivot leading-[1.55]">{secteur.data.accroche}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
