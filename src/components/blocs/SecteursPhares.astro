---
import { getCollection } from 'astro:content';

// Section des secteurs — charte v3 (§ 10) : cellules de liste (calcaire,
// bordure 1 px filet-1), numéro mono en tête, intitulé en pied aligné à
// droite, survol calcaire → papier (300 ms).
interface Props {
  /** Numéro de section sur la planche (ex. « 04 ») — optionnel. */
  numero?: string;
}

const { numero } = Astro.props;

const secteurs = (await getCollection('secteurs'))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .map((s) => ({
    ...s,
    numero: String(s.data.ordre).padStart(2, '0'),
  }));
---

<section class="py-12 md:py-[76px]">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="flex items-center gap-3">
      <span class="puce-section" aria-hidden="true"></span>
      <span class="mono-label text-pivot">{numero ? `${numero} — secteurs` : 'secteurs'}</span>
    </div>
    <h2 class="type-section text-[26px] mt-4">
      <span class="text-encre">Sept secteurs d’activité</span>
      <span class="text-clair" aria-hidden="true">/du logement aux missions monotechniques</span>
    </h2>
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8" role="list">
      {secteurs.map((secteur) => (
        <li>
          <a href={`/secteurs/${secteur.id}`} class="cellule-liste h-full">
            <span class="mono-data text-pivot" aria-hidden="true">{secteur.numero}</span>
            <p class="mt-3 text-[15px] text-pivot leading-[1.55]">{secteur.data.accroche}</p>
            <h3 class="type-intitule text-encre text-[17px] self-end text-right mt-auto pt-5">{secteur.data.titre}</h3>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
