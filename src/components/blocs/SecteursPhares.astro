---
import { getCollection } from 'astro:content';

// Liste blueprint des six secteurs, avec compteur de fiches publiées par secteur.
const projets = await getCollection('projets');
const secteurs = (await getCollection('secteurs'))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .map((s) => {
    const nb = projets.filter((p) => p.data.secteur === s.data.titre).length;
    return {
      ...s,
      numero: String(s.data.ordre).padStart(2, '0'),
      fiches: nb === 0 ? '—' : nb === 1 ? '1 fiche' : `${nb} fiches`,
    };
  });
---

<section class="py-16 md:py-20 bg-cool-white">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 mb-5" data-reveal>
      <h2 class="type-h2 text-marine text-[22px]">Six secteurs</h2>
      <p class="mono-label font-normal text-mist">charente-maritime, vendée, deux-sèvres</p>
    </div>
    <ul class="border-t border-line-strong" role="list" data-reveal-stagger>
      {secteurs.map((secteur) => (
        <li class="grid grid-cols-[44px_1fr] md:grid-cols-[44px_200px_1fr_90px] gap-x-6 gap-y-1 py-4 border-b border-line items-baseline transition-colors duration-[400ms] ease-[var(--ease-blueprint)] hover:border-b-copper hover:bg-paper">
          <span class="mono-label font-normal text-copper tabular-nums" aria-hidden="true">{secteur.numero}</span>
          <h3 class="type-h2 text-marine text-[19px]" style="font-stretch: 118%;">{secteur.data.titre}</h3>
          <p class="col-start-2 md:col-start-3 text-[15px] font-light text-slate leading-[1.55]">{secteur.data.accroche}</p>
          <span class="mono-data text-mist md:text-right col-start-2 md:col-start-4">{secteur.fiches}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
