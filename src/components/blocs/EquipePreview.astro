---
import fs from 'node:fs';
import path from 'node:path';
import Bouton from '../primitives/Bouton.astro';
import CoinsCuivre from '../primitives/CoinsCuivre.astro';

// Aperçu de l'équipe — charte v3 : titre de section à puce profonde,
// photo collective duotone 3:2 à équerres. Traitement identique pour
// les sept profils : seule la photo collective transite ici.
interface Props {
  /** Numéro de section sur la planche (ex. « 06 ») — optionnel. */
  numero?: string;
}

const { numero } = Astro.props;

const collectifExiste = fs.existsSync(path.join(process.cwd(), 'public', '/images/equipe/collectif.jpg'));
---

<section class="py-12 md:py-[76px]">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="flex items-center gap-3">
      <span class="puce-section" aria-hidden="true"></span>
      <span class="mono-label text-pivot">{numero ? `${numero} — équipe` : 'équipe'}</span>
    </div>
    <h2 class="type-section text-[26px] mt-4">
      <span class="text-encre">Sept profils</span>
      <span class="text-clair" aria-hidden="true">/une responsabilité partagée</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mt-8">
      <div class:list={['relative w-full aspect-[3/2]', collectifExiste ? 'duotone-photo' : 'duotone-media']}>
        {collectifExiste && (
          <img
            src="/images/equipe/collectif.jpg"
            alt="L’équipe FT2E réunie dans ses locaux à La Rochelle"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        )}
        <CoinsCuivre />
        <span class="cartouche-legende legende-media z-10" aria-hidden="true">l’équipe ft2e, la rochelle</span>
      </div>
      <div>
        <p class="text-[15px] text-pivot leading-[1.55]">
          Une équipe de sept personnes, ancrée à La Rochelle depuis 2008. Chacun pilote ses projets de bout en bout, de l’étude au suivi de chantier.
        </p>
        <p class="mt-3 text-[15px] text-pivot leading-[1.55]">
          Une organisation à taille humaine où la responsabilité est partagée et l’expertise mutualisée&nbsp;: fluides, thermique, électricité, SSI, BIM.
        </p>
        <div class="mt-6">
          <Bouton href="/equipe" variante="primary">
            Découvrir l’équipe
          </Bouton>
        </div>
      </div>
    </div>
  </div>
</section>
