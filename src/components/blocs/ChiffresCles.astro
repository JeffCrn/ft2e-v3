---
import Chiffre from '../primitives/Chiffre.astro';
import { CHIFFRES_CLES } from '../../lib/constants';

// Relevé clair — charte v3 (§ 11) : bord haut au filet de rang 1, colonnes
// séparées par des filets de rang 2 ; dans chaque colonne, le commentaire
// précède le chiffre. Un seul chiffre plein (encre) par relevé — celui que
// la page défend (les 17 ans d'expertise) — les autres en retrait.
const commentaires = [
  'Le bureau est créé en 2008 à La Rochelle.',
  'Une direction portée collectivement.',
  'Chiffre arrêté à la plaquette 2024.',
  'Chiffre arrêté à la plaquette 2024.',
];
---

<section class="bg-papier py-16 md:py-20">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <p class="mono-label text-pivot mb-4">relevé — plaquette 2024</p>
    <div class="border-t border-filet-1">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-filet-2">
        {CHIFFRES_CLES.map((chiffre, i) => (
          <Chiffre
            valeur={chiffre.valeur}
            prefixe={'prefixe' in chiffre ? chiffre.prefixe : ''}
            suffixe={chiffre.suffixe}
            label={chiffre.label}
            commentaire={commentaires[i] ?? ''}
            plein={i === 0}
            demo={chiffre.demo}
          />
        ))}
      </div>
    </div>
    <p class="mono-data text-pivot mt-4">
      Domaines — Fluides · Thermique · Électricité · Sécurité incendie · BIM · RE2020 · STD
    </p>
  </div>
</section>
