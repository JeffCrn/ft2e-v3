---
import Bouton from '../primitives/Bouton.astro';

interface Props {
  titre: string;
  sousTitre?: string;
  eyebrow?: string;
  ctaPrincipal?: { label: string; href: string };
  ctaSecondaire?: { label: string; href: string };
  variante?: 'accueil' | 'page';
}

const {
  titre,
  sousTitre,
  eyebrow,
  ctaPrincipal,
  ctaSecondaire,
  variante = 'page',
} = Astro.props;

const isAccueil = variante === 'accueil';
// Le titre accepte des sauts de ligne explicites (\n) ; le stagger reste continu sur tous les mots.
let indexMot = 0;
const lignesMots = titre.split('\\n').map((ligne) =>
  ligne.split(' ').map((mot) => ({ mot, delai: indexMot++ * 40 })),
);
---

<section
  class:list={[
    'relative overflow-hidden',
    isAccueil ? 'bg-encre text-cool-white py-20 md:py-28' : 'bg-paper py-16 md:py-20',
  ]}
  data-hero-dark={isAccueil ? '' : undefined}
>
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    {eyebrow && (
      <p class="mono-label text-copper mb-7" data-reveal>
        {eyebrow}
      </p>
    )}

    <h1
      class:list={[
        'type-display',
        isAccueil ? 'text-cool-white max-w-[22ch]' : 'text-marine max-w-[28ch]',
      ]}
      style={isAccueil
        ? 'font-size: clamp(2.25rem, 5vw, 3.75rem);'
        : 'font-size: clamp(1.875rem, 3.5vw, 3rem);'}
      data-hero-title={isAccueil ? '' : undefined}
    >
      {isAccueil
        ? lignesMots.map((motsLigne, li) => (
            <Fragment>
              {motsLigne.map(({ mot, delai }, i) => (
                <Fragment>
                  <span data-hero-word style={`transition-delay: ${delai}ms`}>{mot}</span>{i < motsLigne.length - 1 ? ' ' : ''}
                </Fragment>
              ))}
              {li < lignesMots.length - 1 ? <br /> : ''}
            </Fragment>
          ))
        : titre.split('\\n').map((ligne, i, arr) => (
            <Fragment>{ligne}{i < arr.length - 1 ? <br /> : ''}</Fragment>
          ))}
    </h1>

    {sousTitre && (
      <p
        class:list={[
          'mt-7 text-[17px] font-light leading-[1.6] max-w-[52ch]',
          isAccueil ? 'text-mist' : 'text-slate',
        ]}
        data-hero-subtitle={isAccueil ? '' : undefined}
      >
        {sousTitre}
      </p>
    )}

    {(ctaPrincipal || ctaSecondaire) && (
      <div
        class="mt-9 flex flex-wrap gap-4"
        data-hero-cta={isAccueil ? '' : undefined}
      >
        {ctaPrincipal && (
          <Bouton href={ctaPrincipal.href} variante={isAccueil ? 'secondary' : 'primary'}>
            {ctaPrincipal.label}&nbsp;→
          </Bouton>
        )}
        {ctaSecondaire && (
          <Bouton href={ctaSecondaire.href} variante="ghost" class={isAccueil ? 'text-cool-white' : undefined}>
            {ctaSecondaire.label}
          </Bouton>
        )}
      </div>
    )}
  </div>
</section>
