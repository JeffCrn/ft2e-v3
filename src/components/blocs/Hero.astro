---
import Bouton from '../primitives/Bouton.astro';

interface Props {
  titre: string;
  sousTitre?: string;
  ctaPrincipal?: { label: string; href: string };
  ctaSecondaire?: { label: string; href: string };
  variante?: 'accueil' | 'page';
}

const {
  titre,
  sousTitre,
  ctaPrincipal,
  ctaSecondaire,
  variante = 'page',
} = Astro.props;

const isAccueil = variante === 'accueil';
// Le titre accepte des sauts de ligne explicites (\n) ; le stagger reste continu sur tous les mots.
let indexMot = 0;
const lignesMots = titre.split('\\n').map((ligne) =>
  ligne.split(' ').map((mot) => ({ mot, delai: indexMot++ * 40 })),
);
---

<section
  class:list={[
    'relative overflow-hidden',
    isAccueil ? 'bg-marine-deep text-white py-24 md:py-32 lg:py-40' : 'bg-light-gray py-16 md:py-20',
  ]}
  data-hero-dark={isAccueil ? '' : undefined}
>
  <div class="max-w-[980px] mx-auto px-4 md:px-6 text-center">
    <h1
      class:list={[
        'font-heading font-semibold tracking-tight mx-auto',
        isAccueil ? 'text-white max-w-5xl' : 'text-marine max-w-3xl',
      ]}
      style={isAccueil
        ? 'font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1.07; letter-spacing: -0.015em;'
        : 'font-size: clamp(2rem, 3.5vw, 2.5rem); line-height: 1.10; letter-spacing: -0.01em;'}
      data-hero-title={isAccueil ? '' : undefined}
    >
      {isAccueil
        ? lignesMots.map((motsLigne, li) => (
            <Fragment>
              {motsLigne.map(({ mot, delai }, i) => (
                <Fragment>
                  <span data-hero-word style={`transition-delay: ${delai}ms`}>{mot}</span>{i < motsLigne.length - 1 ? ' ' : ''}
                </Fragment>
              ))}
              {li < lignesMots.length - 1 ? <br /> : ''}
            </Fragment>
          ))
        : titre.split('\\n').map((ligne, i, arr) => (
            <Fragment>{ligne}{i < arr.length - 1 ? <br /> : ''}</Fragment>
          ))}
    </h1>

    {sousTitre && (
      <p
        class:list={[
          'mt-4 text-[21px] font-light leading-relaxed max-w-2xl mx-auto tracking-tight',
          isAccueil ? 'text-mist' : 'text-text-secondary',
        ]}
        data-hero-subtitle={isAccueil ? '' : undefined}
      >
        {sousTitre}
      </p>
    )}

    {(ctaPrincipal || ctaSecondaire) && (
      <div
        class="mt-8 flex flex-wrap justify-center gap-4"
        data-hero-cta={isAccueil ? '' : undefined}
      >
        {ctaPrincipal && (
          <Bouton href={ctaPrincipal.href} variante="primary">
            {ctaPrincipal.label}
          </Bouton>
        )}
        {ctaSecondaire && (
          <Bouton href={ctaSecondaire.href} variante={isAccueil ? 'ghost' : 'secondary'}>
            {ctaSecondaire.label}
          </Bouton>
        )}
      </div>
    )}
  </div>
</section>
