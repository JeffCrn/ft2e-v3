---
// Hero de couverture — charte v3 « plans et profondeur » (accueil) :
// la vedette (type-display, capitales, une seule par page) s'ouvre en très
// grand, posée sur la trame de la planche ; le sous-titre, les CTA et le
// média d'appui se rangent en dessous. Le rang n'est plus porté par
// l'épaisseur d'un filet : plus de barre de rang.
interface Props {
  titre: string;
  /** Second rang de la vedette (accueil) : capitales réduites sous le h1,
      dessin .type-intitule — jamais rendu en variante page. */
  sousVedette?: string;
  sousTitre?: string;
  eyebrow?: string;
  ctaPrincipal?: { label: string; href: string };
  ctaSecondaire?: { label: string; href: string };
  variante?: 'accueil' | 'page';
}

const {
  titre,
  sousVedette,
  sousTitre,
  eyebrow,
  ctaPrincipal,
  ctaSecondaire,
  variante = 'page',
} = Astro.props;

const isAccueil = variante === 'accueil';
// Média technique annoté (slot "media") : rangé sous la vedette, dans la
// colonne de droite — il ne porte jamais le titre.
const hasMedia = isAccueil && Astro.slots.has('media');
const hasStats = Astro.slots.has('stats');
const hasAppui = Boolean(sousTitre || ctaPrincipal || ctaSecondaire || hasMedia || hasStats);
const lignes = titre.split('\\n');

// Vedette de couverture (accueil) ou titre d'écran (variante page, aligné
// sur HeroPage) — l'interligne vient des recettes .type-display / .type-ecran.
const titreClasses = isAccueil ? 'type-display text-profond' : 'type-ecran text-encre';
// ⚠ Borne basse de la vedette : 2,4 rem et non les 3 rem de la charte.
// Mesuré à 390 px le 2026-08-16 : à 3 rem (48 px) et chasse 125, « L’ingénierie »
// fait 389 px dans une boîte de 358 — trois mots sur sept dépassent, la page
// défile latéralement (scrollWidth 405 pour clientWidth 390). La borne de la
// charte n’avait jamais été validée à cette largeur avec cette chasse ; la
// charte tranche elle-même ce cas — « la mesure prévaut sur la règle ».
// À 2,4 rem (38,4 px) le mot tombe à 311 px : il tient à 390 px (boîte 358) et
// à 360 px (boîte 328), les deux largeurs de téléphone qui comptent. Au-delà
// de 512 px de fenêtre, la pente en vw reprend la main et rien ne change.
// ⚠ Borne haute de la vedette : 4,5 rem et non les 6,5 rem de la charte
// (directive FT2E du 2026-08-26, seconde composition du jour — remplace la
// vedette en quatre segments « Des études / techniques / portées jusqu'à /
// l'exécution », bornée elle à 5,1 rem). La vedette « Ingénierie / fluides
// et thermique / du bâtiment » compose en TROIS lignes explicites, et sa
// ligne la plus large — « FLUIDES ET THERMIQUE », 1 093 px à 72 px de
// corps — tient dans les 1 152 px de boîte avec 59 px de marge ; à 5,1 rem
// elle ferait ~1 238 px. Toutes les cotes sont MESURÉES au navigateur,
// jamais estimées (deux estimations ont cassé des lignes le 2026-08-26).
// Sous ~1 141 px de fenêtre la boîte passe sous les 1 093 px de la ligne
// médiane, qui se replie (« fluides et / thermique ») : l'empilement des
// mots, déjà arbitré pour les téléphones, vaut aussi pour 768 et 1 024 —
// contrôlé en capture, quatre lignes propres, aucun débordement (360, 390,
// 768 mesurés à la sonde iframe : scrollWidth = clientWidth partout).
// Borne basse 2,4 rem inchangée : le mot le plus large, « INGÉNIERIE »,
// fait 280 px à 38,4 px pour une boîte de 328 px à 360 px de fenêtre.
const tailleTitre = isAccueil
  ? 'font-size: clamp(2.4rem, 7.5vw, 4.5rem);'
  : 'font-size: clamp(2.25rem, 5vw, 3.875rem);';
// Second rang de la vedette : dessin .type-intitule (capitales, 600,
// wdth 112) en encre — le profond reste au seul titre, la hiérarchie passe
// par le corps, la graisse et la valeur. Mesuré le 2026-08-26 : une seule
// ligne de 538 px à 28 px de corps (1 440 de fenêtre, ratio 0,39× la
// vedette) ; sur téléphone la ligne se replie naturellement en deux
// (208 px au plus large à 18 px, aucun débordement). Pas de max-width :
// 24ch la repliait en trois à 28 px de corps.
const tailleSousVedette = 'font-size: clamp(1.125rem, 2.2vw, 1.75rem);';
---

<section class="py-16 md:py-20">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    {eyebrow && (
      <p class="mono-label text-pivot mb-6">
        {eyebrow}
      </p>
    )}

    {/* Pas de text-balance sur la vedette d'accueil : ses césures sont
        EXPLICITES (segments \n du titre), et l'équilibrage cassait « études
        techniques » en deux lignes pour égaliser — c'est lui qui empêchait la
        composition en trois lignes arbitrée le 2026-08-26. Le titre d'écran
        (variante page), sans césures forcées, le garde. */}
    <h1
      class:list={[titreClasses, 'max-w-[24ch]', !isAccueil && 'text-balance']}
      style={tailleTitre}
    >
      {lignes.map((ligne, i) => (
        <Fragment>{ligne}{i < lignes.length - 1 ? <br /> : ''}</Fragment>
      ))}
    </h1>

    {isAccueil && sousVedette && (
      <p class="type-intitule text-encre mt-5" style={tailleSousVedette}>
        {sousVedette}
      </p>
    )}

    {hasAppui && (
      <div class:list={['mt-8 md:mt-10', hasMedia && 'grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start']}>
        {/* Partage 5/7 depuis le 2026-08-26 (le média est un cliché, plus un
            plan) : l'accroche est bornée à 46ch et tient dans 5 colonnes sans
            réflow, l'image gagne la largeur — ~660 px à pleine planche. */}
        <div class:list={[hasMedia && 'lg:col-span-5']}>
          {sousTitre && (
            <p class="text-base leading-[1.6] text-pivot max-w-[46ch] text-pretty">
              {sousTitre}
            </p>
          )}

          {(ctaPrincipal || ctaSecondaire) && (
            <div class="mt-9 flex flex-wrap gap-4">
              {ctaPrincipal && (
                <a href={ctaPrincipal.href} class="btn-principal">
                  {ctaPrincipal.label}
                  <span aria-hidden="true">→</span>
                </a>
              )}
              {ctaSecondaire && (
                <a href={ctaSecondaire.href} class="btn-filaire">
                  {ctaSecondaire.label}
                </a>
              )}
            </div>
          )}

          {hasStats && (
            <div class="mt-9 pt-6 border-t border-filet-1">
              <slot name="stats" />
            </div>
          )}
        </div>

        {/* Le média s'affiche à TOUTES les largeurs depuis le 2026-08-26 :
            le masquage sous `sm` protégeait le mono de l'appui SVG (6,2 px
            à 390), et l'appui a été remplacé par une photographie, qui n'a
            pas de plancher de lisibilité. Si un dessin revient un jour dans
            ce slot, le masquage se remet sur cette ENVELOPPE, jamais sur le
            contenu du slot — porté par les enfants, il laissait une cellule
            de grille de hauteur 0 dont le `row-gap` se payait quand même
            (40 px de vide mort mesurés à 390 px le 2026-08-16). */}
        {hasMedia && (
          <div class="lg:col-span-7">
            <slot name="media" />
          </div>
        )}
      </div>
    )}
  </div>
</section>
