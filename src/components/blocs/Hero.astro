---
// Hero de couverture — charte v3 « plans et profondeur » (accueil) :
// la vedette (type-display, capitales, une seule par page) s'ouvre en très
// grand, posée sur la trame de la planche ; le sous-titre, les CTA et le
// média d'appui se rangent en dessous. Le rang n'est plus porté par
// l'épaisseur d'un filet : plus de barre de rang.
interface Props {
  titre: string;
  sousTitre?: string;
  eyebrow?: string;
  ctaPrincipal?: { label: string; href: string };
  ctaSecondaire?: { label: string; href: string };
  variante?: 'accueil' | 'page';
}

const {
  titre,
  sousTitre,
  eyebrow,
  ctaPrincipal,
  ctaSecondaire,
  variante = 'page',
} = Astro.props;

const isAccueil = variante === 'accueil';
// Média technique annoté (slot "media") : rangé sous la vedette, dans la
// colonne de droite — il ne porte jamais le titre.
const hasMedia = isAccueil && Astro.slots.has('media');
const hasStats = Astro.slots.has('stats');
const hasAppui = Boolean(sousTitre || ctaPrincipal || ctaSecondaire || hasMedia || hasStats);
const lignes = titre.split('\\n');

// Vedette de couverture (accueil) ou titre d'écran (variante page, aligné
// sur HeroPage) — l'interligne vient des recettes .type-display / .type-ecran.
const titreClasses = isAccueil ? 'type-display text-profond' : 'type-ecran text-encre';
// ⚠ Borne basse de la vedette : 2,4 rem et non les 3 rem de la charte.
// Mesuré à 390 px le 2026-08-16 : à 3 rem (48 px) et chasse 125, « L’ingénierie »
// fait 389 px dans une boîte de 358 — trois mots sur sept dépassent, la page
// défile latéralement (scrollWidth 405 pour clientWidth 390). La borne de la
// charte n’avait jamais été validée à cette largeur avec cette chasse ; la
// charte tranche elle-même ce cas — « la mesure prévaut sur la règle ».
// À 2,4 rem (38,4 px) le mot tombe à 311 px : il tient à 390 px (boîte 358) et
// à 360 px (boîte 328), les deux largeurs de téléphone qui comptent. Au-delà
// de 512 px de fenêtre, la pente en vw reprend la main et rien ne change.
const tailleTitre = isAccueil
  ? 'font-size: clamp(2.4rem, 7.5vw, 6.5rem);'
  : 'font-size: clamp(2.25rem, 5vw, 3.875rem);';
---

<section class="py-16 md:py-20">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    {eyebrow && (
      <p class="mono-label text-pivot mb-6">
        {eyebrow}
      </p>
    )}

    <h1
      class:list={[titreClasses, 'max-w-[24ch] text-balance']}
      style={tailleTitre}
    >
      {lignes.map((ligne, i) => (
        <Fragment>{ligne}{i < lignes.length - 1 ? <br /> : ''}</Fragment>
      ))}
    </h1>

    {hasAppui && (
      <div class:list={['mt-8 md:mt-10', hasMedia && 'grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start']}>
        <div class:list={[hasMedia && 'lg:col-span-6']}>
          {sousTitre && (
            <p class="text-base leading-[1.6] text-pivot max-w-[46ch] text-pretty">
              {sousTitre}
            </p>
          )}

          {(ctaPrincipal || ctaSecondaire) && (
            <div class="mt-9 flex flex-wrap gap-4">
              {ctaPrincipal && (
                <a href={ctaPrincipal.href} class="btn-principal">
                  {ctaPrincipal.label}
                  <span aria-hidden="true">→</span>
                </a>
              )}
              {ctaSecondaire && (
                <a href={ctaSecondaire.href} class="btn-filaire">
                  {ctaSecondaire.label}
                </a>
              )}
            </div>
          )}

          {hasStats && (
            <div class="mt-9 pt-6 border-t border-filet-1">
              <slot name="stats" />
            </div>
          )}
        </div>

        {hasMedia && (
          <div class="lg:col-span-6">
            <slot name="media" />
          </div>
        )}
      </div>
    )}
  </div>
</section>
