---
import Bouton from '../primitives/Bouton.astro';

// Hero clair — charte v2, planche 08 (écran 1) : le papier gouverne,
// l'image recule dans sa colonne, elle ne porte pas le titre.
// Vedette au profond, barre de rang 4 px à l'encre, corps au pivot.
interface Props {
  titre: string;
  sousTitre?: string;
  eyebrow?: string;
  ctaPrincipal?: { label: string; href: string };
  ctaSecondaire?: { label: string; href: string };
  variante?: 'accueil' | 'page';
}

const {
  titre,
  sousTitre,
  eyebrow,
  ctaPrincipal,
  ctaSecondaire,
  variante = 'page',
} = Astro.props;

const isAccueil = variante === 'accueil';
// Média technique annoté (slot "media") : hero accueil en deux colonnes.
const hasMedia = isAccueil && Astro.slots.has('media');
const lignes = titre.split('\\n');

const tailleTitre = isAccueil
  ? hasMedia
    ? 'font-size: clamp(2.1rem, 3.6vw, 3.25rem);'
    : 'font-size: clamp(2.25rem, 5vw, 3.75rem);'
  : 'font-size: clamp(1.875rem, 3.5vw, 3rem);';
---

<section class="bg-papier py-16 md:py-20">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class:list={[hasMedia && 'grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center']}>
    <div class:list={[hasMedia && 'lg:col-span-6']}>
    {eyebrow && (
      <p class="mono-label text-pivot mb-6">
        {eyebrow}
      </p>
    )}

    <h1
      class:list={['type-display text-profond', hasMedia ? 'max-w-[22ch]' : 'max-w-[24ch]']}
      style={tailleTitre}
    >
      {lignes.map((ligne, i) => (
        <Fragment>{ligne}{i < lignes.length - 1 ? <br /> : ''}</Fragment>
      ))}
    </h1>

    <div class="w-[110px] h-1 bg-encre mt-7" aria-hidden="true"></div>

    {sousTitre && (
      <p class="mt-6 text-base leading-[1.6] text-pivot max-w-[46ch] text-pretty">
        {sousTitre}
      </p>
    )}

    {(ctaPrincipal || ctaSecondaire) && (
      <div class="mt-9 flex flex-wrap gap-4">
        {ctaPrincipal && (
          <Bouton href={ctaPrincipal.href} variante="primary">
            {ctaPrincipal.label}&nbsp;→
          </Bouton>
        )}
        {ctaSecondaire && (
          <Bouton href={ctaSecondaire.href} variante="ghost">
            {ctaSecondaire.label}
          </Bouton>
        )}
      </div>
    )}

    {Astro.slots.has('stats') && (
      <div class="mt-9 pt-6 border-t border-line">
        <slot name="stats" />
      </div>
    )}
    </div>
    {hasMedia && (
      <div class="lg:col-span-6">
        <slot name="media" />
      </div>
    )}
    </div>
  </div>
</section>
