---
import CoinsCuivre from '../primitives/CoinsCuivre.astro';

const isLiminaire = import.meta.env.PUBLIC_MODE === 'liminaire';

// Champs — charte v3 révision 2.1 (§ 11, amendement A5). Les états ne
// passent par aucune couleur : repos filet 16 %, actif 22 %, erreur 2 px
// à 100 % + marque ▲ + mot « Erreur — », désactivé 12 %. Le succès quitte
// le champ pour un bandeau séparé. La recette vit dans global.css (.champ).
// Le bouton d'envoi du mode liminaire porte l'état désactivé de A5 : filet
// à 12 %, texte pivot, fond calcaire, curseur interdit — sans couleur.
const inputClasses = 'champ';
const labelClasses = 'mono-label block text-pivot mb-1.5';
---

<section class="py-16 md:py-20 bg-papier">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      <div>
        <div class="flex items-center gap-3">
          <span class="puce-section" aria-hidden="true"></span>
          <span class="mono-label text-pivot">votre demande</span>
        </div>
        <h2 class="type-section text-encre text-[22px] md:text-[26px] mt-4 mb-6">
          Parlons de votre projet
        </h2>

        {/* Bandeau de succès (§ 11, A5) : le succès se signale par un
            DÉPLACEMENT — il quitte le champ pour un bandeau séparé. */}
        <div id="succes-contact" class="bandeau-succes mb-6 hidden" role="status">
          Message reçu — réponse sous 48&nbsp;h ouvrées.
        </div>

        <form id="form-contact" class="space-y-6" novalidate>
          {/* Honeypot anti-spam : champ invisible, hors tabulation, à laisser vide */}
          <div class="hidden" aria-hidden="true">
            <label for="site-web">Ne pas remplir ce champ</label>
            <input
              type="text"
              id="site-web"
              name="site-web"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <fieldset>
            <legend class="mono-label text-pivot mb-3">vous êtes</legend>
            <div class="grid grid-cols-2 sm:grid-cols-4 -mr-px">
              {["Architecte", "Maître d’ouvrage", "Candidat", "Autre"].map((role) => (
                <label class="chip-blueprint justify-center cursor-pointer -ml-px -mt-px hover:border-encre hover:text-encre has-[:checked]:border-encre has-[:checked]:bg-calcaire has-[:checked]:text-encre has-[:checked]:z-10 relative">
                  <input type="radio" name="role" value={role} class="accent-encre mr-2" />
                  <span>{role}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="space-y-4">
            <div>
              <label for="nom" class={labelClasses}>
                Nom et prénom <span class="text-pivot" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="nom"
                name="nom"
                aria-describedby="erreur-nom"
                required
                aria-required="true"
                class={inputClasses}
              />
              <p id="erreur-nom" class="message-erreur hidden"></p>
            </div>

            <div>
              <label for="email" class={labelClasses}>
                Email <span class="text-pivot" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                aria-describedby="erreur-email"
                required
                aria-required="true"
                class={inputClasses}
              />
              <p id="erreur-email" class="message-erreur hidden"></p>
            </div>

            <div>
              <label for="telephone" class={labelClasses}>
                Téléphone <span class="normal-case tracking-normal">(facultatif)</span>
              </label>
              <input
                type="tel"
                id="telephone"
                name="telephone"
                class={inputClasses}
              />
            </div>

            <div>
              <label for="message" class={labelClasses}>
                Message <span class="text-pivot" aria-hidden="true">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                aria-describedby="erreur-message"
                rows={5}
                required
                aria-required="true"
                class:list={[inputClasses, 'resize-y']}
              ></textarea>
              <p id="erreur-message" class="message-erreur hidden"></p>
            </div>

            <div>
              <label class="flex items-start gap-3 cursor-pointer">
                <input
                  type="checkbox"
                  name="rgpd"
                  required
                  aria-required="true"
                  class="mt-1 accent-encre"
                />
                <span class="text-[15px] text-pivot leading-[1.55]">
                  J’accepte que mes données soient traitées par FT2E dans le cadre de ma demande, conformément à la <a href="/politique-confidentialite" class="lien-texte">politique de confidentialité</a>.
                </span>
              </label>
            </div>
          </div>

          {isLiminaire ? (
            <button
              type="button"
              disabled
              class="btn-filaire border-filet-3 bg-calcaire text-pivot cursor-not-allowed hover:border-filet-3 hover:text-pivot"
            >
              Envoyer (désactivé en version liminaire)
            </button>
          ) : (
            <button
              type="submit"
              class="btn-principal cursor-pointer"
            >
              Envoyer le message&nbsp;→
            </button>
          )}
        </form>
      </div>

      <div class="space-y-8">
        {/* Cartouche coordonnées — charte v3 (§ 10) : plan posé (bordure 1 px,
            ombre de rang 1), en-tête calcaire, filets internes de rang 2. */}
        <div class="plan-pose">
          <p class="mono-label text-pivot px-5 py-3 bg-calcaire border-b border-filet-2">coordonnées</p>
          <address class="not-italic mono-data text-encre leading-[1.7] px-5 py-4">
            <p>35 Rue Nicolas Denys de Fronsac<br />17000 La Rochelle</p>
            <p class="mt-3">
              <a href="tel:+33546278593" class="hover:text-pivot transition-colors duration-[260ms] ease-[var(--ease-blueprint)]">05&nbsp;46&nbsp;27&nbsp;85&nbsp;93</a><br />
              <a href="mailto:ft2e@ft2e.fr" class="hover:text-pivot transition-colors duration-[260ms] ease-[var(--ease-blueprint)]">ft2e@ft2e.fr</a>
            </p>
          </address>
          <div class="px-5 py-4 bg-calcaire border-t border-filet-2">
            <p class="mono-label text-pivot mb-1.5">disponibilité</p>
            <p class="mono-data text-encre">lun. – ven., 8&nbsp;h&nbsp;30&nbsp;–&nbsp;18&nbsp;h</p>
            <p class="mono-label text-pivot mt-2">réponse sous 48&nbsp;h ouvrées</p>
          </div>
        </div>

        <div>
          <div class="duotone-photo relative w-full h-64 border border-filet-2">
            <iframe
              title="Carte de localisation de FT2E — 35 Rue Nicolas Denys de Fronsac, 17000 La Rochelle"
              src="https://www.openstreetmap.org/export/embed.html?bbox=-1.2149345%2C46.1594398%2C-1.2029345%2C46.1654398&amp;layer=mapnik&amp;marker=46.1624398%2C-1.2089345"
              class="w-full h-full"
              loading="lazy"
            ></iframe>
            <CoinsCuivre />
            <span class="cartouche-legende legende-media z-10" aria-hidden="true">la rochelle — 35 rue nicolas denys de fronsac</span>
          </div>
          <p class="mt-3 mono-data text-pivot">
            <a
              href="https://www.openstreetmap.org/?mlat=46.1624398&amp;mlon=-1.2089345#map=17/46.1624398/-1.2089345"
              target="_blank"
              rel="noopener noreferrer"
              class="lien-texte"
            >Ouvrir dans OpenStreetMap (nouvel onglet)</a>
            <span aria-hidden="true"> · </span>© OpenStreetMap
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // États de formulaire — charte v3 révision 2.1, § 11 (amendement A5).
  // Aucun état ne passe par la couleur : l'erreur se dit par l'épaisseur du
  // filet (via aria-invalid → .champ[aria-invalid]), la marque ▲ et le mot ;
  // le succès se dit par un déplacement (bandeau séparé du champ).
  function initFormulaireContact() {
    const form = document.querySelector<HTMLFormElement>('#form-contact');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';

    const succes = document.querySelector<HTMLElement>('#succes-contact');
    const requis = ['nom', 'email', 'message'] as const;

    const messagePour = (champ: HTMLInputElement | HTMLTextAreaElement) => {
      if (champ.validity.valueMissing) return 'Erreur — ce champ est requis.';
      if (champ.validity.typeMismatch) return 'Erreur — adresse électronique incomplète.';
      return 'Erreur — saisie invalide.';
    };

    const afficher = (champ: HTMLInputElement | HTMLTextAreaElement, enErreur: boolean) => {
      const zone = document.querySelector<HTMLElement>(`#erreur-${champ.id}`);
      champ.setAttribute('aria-invalid', String(enErreur));
      if (!zone) return;
      zone.textContent = enErreur ? messagePour(champ) : '';
      zone.classList.toggle('hidden', !enErreur);
      // role="alert" n'est posé qu'à l'apparition : un role permanent ferait
      // annoncer la zone vide à chaque passage du lecteur d'écran.
      if (enErreur) zone.setAttribute('role', 'alert');
      else zone.removeAttribute('role');
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let premierFautif: HTMLElement | null = null;

      for (const id of requis) {
        const champ = form.querySelector<HTMLInputElement>(`#${id}`);
        if (!champ) continue;
        const enErreur = !champ.checkValidity();
        afficher(champ, enErreur);
        if (enErreur && !premierFautif) premierFautif = champ;

        // Une fois signalé, le champ se corrige en direct : l'erreur
        // disparaît dès que la saisie devient valide.
        if (!champ.dataset.liveBound) {
          champ.dataset.liveBound = '1';
          champ.addEventListener('input', () => {
            if (champ.getAttribute('aria-invalid') === 'true' && champ.checkValidity()) {
              afficher(champ, false);
            }
          });
        }
      }

      if (premierFautif) {
        premierFautif.focus();
        succes?.classList.add('hidden');
        return;
      }

      // Pas de backend à ce stade (site en démo) : le succès se matérialise
      // par le bandeau, conformément à A5. Le branchement d'envoi viendra ici.
      succes?.classList.remove('hidden');
      form.reset();
      succes?.focus?.();
    });
  }

  document.addEventListener('astro:page-load', initFormulaireContact);
</script>
