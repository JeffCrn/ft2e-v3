---
import { getCollection } from 'astro:content';
import CarteProjet from './CarteProjet.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projetActuel: CollectionEntry<'projets'>;
  max?: number;
}

const { projetActuel, max = 3 } = Astro.props;

const tous = await getCollection('projets');
const similaires = tous
  .filter((p) => p.id !== projetActuel.id)
  .sort((a, b) => {
    let scoreA = 0;
    let scoreB = 0;
    if (a.data.secteur === projetActuel.data.secteur) scoreA += 2;
    if (b.data.secteur === projetActuel.data.secteur) scoreB += 2;
    if (a.data.typologie === projetActuel.data.typologie) scoreA += 1;
    if (b.data.typologie === projetActuel.data.typologie) scoreB += 1;
    return scoreB - scoreA;
  })
  .slice(0, max);
---

{similaires.length > 0 && (
  <section class="py-16 md:py-20 bg-cool-white">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 mb-5">
        <h2 class="type-h2 text-marine text-[22px]">Projets similaires</h2>
        <p class="mono-label font-normal text-mist">même secteur, même typologie</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {similaires.map((projet) => (
          <CarteProjet projet={projet} />
        ))}
      </div>
    </div>
  </section>
)}
