---
import { getCollection } from 'astro:content';
import CarteProjet from './CarteProjet.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projetActuel: CollectionEntry<'projets'>;
  max?: number;
}

// Quatre projets, pas trois : la grille ci-dessous est celle de `/secteurs` et
// `/expertises` — deux colonnes puis quatre —, et trois cartes y laisseraient
// une orpheline sur la dernière ligne.
const { projetActuel, max = 4 } = Astro.props;

const tous = await getCollection('projets');
const similaires = tous
  .filter((p) => p.id !== projetActuel.id)
  .sort((a, b) => {
    let scoreA = 0;
    let scoreB = 0;
    if (a.data.secteur === projetActuel.data.secteur) scoreA += 2;
    if (b.data.secteur === projetActuel.data.secteur) scoreB += 2;
    if (a.data.typologie === projetActuel.data.typologie) scoreA += 1;
    if (b.data.typologie === projetActuel.data.typologie) scoreB += 1;
    return scoreB - scoreA;
  })
  .slice(0, max);
---

{similaires.length > 0 && (
  <section class="py-12 md:py-[76px]">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="flex items-center gap-3">
        <span class="puce-section" aria-hidden="true"></span>
        <span class="mono-label text-pivot">projets similaires</span>
      </div>
      <h2 class="type-section text-[26px] mt-4">
        <span class="text-encre">Projets similaires</span>
        <span class="text-clair" aria-hidden="true">/même secteur, même typologie</span>
      </h2>
      {/* Grille alignée sur `/secteurs` et `/expertises` le 2026-08-15 : deux
          colonnes puis quatre, gouttière de 16. Elle était en TROIS colonnes à
          `gap-6`, ce qui servait la vignette à 366 px pour une taille de
          conception de 300 — une sur-échelle de 1,22, qui épaissit de 22 % tous
          les filets de 1 px du dessin. C'était la seule grille du site dans ce
          cas au-dessus de 1024 px, et elle se voyait : la même vignette y
          paraissait plus généreuse qu'ailleurs, sans que rien ne le justifie.
          Pas de palier `md:grid-cols-3` ici, contrairement à `/references` :
          avec quatre cartes il laisserait une orpheline — l'index, lui, en a
          vingt-trois. */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8" data-plan-groupe>
        {similaires.map((projet) => (
          <CarteProjet projet={projet} />
        ))}
      </div>
    </div>
  </section>
)}
