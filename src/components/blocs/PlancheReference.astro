---
import fs from 'node:fs';
import path from 'node:path';

/**
 * Planche de schéma de principe — le dispositif visuel des fiches de référence.
 *
 * Une planche est un dessin FT2E composé à partir de la matière technique de la
 * fiche : aucune géométrie d'ouvrage, aucun nom de tiers, aucune donnée
 * commerciale. Elle remplace le visuel photographique, qui exposait le bureau au
 * droit d'auteur des architectes et ne démontrait rien à la taille où il était vu.
 *
 * Trois principes de rendu, chacun mesuré plutôt que supposé :
 *
 * 1. **Le SVG est INLINÉ, jamais appelé en `<img src>`.** Un SVG appelé en `src`
 *    est un document isolé : il ne reçoit ni les polices de la page ni ses
 *    variables CSS. Inliné, il hérite d'« Archivo Variable » et des jetons.
 *
 * 2. **La planche occupe la largeur du conteneur, sans padding de plan.** Elle est
 *    composée dans un repère de 1200 et porte ses propres marges de 56 : elle EST
 *    le plan posé, on ne la pose pas dans un autre. À 1152 px l'échelle vaut 0,96,
 *    et le mono de 10 px du dessin se rend à 9,6 px. Dans la colonne de 581 px où
 *    logeait l'ancien visuel, il tomberait à 3,9 px.
 *
 * 3. **Le dessin est présent à toutes les largeurs — trois compositions, trois
 *    bandes.** Jusqu'au 2026-08-15 le dessin disparaissait sous `lg` et cédait la
 *    place à sa seule lecture : à 390 px, 881 px de libellés alignés là où la page
 *    devait poser une image. L'arbitrage était juste tant qu'il n'y avait qu'un
 *    dessin à montrer ; les trois fichiers d'un dossier de planche ne sont pas
 *    trois tailles du même dessin, ce sont **trois compositions distinctes à charge
 *    de texte décroissante** (30, 13 et 6 textes sur `logements-nerea-aytre`),
 *    chacune composée pour être lue à sa propre taille. Servir l'une ou l'autre
 *    n'est donc pas une mise à l'échelle, que le protocole interdit.
 *
 *    Les bornes sont dérivées du **plancher de lisibilité du mono, 6,5 px**, mesuré
 *    sur les 23 dossiers (mono minimal : 10 px sur la planche et l'appui, 9 px sur
 *    la vignette) — elles ne viennent pas de la grille Tailwind :
 *
 *      ≥ 880 px  planche.svg   pleine largeur    échelle 0,68 → 0,96   mono 6,8 → 9,6
 *      480–879   appui.svg     max 552, centré   échelle 0,74 → 1,00   mono 7,4 → 10
 *      < 480     vignette.svg  max 300, centré   échelle ≤ 1,00        mono 9
 *
 *    Aucun format n'est servi au-dessus de sa taille de conception : la sur-échelle
 *    épaissit les filets de 1 px, c'est le défaut fondateur du dispositif. La marge
 *    qui reste autour d'un dessin plafonné est légitime — un plan a des marges.
 *
 *    La borne haute n'est pas `lg` : la planche tient jusqu'à 845 px de fenêtre
 *    avant que son mono ne passe sous le plancher. 880 lui laisse la marge, et
 *    480 est posé au-dessus de toutes les largeurs de téléphone (430 au plus),
 *    de sorte qu'un téléphone reçoit toujours la vignette, jamais un appui rétréci
 *    à 6,2 px de mono.
 *
 * 4. **Le repli de lecture a été SUPPRIMÉ** — la figure est le dessin, son cartouche
 *    et l'agrandissement, rien d'autre (arbitrage FT2E du 2026-08-15, qui revient
 *    sur celui du matin même : le repli avait d'abord été placé sous le dessin).
 *
 *    Le motif est l'ordre de la page, pas la figure prise isolément. Sur téléphone
 *    une fiche se lit : titre → planche → cartouche technique → relevé → synthèse
 *    → récit. Le repli s'intercalait entre l'illustration et le contenu réel, et il
 *    mesurait 791 px sur Néréa, 965 sur l'EHPAD, **1 181 sur Marans** : le visiteur
 *    traversait jusqu'à un écran et demi de valeurs synthétiques avant d'apprendre
 *    de quoi la fiche parle. Des valeurs qui arrivent avant tout contexte ne
 *    démontrent rien — elles ne démontrent qu'une fois qu'on sait ce qu'on regarde.
 *    Le premier arbitrage avait raisonné sur la figure seule et manqué cela.
 *
 *    L'objection d'accessibilité qui l'avait fait garder est levée autrement, et
 *    mieux : `vignette.svg` est `aria-hidden` à la source, donc son conteneur porte
 *    `role="img"` et l'`aria_label` de l'extraction — les 822 signes que
 *    `planche.svg` et `appui.svg` exposent nativement. L'équivalent textuel est
 *    intégral à toutes les largeurs, sans un pixel de bloc visible.
 *
 *    Ce qui reste de l'extraction à l'écran : le `cartouche_legende` au pied de la
 *    figure, et le titre au `<h1>` de la fiche par `titreCourt()`. Le reste du
 *    `planche.json` sert le dessin, l'alternative textuelle et la relecture FT2E.
 */
interface Props {
  /** Chemin du SVG depuis `public/` — champ `planche` du frontmatter. */
  src: string;
  /** `pleine` : la planche entière. `vignette` : le cadrage 3:2 écrit par l'extraction. */
  variante?: 'pleine' | 'vignette';
  /** Identifiant de la boîte d'agrandissement — unique par page. */
  id?: string;
}

const { src, variante = 'pleine', id = 'planche' } = Astro.props;

const racine = path.join(process.cwd(), 'public');
const svgBrut = fs.readFileSync(path.join(racine, src), 'utf-8');
const extraction = JSON.parse(
  fs.readFileSync(path.join(racine, src.replace(/\.svg$/, '.json')), 'utf-8'),
);

// La vignette est un FICHIER PROPRE, pas un recadrage.
//
// Elle a d'abord été un rectangle découpé dans la planche. Trois cadrages
// successifs ont été nécessaires pour qu'elle ne coupe ni un mot, ni le filet
// séparateur, ni la colonne des valeurs — et le troisième restait un compromis :
// un dessin composé pour 1200 px et donné à lire à 290 tombe à l'échelle 0,24,
// quel que soit l'endroit où on le découpe.
//
// `vignette.svg` est composé dans un repère de 300 × 200, soit l'échelle 0,91 à
// 0,99 des cartes de projet mesurées (274 à 296 px). Elle garde de la planche
// ce qui porte la thèse — la géométrie des flux et les deux nœuds chiffrés — et
// laisse le titre (la carte l'affiche juste dessous), le relevé, la phrase de
// principe et les libellés de poste.
//
// Elle est décorative : `aria-hidden` posé à la source. Une vignette est
// toujours doublée du titre de la fiche, qu'elle ne fait qu'illustrer.
const svgVignette = fs.readFileSync(
  path.join(racine, src.replace(/planche\.svg$/, 'vignette.svg')),
  'utf-8',
);

// L'appui — la composition intermédiaire, tenue jusqu'ici pour le seul hero de
// l'accueil. Il porte le surtitre court, les chiffres de nœud et une légende
// ramassée : de quoi lire le mécanisme entre 480 et 879 px, là où la planche
// tomberait sous le plancher du mono et où la vignette flotterait dans la
// largeur. Comme la planche, il porte `role="img"` et son `aria-label` complet.
const svgAppui = fs.readFileSync(
  path.join(racine, src.replace(/planche\.svg$/, 'appui.svg')),
  'utf-8',
);

// Le garde-fou « toute extraction doit porter une forme de repli » a été RETIRÉ
// avec le repli lui-même (2026-08-15, second arbitrage). Il protégeait d'un
// risque précis — une fiche muette sur téléphone, faute de dessin ET de lecture —
// qui n'existe plus : le dessin est servi à toutes les largeurs, et la vignette
// porte l'`aria_label` de l'extraction. Le maintenir aurait fait échouer le build
// au nom d'un rendu qui n'a plus lieu. Même principe que l'amendement A9 : un
// contrôle se retire avec ce qu'il contrôlait, sinon il ment sur son objet.

---

{variante === 'vignette' ? (
  <span class="block w-full overflow-hidden" set:html={svgVignette} />
) : (
  <Fragment>
  <figure class="plan-pose" data-plan>
    {/* Les trois dessins. Un seul est rendu à la fois ; `display:none` retire les
        deux autres de l'arbre d'accessibilité, de sorte qu'un seul `aria-label`
        de planche est annoncé. Les bornes sont posées dans le `<style>` du
        composant, avec leur dérivation. Le dessin de la bande haute garde
        `data-planche-dessin` : c'est LUI que l'agrandissement clone, à toutes
        les largeurs — sur téléphone, la boîte donne les 30 textes de la planche
        que la vignette n'en publie que six. */}
    <div class="dessin-grand" data-planche-dessin set:html={svgBrut} />
    <div class="dessin-moyen" set:html={svgAppui} />
    {/* La vignette est `aria-hidden` À LA SOURCE — elle a été composée pour les
        cartes de `/references`, où le titre de la fiche la double toujours. Ici
        elle est le seul dessin servi, donc son conteneur porte le rôle et
        l'alternative que le SVG ne porte pas : c'est ce qui a permis de retirer
        le repli de lecture sans laisser un lecteur d'écran devant rien. */}
    <div
      class="dessin-petit"
      role="img"
      aria-label={extraction.aria_label}
      set:html={svgVignette}
    />

    <figcaption class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-filet-2 bg-calcaire px-5 py-3">
      {/* Le cartouche ne s'affiche QUE là où le dessin ne le porte pas — donc
          sous 880 px, où l'appui et la vignette n'en composent aucun. Sur la
          planche, le répéter ici donnait le même texte deux fois à dix pixels
          d'intervalle : précisément le doublon que la révision 2 du gabarit
          avait chassé de l'intérieur de la planche. */}
      <span class="legende-petite mono-label normal-case text-pivot min-w-0">{extraction.cartouche_legende}</span>
      <span class="legende-grande mono-label text-pivot">
        Planche FT2E — {extraction.archetype.replace('-', ' ')}
      </span>
      {/* L'agrandissement est proposé à TOUTES les largeurs depuis le
          2026-08-15. Il était `hidden lg:inline-flex` — donc absent précisément
          là où il sert le plus : c'est sur téléphone que la boîte apporte le
          plus, puisqu'elle donne la planche entière (30 textes) là où la page
          sert la vignette (6). La feuille agrandie garde son `min-width` de
          860 px et défile au doigt dans la zone. */}
      <button
        type="button"
        class="btn-filaire cible-44 inline-flex shrink-0 ml-auto"
        data-planche-agrandir
        aria-haspopup="dialog"
        aria-controls={`${id}-dialogue`}
      >
        Agrandir
      </button>
    </figcaption>
  </figure>

  {/* Boîte d'agrandissement — un plan éclairé dans une pièce sombre.

      Le parti : aucune chrome autour du dessin. Le `<dialog>` occupe tout
      l'écran et reste transparent ; ce qu'on voit est le voile, la barre qui
      flotte dessus, et la feuille. Une barre d'outils encadrant la planche
      entrerait en concurrence avec son propre bloc de titre — la planche porte
      déjà son surtitre, son titre et son cartouche. */}
  <dialog
    id={`${id}-dialogue`}
    class="planche-boite"
    aria-label={`Planche agrandie — ${extraction.titre}`}
  >
    <div class="planche-scene">
      <div class="planche-barre">
        <span class="mono-label planche-enseigne">
          Planche FT2E — {extraction.archetype.replace('-', ' ')}
        </span>
        {/* La loupe — deux états, et elle n'existe que là où les deux diffèrent.
            La feuille veut 860 px pour que son mono de 10 tienne le plancher de
            6,5 ; sous 931 px de fenêtre (860 + les 56 de marge de zone + la
            barre de défilement) elle ne peut donc pas être à la fois entière et
            lisible. La boîte s'ouvre alors AJUSTÉE — on voit la structure d'un
            coup d'œil, sans basculer le téléphone — et ce bouton la porte à
            860 px pour lire, en la parcourant du doigt. Au-dessus de 940 px les
            deux états se confondent : le bouton disparaît. */}
        <button
          type="button"
          class="planche-loupe cible-44"
          data-planche-loupe
          aria-pressed="false"
        >
          <span data-loupe-libelle>Lire au détail</span>
        </button>
        <button type="button" class="planche-fermer cible-44" data-planche-fermer>
          <span class="planche-touche" aria-hidden="true">Échap</span>
          <span>Fermer</span>
          {/* La croix est tracée à 1 px, comme tous les filets du système :
              aucune bibliothèque d'icônes n'entre dans la charte. */}
          <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false">
            <path d="M1 1 L11 11 M11 1 L1 11" fill="none" stroke="currentColor" stroke-width="1" />
          </svg>
        </button>
      </div>

      {/* Cliquer à côté de la feuille ferme la boîte : la zone est la cible, le
          plan ne l'est pas. */}
      <div class="planche-zone" data-planche-zone>
        <div class="planche-plan" data-planche-cible></div>
      </div>
    </div>
  </dialog>
  </Fragment>
)}

<style>
  /* ── Les trois bandes ────────────────────────────────────────────────────
     Un dessin par bande de largeur, plafonné à sa taille de conception et
     centré. Les bornes sont dérivées du plancher de lisibilité du mono
     (6,5 px), pas de la grille Tailwind — voir l'en-tête du fichier. Elles
     s'écrivent ici plutôt qu'en variantes utilitaires arbitraires
     (`min-[880px]:block`) pour deux raisons : les trois bornes et leur
     justification tiennent au même endroit, et une règle CSS de composant
     échappe à l'élagage de sources de Tailwind v4, qui a déjà supprimé
     silencieusement des classes en valeur arbitraire de ce dépôt sans faire
     échouer le build (incident du 2026-08-08).

     Le fond de chaque dessin est le papier, comme celui du `.plan-pose` qui le
     porte : un dessin plafonné ne se lit donc pas comme une vignette collée sur
     un panneau, mais comme un plan à marges plus larges. */
  .dessin-grand,
  .dessin-moyen,
  .dessin-petit { display: none; }

  /* ≥ 880 : la planche (1200 × 800), sur toute la largeur du conteneur.
     Elle porte ses propres marges de 56 et EST le plan posé : aucun padding.
     À 880 px de fenêtre l'échelle vaut 0,68 et son mono de 10 px se rend à
     6,8 — au-dessus du plancher. Elle tiendrait jusqu'à 845 ; 880 lui laisse
     la marge. */
  @media (min-width: 880px) {
    .dessin-grand { display: block; }
  }

  /* 480–879 : l'appui (552 × 368), plafonné et centré. Sa marge interne ne
     vaut que 24 contre 56 à la planche : le padding vertical la porte à 52,
     de sorte que le dessin ne touche pas le filet du plan. */
  @media (min-width: 480px) and (max-width: 879.98px) {
    .dessin-moyen {
      display: block;
      max-width: 552px;
      margin-inline: auto;
      padding-block: 28px;
    }
  }

  /* < 480 : la vignette (300 × 200). La borne est posée au-dessus de toutes
     les largeurs de téléphone (430 au plus) : un appui servi à 390 px tomberait
     à l'échelle 0,62, soit 6,2 px de mono, sous le plancher. Marge interne 14,
     portée à 42. */
  @media (max-width: 479.98px) {
    .dessin-petit {
      display: block;
      max-width: 300px;
      margin-inline: auto;
      padding-block: 28px;
    }
  }

  /* Le pied de figure : le cartouche de l'extraction là où le dessin ne le
     compose pas (sous 880), l'enseigne de planche au-dessus. */
  .legende-grande { display: none; }
  @media (min-width: 880px) {
    .legende-petite { display: none; }
    .legende-grande { display: block; }
  }

  /* ── La boîte : transparente et plein écran ─────────────────────────────
     Le voile est porté par `::backdrop`, la mise en page par `.planche-scene`.
     Un `<dialog>` dimensionné et opaque obligeait à lui poser une barre
     d'outils ; celui-ci n'a pas de bord, donc pas de chrome à dessiner. */
  .planche-boite {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background-color: transparent;
    overflow: hidden;
    color: var(--color-clair);
  }

  /* Le voile. La charte proscrit le noir — « ombre = encre translucide, jamais
     du noir » : c'est le PROFOND qui fait la nuit, à 90 %. À cette opacité
     l'écart avec un noir pur ne dépasse pas 23 niveaux sur 255, sur un seul
     canal : invisible. */
  .planche-boite::backdrop {
    background-color: color-mix(in srgb, var(--color-profond) 90%, transparent);
  }

  .planche-scene {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* ── La barre flottante ── */
  .planche-barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-shrink: 0;
    padding: 20px 28px;
  }
  .planche-enseigne {
    color: var(--color-clair);   /* 10,45:1 sur profond — le pivot y est interdit */
  }

  .planche-fermer {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 2px;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-clair);
    transition: color 260ms var(--ease-blueprint);
  }
  .planche-fermer:hover { color: var(--color-voile); }
  /* Focus par polarité (amendement A4) : clair sur réserve profonde, le pivot
     y tombe à 2,85. */
  .planche-fermer:focus-visible {
    outline: 2px solid var(--color-clair);
    outline-offset: 4px;
  }
  .planche-touche {
    padding: 3px 7px;
    border: 1px solid var(--color-filet-clair-2);
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  @media (max-width: 520px) { .planche-touche { display: none; } }

  /* Sur téléphone la boîte devient la vraie réponse au petit écran : c'est là
     qu'elle donne les 30 textes de la planche là où la page sert les 6 de la
     vignette. Les marges de 28 px y coûtent 56 px de dessin sur 390 — elles
     tombent à 16. */
  @media (max-width: 640px) {
    .planche-barre { padding: 14px 16px; }
    .planche-zone { padding: 0 16px 24px; }
  }

  /* ── La loupe : deux états, sous 940 px seulement ────────────────────────
     Une planche en 3:2 dans un écran de téléphone en 1:2 ne peut pas être à la
     fois entière et lisible — il faut choisir ce qu'on sacrifie, et le laisser
     choisir. La boîte s'ouvre AJUSTÉE (échelle ≈ 0,27 à 390 px : la structure
     se lit, aucun mot), et la loupe la porte à 860 px, où le mono tient le
     plancher et où l'on parcourt du doigt.

     Le seuil vaut 860 + 56 de marge de zone + la barre de défilement ≈ 931 ;
     940 lui laisse la marge. Au-delà, les deux états donnent la même image et
     le bouton n'a plus d'objet — il disparaît. */
  .planche-loupe { display: none; }

  @media (max-width: 939.98px) {
    .planche-loupe {
      display: inline-flex;
      align-items: center;
      padding: 6px 10px;
      border: 1px solid var(--color-filet-clair-2);
      background: none;
      cursor: pointer;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-clair);
      transition: color 260ms var(--ease-blueprint);
    }
    .planche-loupe:hover { color: var(--color-voile); }
    /* Focus par polarité (A4) : clair sur réserve profonde, le pivot y tombe
       à 2,85. */
    .planche-loupe:focus-visible {
      outline: 2px solid var(--color-clair);
      outline-offset: 4px;
    }
  }

  /* Sous 600 px l'enseigne cède la place aux deux commandes : la barre porte
     trois éléments et le nom de la planche est déjà au pied de la figure. */
  @media (max-width: 600px) {
    .planche-enseigne { display: none; }
  }

  /* ── La feuille ── */
  .planche-zone {
    flex: 1;
    min-height: 0;
    display: flex;
    overflow: auto;
    padding: 0 28px 36px;
  }
  /* `margin: auto` et non `justify-content: center` : un enfant centré par le
     conteneur voit son bord gauche coupé dès qu'il déborde, et devient
     inatteignable au défilement. */
  /* 860 px est la largeur en dessous de laquelle le mono de 10 px de la planche
     passe sous le plancher de 6,5 (860 → 7,2). C'est une cote de LISIBILITÉ,
     pas une taille d'affichage : sur un écran plus étroit, la feuille déborde
     et se parcourt. Voir la loupe ci-dessous pour ce qui se passe alors. */
  .planche-plan {
    margin: auto;
    width: min(1200px, 100%);
    min-width: 860px;
    background-color: var(--color-papier);
    /* Un filet clair, pas une ombre : sur un fond à 90 % de profond, aucune
       ombre ne se voit. C'est le filet qui détache la feuille de la nuit. */
    outline: 1px solid var(--color-filet-clair-1);
  }

  /* Les deux états de la feuille. Ces deux règles doivent rester APRÈS
     `.planche-plan` ci-dessus : une `@media` n'ajoute aucune spécificité, c'est
     l'ordre de la feuille de style qui départage. Placées plus haut — ce qui
     était le cas à la première écriture — elles sont écrasées par le
     `min-width: 860px` de la règle de base, et la boîte s'ouvre agrandie sans
     qu'aucun build ni aucune capture ne le signale. */
  @media (max-width: 939.98px) {
    /* ajusté : la feuille entière tient dans l'écran */
    .planche-plan { min-width: 0; }
    /* loupe : la cote de lisibilité, et l'on parcourt */
    .planche-zone[data-loupe] .planche-plan { min-width: 860px; }
  }

  /* ── Entrée : la révélation de plan de la charte, au tempo d'une interaction.
     Même geste (22 px, montée + apparition) et même courbe unique que
     `[data-plan]`, mais à 300 ms : une boîte qui répond à un clic ne se révèle
     pas au rythme d'un bloc qui entre dans la vue. */
  .planche-boite[open] .planche-scene {
    animation: planche-parait 300ms var(--ease-blueprint) both;
  }
  .planche-boite[open]::backdrop {
    animation: planche-voile 300ms var(--ease-blueprint) both;
  }
  @keyframes planche-parait {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes planche-voile {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .planche-boite[open] .planche-scene,
    .planche-boite[open]::backdrop { animation: none; }
  }
</style>

<script>
  // Règle 9 du projet : tout script de composant se relie sur `astro:page-load`,
  // sans quoi il devient inerte après la première navigation View Transitions.
  function initPlanche() {
    document.querySelectorAll<HTMLButtonElement>('[data-planche-agrandir]').forEach((bouton) => {
      if (bouton.dataset.bound) return;
      bouton.dataset.bound = '1';

      const dialogue = document.getElementById(
        bouton.getAttribute('aria-controls') ?? '',
      ) as HTMLDialogElement | null;
      if (!dialogue) return;

      const cible = dialogue.querySelector<HTMLElement>('[data-planche-cible]');
      const zone = dialogue.querySelector<HTMLElement>('[data-planche-zone]');
      const dessin = bouton.closest('figure')?.querySelector<HTMLElement>('[data-planche-dessin] svg');
      if (!cible || !zone || !dessin) return;

      bouton.addEventListener('click', () => {
        // Le dessin est CLONÉ à l'ouverture plutôt que dupliqué dans le HTML :
        // une seule copie du SVG est transmise, et le clone porte déjà son
        // `aria-label`. Il est remplacé à chaque ouverture, jamais accumulé.
        cible.replaceChildren(dessin.cloneNode(true));
        dialogue.showModal();
        // `showModal()` n'immobilise pas la page derrière la boîte dans tous
        // les navigateurs : on la verrouille explicitement.
        document.documentElement.style.overflow = 'hidden';
      });

      dialogue.querySelector('[data-planche-fermer]')?.addEventListener('click', () => dialogue.close());

      // La loupe. L'état vit sur la ZONE (`data-loupe`) et non sur la feuille :
      // c'est la zone qui porte le défilement, et c'est elle qu'il faut recadrer
      // au basculement.
      const loupe = dialogue.querySelector<HTMLButtonElement>('[data-planche-loupe]');
      const libelle = loupe?.querySelector<HTMLElement>('[data-loupe-libelle]');
      const poserLoupe = (actif: boolean) => {
        zone.toggleAttribute('data-loupe', actif);
        loupe?.setAttribute('aria-pressed', String(actif));
        if (libelle) libelle.textContent = actif ? 'Ajuster' : 'Lire au détail';
        // À l'agrandissement, on se pose au MILIEU de la feuille. Le défilement
        // part sinon du bord gauche, et la planche s'ouvre sur sa marge.
        if (actif) zone.scrollLeft = (zone.scrollWidth - zone.clientWidth) / 2;
      };
      loupe?.addEventListener('click', () => poserLoupe(!zone.hasAttribute('data-loupe')));

      // Un clic à côté de la feuille ferme la boîte. La cible est la ZONE : le
      // `<dialog>` occupant tout l'écran, il n'est jamais lui-même la cible d'un
      // clic, et le test habituel `e.target === dialogue` ne se déclencherait
      // jamais. Échap reste géré nativement par `<dialog>`.
      zone.addEventListener('click', (e) => {
        if (e.target === zone) dialogue.close();
      });

      dialogue.addEventListener('close', () => {
        cible.replaceChildren();
        document.documentElement.style.overflow = '';
        // La boîte se rouvre toujours ajustée : un état de loupe hérité de la
        // consultation précédente rouvrirait sur un fragment de feuille, ce que
        // ce chantier vient précisément de corriger.
        poserLoupe(false);
      });
    });
  }

  document.addEventListener('astro:page-load', initPlanche);
</script>
