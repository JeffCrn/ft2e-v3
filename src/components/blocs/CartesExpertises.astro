---
import { getCollection } from 'astro:content';
import CarteExpertise from './CarteExpertise.astro';

// Section des six expertises — charte v3 : titre de section à puce
// profonde, cellules de liste en grille (gouttière 24 px sur la trame).
interface Props {
  /** Numéro de section sur la planche (ex. « 03 ») — optionnel. */
  numero?: string;
}

const { numero } = Astro.props;

const expertises = (await getCollection('expertises')).sort((a, b) => a.data.ordre - b.data.ordre);
---

<section class="py-12 md:py-[76px]">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="flex items-center gap-3">
      <span class="puce-section" aria-hidden="true"></span>
      <span class="mono-label text-pivot">{numero ? `${numero} — expertises` : 'expertises'}</span>
    </div>
    <h2 class="type-section text-[26px] mt-4">
      <span class="text-encre">Six expertises</span>
      <span class="text-clair" aria-hidden="true">/de l’audit au DOE numérique — un interlocuteur unique</span>
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {expertises.map((expertise) => (
        <CarteExpertise expertise={expertise} />
      ))}
    </div>
  </div>
</section>
