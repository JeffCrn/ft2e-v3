---
import type { CollectionEntry } from 'astro:content';
import BadgeDemo from '../primitives/BadgeDemo.astro';

interface Props {
  projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { secteur, typologie, moa, architecte, lieu, surface_m2, annee, performance, mission_ft2e, demo } = projet.data;

const lignes = [
  { label: "maître d’ouvrage", valeur: moa },
  { label: 'architecte', valeur: architecte },
  { label: 'lieu', valeur: lieu },
  { label: 'surface', valeur: surface_m2 ? `${surface_m2.toLocaleString('fr-FR')} m²` : undefined },
  { label: 'année', valeur: String(annee) },
  { label: 'typologie', valeur: typologie },
  { label: 'secteur', valeur: secteur },
  { label: 'performance', valeur: performance },
].filter((l) => l.valeur && l.valeur !== '—');
---

<aside class="border border-line-strong">
  <div class="flex items-center gap-3 px-5 py-4 border-b border-line">
    <h2 class="mono-label text-slate font-medium">fiche technique</h2>
    {demo && <BadgeDemo />}
  </div>

  <dl>
    {lignes.map((ligne) => (
      <div class="grid grid-cols-[1fr_auto] gap-4 px-5 py-3 border-b border-line/60">
        <dt class="mono-label font-normal text-slate tracking-[0.1em]">{ligne.label}</dt>
        <dd class="mono-data text-marine text-right leading-[1.4]">{ligne.valeur}</dd>
      </div>
    ))}
  </dl>

  <div class="px-5 py-4 bg-paper">
    <p class="mono-label font-normal text-slate mb-2">mission FT2E</p>
    <p class="mono-data text-marine">{mission_ft2e.join(' · ')}</p>
  </div>
</aside>
