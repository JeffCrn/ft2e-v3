---
import type { CollectionEntry } from 'astro:content';
import BadgeDemo from '../primitives/BadgeDemo.astro';
import { chronologie, commune } from '../../lib/projets';

// Cartouche de fiche d'affaire — charte v3 (§ 10) : un plan posé (bordure
// 1 px, ombre de rang 1), en-tête sur calcaire, lignes séparées par des
// filets 1 px par rang d'opacité. Données en cases de mono, ordre de
// lecture constant : intitulé, chronologie, lieu. La barre de rang 4 px
// n'existe plus.
interface Props {
  projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { secteur, secteur_secondaire, typologie, moa, architecte, lieu, surface_m2, mission_ft2e, demo } = projet.data;

// Chronologie publique (ADR-003) : toujours « livraison », le millésime de
// réception quand elle est prononcée, celui annoncé sinon (2026-08-15). Le
// numéro d'affaire et le millésime d'ouverture restent au frontmatter et au
// JSON-LD, jamais à l'écran.
const chrono = chronologie(projet);

const lignes = [
  { label: chrono.label, valeur: chrono.valeur, rang: 'encre' },
  // La commune et son code postal, jamais l'adresse de chantier : le cartouche
  // est un bloc de lecture rapide, pas une fiche d'acheminement.
  { label: 'lieu', valeur: commune(lieu).libelle, rang: 'encre' },
  { label: "maître d’ouvrage", valeur: moa, rang: 'pivot' },
  { label: 'architecte', valeur: architecte, rang: 'pivot' },
  { label: 'surface', valeur: surface_m2 ? `${surface_m2.toLocaleString('fr-FR')} m²` : undefined, rang: 'pivot' },
  { label: 'typologie', valeur: typologie, rang: 'pivot' },
].filter((l) => l.valeur && l.valeur !== '—');
---

<aside class="plan-pose" data-plan>
  <div class="px-5 py-4 bg-calcaire border-b border-filet-1 flex items-center gap-3">
    <h2 class="mono-label text-pivot font-medium">{[secteur, secteur_secondaire].filter(Boolean).map((s) => s!.toLowerCase()).join(' · ')} — {typologie.toLowerCase()}</h2>
    {demo && <BadgeDemo />}
  </div>

  <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
    {lignes.map((ligne) => (
      <div class="px-5 py-3 border-b border-filet-3">
        <dt class="mono-label font-normal text-[10px] text-pivot">{ligne.label}</dt>
        <dd class:list={['mono-data mt-1.5 leading-[1.4]', ligne.rang === 'encre' ? 'text-encre' : 'text-pivot']}>
          {ligne.valeur}
        </dd>
      </div>
    ))}
  </dl>

  <div class="px-5 py-4 bg-calcaire">
    <p class="mono-label font-normal text-pivot mb-2">mission FT2E</p>
    <p class="mono-data text-encre">{mission_ft2e.join(' · ')}</p>
  </div>
</aside>
