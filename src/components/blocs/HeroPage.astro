---
import Breadcrumbs from '../seo/Breadcrumbs.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  breadcrumbs: BreadcrumbItem[];
  eyebrow?: string;
  titre: string;
  sousTitre?: string;
  size?: 'default' | 'compact';
}

const {
  breadcrumbs,
  eyebrow,
  titre,
  sousTitre,
  size = 'default',
} = Astro.props;

const paddingClasses = {
  default: 'pb-14 md:pb-16',
  compact: 'pb-10 md:pb-12',
};

const titleSize = {
  default: 'font-size: clamp(2rem, 4.5vw, 3.5rem);',
  compact: 'font-size: clamp(1.625rem, 3.5vw, 2.5rem);',
};
---

{/* Hero clair — le papier gouverne (charte v2). La vedette est la seule
    ouverture de la page ; la barre de rang 4 px marque l'entrée principale. */}
<section class:list={['bg-papier', paddingClasses[size]]}>
  <div class="border-b border-line">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <div class="max-w-[1200px] mx-auto px-4 md:px-6 mt-10 md:mt-14">
    {eyebrow && (
      <p class="mono-label text-pivot mb-5">
        {eyebrow}
      </p>
    )}

    <h1
      class="type-display text-profond max-w-[24ch] text-balance"
      style={titleSize[size]}
    >
      {titre}
    </h1>

    <div class="w-[110px] h-1 bg-encre mt-7" aria-hidden="true"></div>

    {sousTitre && (
      <p class="mt-6 text-base leading-[1.6] text-pivot max-w-[60ch] text-pretty">
        {sousTitre}
      </p>
    )}

    {Astro.slots.has('metadata') && (
      <div class="mt-8">
        <slot name="metadata" />
      </div>
    )}
  </div>
</section>
