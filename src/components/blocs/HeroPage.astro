---
import Breadcrumbs from '../seo/Breadcrumbs.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  breadcrumbs: BreadcrumbItem[];
  eyebrow?: string;
  titre: string;
  sousTitre?: string;
  size?: 'default' | 'compact';
}

const {
  breadcrumbs,
  eyebrow,
  titre,
  sousTitre,
  size = 'default',
} = Astro.props;

const paddingClasses = {
  default: 'pb-14 md:pb-16',
  compact: 'pb-10 md:pb-12',
};

const titleSize = {
  default: 'font-size: clamp(2rem, 4.5vw, 3.5rem);',
  compact: 'font-size: clamp(1.625rem, 3.5vw, 2.5rem);',
};
---

<section class:list={['bg-encre', paddingClasses[size]]} data-hero-dark>
  <div class="border-b border-mist/25">
    <Breadcrumbs theme="dark" items={breadcrumbs} />
  </div>

  <div class="max-w-[1200px] mx-auto px-4 md:px-6 mt-10 md:mt-14">
    {eyebrow && (
      <p class="mono-label text-copper mb-5" data-reveal>
        {eyebrow}
      </p>
    )}

    <h1
      class="type-display text-cool-white max-w-[24ch]"
      style={titleSize[size]}
      data-reveal
    >
      {titre}
    </h1>

    {sousTitre && (
      <p
        class="mt-6 text-[17px] font-light text-mist max-w-[60ch] leading-[1.6]"
        data-reveal
      >
        {sousTitre}
      </p>
    )}

    {Astro.slots.has('metadata') && (
      <div class="mt-8" data-reveal>
        <slot name="metadata" />
      </div>
    )}
  </div>
</section>
