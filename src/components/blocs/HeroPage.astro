---
import Breadcrumbs from '../seo/Breadcrumbs.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  breadcrumbs: BreadcrumbItem[];
  eyebrow?: string;
  titre: string;
  sousTitre?: string;
  size?: 'default' | 'compact';
}

const {
  breadcrumbs,
  eyebrow,
  titre,
  sousTitre,
  size = 'default',
} = Astro.props;

const paddingClasses = {
  default: 'pb-14 md:pb-16',
  compact: 'pb-10 md:pb-12',
};

const titleSize = {
  default: 'font-size: clamp(2.25rem, 5vw, 3.875rem);',
  compact: 'font-size: clamp(1.75rem, 3.5vw, 2.75rem);',
};
---

{/* Hero clair — charte v3 : le h1 des pages internes est un titre d'écran
    (.type-ecran, casse normale, encre), précédé de la ligne puce + étiquette.
    Posé sur la trame de la planche ; plus de barre de rang. */}
<section class:list={[paddingClasses[size]]}>
  <div class="border-b border-filet-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <div class="max-w-[1200px] mx-auto px-4 md:px-6 mt-10 md:mt-14">
    {eyebrow && (
      <div class="flex items-center gap-3 mb-5">
        <span class="puce-section" aria-hidden="true"></span>
        <p class="mono-label text-pivot">
          {eyebrow}
        </p>
      </div>
    )}

    <h1
      class="type-ecran text-encre max-w-[26ch] text-balance"
      style={titleSize[size]}
    >
      {titre}
    </h1>

    {sousTitre && (
      <p class="mt-6 text-base leading-[1.6] text-pivot max-w-[60ch] text-pretty">
        {sousTitre}
      </p>
    )}

    {Astro.slots.has('metadata') && (
      <div class="mt-8">
        <slot name="metadata" />
      </div>
    )}
  </div>
</section>
