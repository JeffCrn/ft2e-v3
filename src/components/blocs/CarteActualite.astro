---
import type { CollectionEntry } from 'astro:content';

// Carte d'actualité — charte v3 (§ 09/10) : un plan posé (bordure 1 px
// filet-2, ombre de rang 1), vignette duotone 3:2, pied cartouche calcaire
// avec date et catégorie mono. Survol : bascule calcaire → papier (300 ms).
interface Props {
  article: CollectionEntry<'actualites'>;
}

const { article } = Astro.props;
const { titre, chapo, date, categories, demo } = article.data;

const dateFormatee = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<a href={`/actualites/${article.id}`} class="group block plan-pose">
  <div class="aspect-[3/2] duotone-media">
    <span class="absolute left-3 bottom-2.5 mono-label font-normal text-pivot z-10" aria-hidden="true">{categories[0]?.toLowerCase()}</span>
    {demo && <span class="absolute right-3 top-2.5 mono-label font-normal text-pivot z-10">[démo]</span>}
  </div>
  <div class="bg-calcaire border-t border-filet-2 p-4 transition-colors duration-300 ease-[var(--ease-blueprint)] group-hover:bg-papier">
    <div class="flex items-baseline justify-between gap-3">
      <time datetime={date.toISOString().split('T')[0]} class="mono-data text-pivot">
        {dateFormatee}
      </time>
      <span class="mono-label font-normal text-pivot">{categories[0]}</span>
    </div>
    <h3 class="type-intitule text-encre text-[17px] mt-3">
      {titre}
    </h3>
    <p class="mt-2.5 text-[15px] text-pivot leading-[1.55] line-clamp-3">
      {chapo}
    </p>
  </div>
</a>
