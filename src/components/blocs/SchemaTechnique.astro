---
// Média technique annoté du hero d'accueil — charte v3 : placeholder
// duotone + schéma de flux au pivot + annotations mono pivot (la rampe
// 197° seule, le cuivre n'existe plus). Le schéma et ses annotations
// sont statiques : seul TraceFlux anime un tracé (§ 13).
// Illustration décorative : contenu marqué [démo], bloc aria-hidden.
import CoinsCuivre from '../primitives/CoinsCuivre.astro';

// Espaces fines insécables (U+202F) dans les nombres et unités.
const annotations = [
  { texte: 'CTA double flux — 4 200 m³/h', style: 'left: 16.5%; top: 8%; max-width: 44%;' },
  { texte: 'TGBT 630 kVA', style: 'left: 41%; top: 54%; max-width: 30%;' },
  { texte: 'désenfumage cage C', style: 'right: 3%; top: 70%; text-align: right; max-width: 34%;' },
];
---

<div class="relative" aria-hidden="true">
  <div class="aspect-[3/2] lg:aspect-[16/10] duotone-media">
    <svg viewBox="0 0 800 500" preserveAspectRatio="none" class="absolute inset-0 w-full h-full z-[1]">
      <polyline
        points="120,65 120,170 330,170 330,290 560,290"
        fill="none"
        stroke="var(--color-pivot)"
        stroke-width="1"
        vector-effect="non-scaling-stroke"
      />
      <polyline
        points="560,290 560,375 700,375"
        fill="none"
        stroke="var(--color-pivot)"
        stroke-width="1"
        stroke-dasharray="4 4"
        vector-effect="non-scaling-stroke"
      />
      <rect x="116" y="61" width="8" height="8" fill="var(--color-pivot)" />
      <rect x="326" y="286" width="8" height="8" fill="var(--color-pivot)" />
      <rect x="696" y="371" width="8" height="8" fill="var(--color-pivot)" />
    </svg>
    {annotations.map((a) => (
      <span
        class="absolute mono-label font-normal text-pivot z-[2]"
        style={a.style}
      >
        {a.texte}
      </span>
    ))}
    <span class="absolute left-4 bottom-3 right-4 mono-label font-normal text-encre z-[2] truncate">
      schéma de principe — lots techniques [démo]
    </span>
  </div>
  <CoinsCuivre />
</div>
