---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';
import CarteProjet from '../../components/blocs/CarteProjet.astro';
import { parAffaireDecroissante } from '../../lib/projets';
import { photoSecteur } from '../../lib/photos';

// Index des affaires — une GRILLE DE CARTES depuis le 2026-08-15, au gabarit
// déjà employé par l'accueil, les secteurs, les expertises et les projets
// similaires. La charte prescrivait l'inverse jusqu'à sa révision 2.2
// (amendement A9) : la nomenclature tabulaire y répondait à une vignette qui
// n'était qu'un extrait de plan illisible, qu'il valait mieux réduire à une
// pastille. Le chantier des planches a fait disparaître cet objet, et l'écart
// se mesure sur les deux axes à la fois — la carte sert la vignette à sa
// taille de conception (274 px) sur moitié moins de hauteur que la ligne de
// tableau agrandie.
//
// Le rang de statut, lui, N'A PAS survécu — et pas à cause du contenant : la
// chronologie annonce depuis le 2026-08-15 une livraison sur toutes les
// fiches, « en cours » ne s'affiche plus, et le statut a donc cessé d'être
// une distinction publiée. Le mot en portait le sens ; sans lui, la graisse
// et l'opacité du filet ne renvoyaient plus à rien. Toutes les fiches restent
// sur une seule page ; le filtre réduit la grille, il ne pagine pas.
const projets = (await getCollection('projets')).sort(parAffaireDecroissante);

// Les sept secteurs d'activité, lus dans la collection `secteurs` (triée
// par ordre) — la même source que la coupe de l'accueil : le filtre reste
// aligné quel que soit le contenu. Depuis le 2026-08-26 chaque filtre est
// une VIGNETTE d'image à l'état masqué/dévoilé du carrousel (demande FT2E) :
// le premier cliché du corpus du secteur — stable d'un build à l'autre, là
// où le film de l'accueil est tiré — légendé du nom du secteur.
const secteurs = (await getCollection('secteurs'))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .map((s) => ({
    titre: s.data.titre,
    photo: photoSecteur(s.data.cliches[0].image),
  }));
---

<PageLayout
  title="Références — FT2E"
  description="Plus de 150 projets livrés en Charente-Maritime, Vendée et Deux-Sèvres. Logements, tertiaire et ERP, industriel, patrimoine, missions monotechniques."
>
  {/* Le repère du hero porte un chiffre, comme partout ailleurs sur le site
      — « l'équipe — 7 personnes », « expertise 2 — sur 4 », « secteur 3 — sur
      7 ». Il est DÉRIVÉ du corpus, jamais écrit en dur : une vingt-quatrième
      fiche le mettra à jour toute seule.

      En chiffres et non en lettres, contrairement à la règle des quantités de
      `french-editorial.md` : les quatre repères existants s'écrivent ainsi, et
      la puce est en mono — la fonte de tout ce qui se mesure. */}
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Références', href: '/references' },
    ]}
    eyebrow={`index des affaires — ${projets.length} fiches`}
    titre="Nos références récentes"
    sousTitre="Une sélection de projets représentatifs de notre activité en Charente-Maritime, Vendée et Deux-Sèvres."
  />

  <section class="py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      {/* Le titre de section n'est pas un ornement : `CarteProjet` intitule
          chaque carte en `<h3>`, et l'ancienne nomenclature les composait en
          `<span>`. Sans ce `<h2>`, la page sautait de son `<h1>` au `<h3>` —
          Lighthouse le relève en `heading-order`, et l'accessibilité tombait
          de 100 à 98. Les quatre autres grilles du site portent déjà ce même
          motif (puce + étiquette mono + titre de section) : c'est aussi par là
          qu'elles restent conformes. */}
      {/* L'ancre de remontée des filtres (2026-08-27, demande FT2E) : un clic
          sur un filtre situé bas dans le rail affiche des résultats situés en
          haut — hors de vue. Le clic remonte donc la page à cette puce, MAIS
          seulement si elle est sortie de l'écran : cliquer un chip de la
          barre du haut ne provoque aucun mouvement. Le scroll-margin-top
          (CSS du composant) compense la navigation fixe, et c'est LUI que le
          script lit comme seuil — une seule valeur, jamais deux. */}
      <div class="flex items-center gap-3" data-ancre-filtres>
        <span class="puce-section" aria-hidden="true"></span>
        <p class="mono-label text-pivot">filtrer par secteur</p>
      </div>
      <h2 class="type-section text-[22px] md:text-[24px] mt-4 mb-6">
        {/* « Les affaires », pas « Toutes les affaires » : le `<h1>` annonce
            des références RÉCENTES, et un titre de section qui promettrait
            l'exhaustivité le contredirait à trois lignes d'écart.

            Le repère au-dessus dit la FONCTION du bloc (filtrer), le
            complément dit son PÉRIMÈTRE (ce qui est publié à ce jour) : deux
            informations, là où « index complet » redisait le mot « index »
            de la puce du hero sans rien ajouter. */}
        <span class="text-encre">Les affaires</span>
        <span class="text-clair" aria-hidden="true">/publiées à ce jour</span>
      </h2>

      {/* La grille de cartes se pose à même le papier, comme les quatre autres
          du site : chaque carte EST un plan posé, et un plan ne se pose pas sur
          un plan. La grille n'est donc pas un [data-plan] — mais depuis
          l'amendement A11 (2026-08-27) elle est un GROUPE [data-plan-groupe] :
          ses cartes se révèlent en cascade, 80 ms par rang plafonné au sixième
          (le rang vit dans motion.css). */}
      {/* Les filtres sont des vignettes à l'état masqué/dévoilé du carrousel
          de l'accueil : image en retrait à 42 % d'opacité, dévoilée au survol,
          au focus et à l'état actif (aria-pressed) — une bascule d'opacité,
          aucun déplacement. La légende porte le sens (nom + décompte) et reste
          pleinement lisible aux deux états : le voilage ne s'applique qu'à
          l'image, jamais au mot (contraste RGAA). La tuile « Tous » porte une
          mini-coupe des sept secteurs — voir son commentaire dédié. */}
      {/* RAIL À GAUCHE au-dessus de 1 024 px (2026-08-26, seconde demande
          FT2E du jour — les vignettes de 130 px de la rangée étaient jugées
          trop petites) : les filtres occupent la première colonne du rythme
          de la grille (216 px à 1 024, 276 px dès 1 248 — les mesures sont
          dans le <style> du composant), et la grille de cartes passe à trois
          colonnes à leur droite. L'image double (276 px contre 130), la
          distinction contrôle/contenu devient SPATIALE, et la légende passe
          au cartouche de réserve (A8) posé sur l'image. En dessous, le rail
          se replie en rangée au-dessus de la grille — 4 par ligne sur
          tablette, 2 par ligne sur téléphone — et la légende revient SOUS
          l'image : sous ~200 px de tuile, le libellé le plus long —
          aujourd'hui « Études d'exécution / BIM (1) » — replierait en
          cartouche sur plusieurs lignes et couvrirait le cliché.
          Les deux légendes coexistent dans le balisage (`lg:hidden` /
          `hidden lg:inline-flex`) : `display: none` retire l'autre de
          l'arbre d'accessibilité, le bouton n'est jamais nommé deux fois. */}
      {/* DEUX navigations de filtre depuis le 2026-08-27 (demande FT2E) : le
          rail visuel à gauche ET une barre TEXTUELLE en tête de grille — en
          haut de page, les secteurs du bas du rail sont hors de vue, la barre
          les rend tous atteignables d'emblée. L'ALIGNEMENT est garanti par
          construction, jamais au pixel : au-dessus de 1 024 px l'agencement
          est une grille à DEUX RANGÉES — rangée 1 : l'étiquette « secteur »
          (colonne du rail) et la barre de chips (colonne de la grille), deux
          cellules étirées à la même hauteur (align-self: stretch, leurs
          filets haut et bas coïncident) ; rangée 2 : les vignettes du rail
          et la grille de cartes, qui partent donc du même haut. Les chips
          sont le composant canonique .chip-blueprint (actif = aplat encre,
          aria-pressed) ; initFiltres synchronise les DEUX jeux de boutons —
          même data-filtre, même état. */}
      <div class="agencement-references">
        <div class="rail-entete border-t border-filet-2 pt-4 lg:pt-0 lg:border-b lg:flex lg:items-center">
          <p class="mono-label font-normal text-pivot">secteur</p>
        </div>

        <div
          class="filtres-textes hidden lg:flex flex-wrap items-center gap-2 border-t border-b border-filet-2 py-3"
          role="group"
          aria-label="Filtres par secteur, en texte"
        >
          <button class="chip-blueprint" data-filtre="tous" aria-pressed="true">Tous ({projets.length})</button>
          {secteurs.map((s) => {
            const count = projets.filter((p) => p.data.secteur === s.titre).length;
            if (count === 0) return null;
            return (
              <button class="chip-blueprint" data-filtre={s.titre} aria-pressed="false">
                {s.titre} ({count})
              </button>
            );
          })}
        </div>

        <div class="rail-vignettes border-b border-filet-2 pb-4 lg:border-b-0 lg:pb-0">
          <div class="filtres-vignettes mt-3 lg:mt-0" role="group" aria-label="Filtres par secteur">
            {/* « Tous » n'a pas de cliché propre : sa tuile est une MINI-COUPE
                des sept secteurs (2026-08-26) — sept tranches verticales, une
                par secteur, chacune portant son premier cliché en duotone. Le
                motif est celui de la coupe de l'accueil : « tous » se dessine
                comme toutes les tranches. Le monogramme a été écarté — voilé
                à 0,42 il se lirait comme un tampon délavé, et la charte le
                protège des emplois d'ornement. Les SEPT secteurs y figurent,
                y compris ceux sans fiche publiée : la tuile représente le
                bureau, pas le filtre. */}
            <button class="filtre-vignette" data-filtre="tous" aria-pressed="true">
              <span class="filtre-vignette-image filtre-vignette-coupe">
                {secteurs.filter((s) => s.photo).map((s) => (
                  <span class="duotone-photo tranche-tous">
                    <Picture
                      src={s.photo!}
                      formats={['avif', 'webp']}
                      widths={[80, 160]}
                      sizes="40px"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover"
                    />
                  </span>
                ))}
              </span>
              <span class="mono-label font-normal text-pivot filtre-vignette-legende lg:hidden">
                Tous ({projets.length})
              </span>
              <span class="cartouche-legende legende-media hidden lg:inline-flex">
                Tous ({projets.length})
              </span>
            </button>
            {secteurs.map((s) => {
              const count = projets.filter((p) => p.data.secteur === s.titre).length;
              // Un secteur sans référence publiée n'apparaît pas au filtre :
              // une puce « (0) » qui ne filtre rien annonce une lacune au lieu
              // de servir. Le secteur reste présent sur /secteurs et à l'accueil.
              if (count === 0) return null;
              return (
                <button class="filtre-vignette" data-filtre={s.titre} aria-pressed="false">
                  <span class:list={['filtre-vignette-image', s.photo ? 'duotone-photo' : 'duotone-media']}>
                    {s.photo && (
                      <Picture
                        src={s.photo}
                        formats={['avif', 'webp']}
                        widths={[168, 276, 552]}
                        sizes="(min-width: 1248px) 276px, (min-width: 1024px) 216px, (min-width: 768px) 23vw, 46vw"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </span>
                  <span class="mono-label font-normal text-pivot filtre-vignette-legende lg:hidden">
                    {s.titre} ({count})
                  </span>
                  <span class="cartouche-legende legende-media hidden lg:inline-flex">
                    {s.titre} ({count})
                  </span>
                </button>
              );
            })}
          </div>
        </div>

        {/* Trois colonnes à côté du rail — et la vignette reste servie à sa
            taille de conception : dès 1 248 px de fenêtre, la boîte fait
            1 152 px, le rail en prend 276 plus 16 de gouttière, et
            (860 − 2 × 16) / 3 = 276 px de carte — la mesure même qui
            justifiait les quatre colonnes d'avant le rail (A9 : jamais de
            sur-échelle du dessin). À 1 024, rail de 216 : cartes de 232 à
            237 px selon l'ascenseur (mesuré au navigateur, ascenseur
            déduit), mono de la vignette rendu à 7,0–7,1 px — au-dessus du
            plancher de 6,5.

            `md:grid-cols-3` s'écarte des quatre autres grilles du site, qui
            vont de deux à quatre colonnes. Elles n'affichent que trois ou
            quatre cartes, où une colonne de plus laisse des orphelines ; ici
            il y en a vingt-trois, et la bande 768–1023 px passerait sans elle
            de 288 à 366 px de vignette. Mesuré, pas supposé. */}
        <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 grille-references" data-grille data-plan-groupe>
          {projets.map((projet) => (
            <li data-secteur={projet.data.secteur} class="min-w-0">
              <CarteProjet projet={projet} />
            </li>
          ))}
        </ul>
      </div>

      {/* Ni légende de rang, ni compteur — deux mentions retirées le même jour
          pour la même raison : elles avaient cessé de dire quelque chose.

          La légende donnait la clé d'un rang de statut que la chronologie
          uniformisée a rendu muet. Le compteur, lui, annonçait « 23 fiches sur
          23 » : dans l'état par défaut, les deux nombres sont égaux par
          construction, puisque la page ne pagine pas. Et sous filtre, il ne
          disait rien de plus que la puce active, qui porte déjà son propre
          décompte — « Logements (8) ». C'est aussi ce qui rend son retrait sûr
          pour un lecteur d'écran : l'`aria-live` disparaît, mais l'information
          qu'il annonçait reste dans le libellé de la puce, elle-même signalée
          par `aria-pressed`. */}
    </div>
  </section>

  <CtaFinal />
</PageLayout>

<style>
  /* Les mesures du rail et des vignettes de filtre — les couleurs restent en
     classes dans le balisage. Le voilage (opacité 0,42, la valeur du film de
     l'accueil) porte sur la BOÎTE d'image, jamais sur la légende : c'est
     aussi pourquoi le cartouche du rail est un FRÈRE de la boîte d'image
     (absolu par `.legende-media`), jamais son enfant — enfant, il hériterait
     du voilage.

     Trois paliers, écrits ici et non en variantes Tailwind arbitraires
     (règle 11 — l'élagage de sources ferait tomber une valeur arbitraire
     sans un mot du build) :
     — < 768 px : rangée au-dessus de la grille, 2 tuiles par ligne
       ((358 − 16) / 2 = 171 px à 390 de fenêtre, contre 130 avant) ;
     — 768 à 1 023 px : rangée, 4 tuiles par ligne (168 à 232 px) ;
     — ≥ 1 024 px : RAIL en première colonne — 216 px à 1 024 (les trois
       cartes font alors 237 px, mono de vignette à 7,1 px ≥ plancher 6,5),
       276 px dès 1 248 (cartes à 276 px, la taille de conception). */
  .agencement-references {
    /* < 1024 : flux normal — filtres au-dessus, grille en dessous. */
  }

  .grille-references {
    margin-top: 2rem;
  }

  /* L'ancre de remontée : la marge compense la navigation fixe (56 px
     mobile / 74 px bureau) plus le module de la trame (28 px). Le script
     de filtre lit cette valeur en computed style comme seuil de
     déclenchement — la modifier ici suffit. */
  [data-ancre-filtres] {
    scroll-margin-top: 84px;
  }

  @media (min-width: 768px) {
    [data-ancre-filtres] {
      scroll-margin-top: 102px;
    }
  }

  .filtres-vignettes {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .filtre-vignette {
    position: relative; /* ancre du cartouche `.legende-media` au rail */
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: calc((100% - 16px) / 2);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }

  @media (min-width: 768px) {
    .filtre-vignette {
      width: calc((100% - 48px) / 4);
    }
  }

  @media (min-width: 1024px) {
    /* Deux rangées : [étiquette | barre textuelle] puis [vignettes | grille].
       Les deux cellules de la rangée 1 s'étirent à la même hauteur
       (align-self: stretch) : leurs filets haut et bas coïncident, et la
       rangée 2 — vignette « Tous » et première ligne de cartes — part du
       même haut par construction. Le row-gap reprend la gouttière (24 px). */
    .agencement-references {
      display: grid;
      grid-template-columns: 216px minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 16px;
      row-gap: 24px;
      align-items: start;
    }

    .rail-entete,
    .filtres-textes {
      align-self: stretch;
    }

    .grille-references {
      margin-top: 0;
    }

    .filtre-vignette {
      width: 100%;
    }
  }

  @media (min-width: 1248px) {
    .agencement-references {
      grid-template-columns: 276px minmax(0, 1fr);
    }
  }

  .filtre-vignette-image {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    opacity: 0.42;
    transition: opacity 300ms var(--ease-blueprint);
  }

  .filtre-vignette:hover .filtre-vignette-image,
  .filtre-vignette:focus-visible .filtre-vignette-image,
  .filtre-vignette[aria-pressed='true'] .filtre-vignette-image {
    opacity: 1;
  }

  .filtre-vignette-legende {
    font-size: 10px;
    line-height: 1.35;
  }

  /* La mini-coupe de « Tous » : sept tranches égales, jointes par un filet
     de papier de 2 px — l'écho, en réduction, de la coupe de l'accueil. */
  .filtre-vignette-coupe {
    display: flex;
    gap: 2px;
  }

  .tranche-tous {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
  }
</style>

<script>
  function initFiltres() {
    const grille = document.querySelector<HTMLElement>('[data-grille]');
    if (!grille) return;
    if (grille.dataset.filtresBound) return;
    grille.dataset.filtresBound = '1';

    const filtres = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
    // `[data-secteur]` est porté par le `<li>`, l'élément que la grille
    // positionne : le masquer sur le `<a>` intérieur laisserait une cellule
    // vide dans le flux et trouerait la grille.
    const cartes = document.querySelectorAll<HTMLElement>('[data-secteur]');

    // Le filtre réduit la grille, sans transition d'apparition (charte v3).
    // Il ne tient plus de décompte : la puce active porte le sien.
    const appliquer = (secteur: string | null) => {
      cartes.forEach((carte) => {
        const match = secteur === 'tous' || carte.getAttribute('data-secteur') === secteur;
        carte.style.display = match ? '' : 'none';
      });
    };

    /* Deux jeux de boutons portent les mêmes data-filtre depuis le
       2026-08-27 (rail visuel + barre textuelle) : l'état actif se pose
       par VALEUR de filtre, jamais sur le seul bouton cliqué — les deux
       navigations restent synchrones. */
    const activer = (btn: HTMLButtonElement) => {
      const secteur = btn.getAttribute('data-filtre');
      filtres.forEach((b) => {
        b.setAttribute('aria-pressed', b.getAttribute('data-filtre') === secteur ? 'true' : 'false');
      });
      appliquer(secteur);
    };

    /* La remontée à l'ancre (2026-08-27) : filtrer depuis le bas du rail
       affiche des résultats hors de vue — le clic ramène la page à la puce
       de la section. Seulement si l'ancre est sortie de l'écran (le seuil
       est son propre scroll-margin-top : une seule valeur, dans le CSS du
       composant), en douceur sauf réduction de mouvement demandée, et
       JAMAIS au filtrage par URL — la page se charge déjà en haut. */
    const ancre = document.querySelector<HTMLElement>('[data-ancre-filtres]');
    const remonte = () => {
      if (!ancre) return;
      const seuil = parseFloat(getComputedStyle(ancre).scrollMarginTop) || 0;
      if (ancre.getBoundingClientRect().top >= seuil - 1) return;
      const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      ancre.scrollIntoView({ behavior: reduit ? 'auto' : 'smooth', block: 'start' });
    };

    filtres.forEach((btn) => {
      btn.addEventListener('click', () => {
        activer(btn);
        remonte();
      });
    });

    /* La page se laisse filtrer par l'URL — `/references/?secteur=Logements` —
       depuis le 2026-08-26 : c'est par là que les clichés de la coupe de
       l'accueil arrivent. Un secteur inconnu ou sans fiche publiée (donc sans
       filtre) est ignoré : la grille reste complète, rien ne casse. */
    const demande = new URLSearchParams(window.location.search).get('secteur');
    if (demande) {
      const btn = [...filtres].find((b) => b.getAttribute('data-filtre') === demande);
      if (btn) activer(btn);
    }
  }

  document.addEventListener('astro:page-load', initFiltres);
</script>
