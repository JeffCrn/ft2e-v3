---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';
import CarteProjet from '../../components/blocs/CarteProjet.astro';
import { parAffaireDecroissante } from '../../lib/projets';
import { photoSecteur } from '../../lib/photos';

// Index des affaires — une GRILLE DE CARTES depuis le 2026-08-15, au gabarit
// déjà employé par l'accueil, les secteurs, les expertises et les projets
// similaires. La charte prescrivait l'inverse jusqu'à sa révision 2.2
// (amendement A9) : la nomenclature tabulaire y répondait à une vignette qui
// n'était qu'un extrait de plan illisible, qu'il valait mieux réduire à une
// pastille. Le chantier des planches a fait disparaître cet objet, et l'écart
// se mesure sur les deux axes à la fois — la carte sert la vignette à sa
// taille de conception (274 px) sur moitié moins de hauteur que la ligne de
// tableau agrandie.
//
// Le rang de statut, lui, N'A PAS survécu — et pas à cause du contenant : la
// chronologie annonce depuis le 2026-08-15 une livraison sur toutes les
// fiches, « en cours » ne s'affiche plus, et le statut a donc cessé d'être
// une distinction publiée. Le mot en portait le sens ; sans lui, la graisse
// et l'opacité du filet ne renvoyaient plus à rien. Toutes les fiches restent
// sur une seule page ; le filtre réduit la grille, il ne pagine pas.
const projets = (await getCollection('projets')).sort(parAffaireDecroissante);

// Les sept secteurs d'activité, lus dans la collection `secteurs` (triée
// par ordre) — la même source que la coupe de l'accueil : le filtre reste
// aligné quel que soit le contenu. Depuis le 2026-08-26 chaque filtre est
// une VIGNETTE d'image à l'état masqué/dévoilé du carrousel (demande FT2E) :
// le premier cliché du corpus du secteur — stable d'un build à l'autre, là
// où le film de l'accueil est tiré — légendé du nom du secteur.
const secteurs = (await getCollection('secteurs'))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .map((s) => ({
    titre: s.data.titre,
    photo: photoSecteur(s.data.cliches[0].image),
  }));
---

<PageLayout
  title="Références — FT2E"
  description="Plus de 150 projets livrés en Charente-Maritime, Vendée et Deux-Sèvres. Logements, tertiaire et ERP, industriel, patrimoine, missions monotechniques."
>
  {/* Le repère du hero porte un chiffre, comme partout ailleurs sur le site
      — « l'équipe — 7 personnes », « expertise 2 — sur 4 », « secteur 3 — sur
      7 ». Il est DÉRIVÉ du corpus, jamais écrit en dur : une vingt-quatrième
      fiche le mettra à jour toute seule.

      En chiffres et non en lettres, contrairement à la règle des quantités de
      `french-editorial.md` : les quatre repères existants s'écrivent ainsi, et
      la puce est en mono — la fonte de tout ce qui se mesure. */}
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Références', href: '/references' },
    ]}
    eyebrow={`index des affaires — ${projets.length} fiches`}
    titre="Nos références récentes"
    sousTitre="Une sélection de projets représentatifs de notre activité en Charente-Maritime, Vendée et Deux-Sèvres."
  />

  <section class="py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      {/* Le titre de section n'est pas un ornement : `CarteProjet` intitule
          chaque carte en `<h3>`, et l'ancienne nomenclature les composait en
          `<span>`. Sans ce `<h2>`, la page sautait de son `<h1>` au `<h3>` —
          Lighthouse le relève en `heading-order`, et l'accessibilité tombait
          de 100 à 98. Les quatre autres grilles du site portent déjà ce même
          motif (puce + étiquette mono + titre de section) : c'est aussi par là
          qu'elles restent conformes. */}
      <div class="flex items-center gap-3">
        <span class="puce-section" aria-hidden="true"></span>
        <p class="mono-label text-pivot">filtrer par secteur</p>
      </div>
      <h2 class="type-section text-[22px] md:text-[24px] mt-4 mb-6">
        {/* « Les affaires », pas « Toutes les affaires » : le `<h1>` annonce
            des références RÉCENTES, et un titre de section qui promettrait
            l'exhaustivité le contredirait à trois lignes d'écart.

            Le repère au-dessus dit la FONCTION du bloc (filtrer), le
            complément dit son PÉRIMÈTRE (ce qui est publié à ce jour) : deux
            informations, là où « index complet » redisait le mot « index »
            de la puce du hero sans rien ajouter. */}
        <span class="text-encre">Les affaires</span>
        <span class="text-clair" aria-hidden="true">/publiées à ce jour</span>
      </h2>

      {/* La grille de cartes se pose à même le papier, comme les quatre autres
          du site : chaque carte EST un plan posé, et un plan ne se pose pas sur
          un plan. C'est ce qui retire le `data-plan` de cet écran — la charte
          réserve la révélation aux plans significatifs, jamais aux cartes. */}
      {/* Les filtres sont des vignettes à l'état masqué/dévoilé du carrousel
          de l'accueil : image en retrait à 42 % d'opacité, dévoilée au survol,
          au focus et à l'état actif (aria-pressed) — une bascule d'opacité,
          aucun déplacement. La légende porte le sens (nom + décompte) et reste
          pleinement lisible aux deux états : le voilage ne s'applique qu'à
          l'image, jamais au mot (contraste RGAA). « Tous » n'a pas de cliché :
          sa case reprend la hachure neutre du système. */}
      <div class="border-t border-b border-filet-2 py-4 grid grid-cols-1 md:grid-cols-[100px_1fr] gap-4 md:items-start">
        <p class="mono-label font-normal text-pivot pt-1">secteur</p>
        <div class="filtres-vignettes" role="group" aria-label="Filtres par secteur">
          <button class="filtre-vignette" data-filtre="tous" aria-pressed="true">
            <span class="filtre-vignette-image duotone-media"></span>
            <span class="mono-label font-normal text-pivot filtre-vignette-legende">
              Tous ({projets.length})
            </span>
          </button>
          {secteurs.map((s) => {
            const count = projets.filter((p) => p.data.secteur === s.titre).length;
            // Un secteur sans référence publiée n'apparaît pas au filtre :
            // une puce « (0) » qui ne filtre rien annonce une lacune au lieu
            // de servir. Le secteur reste présent sur /secteurs et à l'accueil.
            if (count === 0) return null;
            return (
              <button class="filtre-vignette" data-filtre={s.titre} aria-pressed="false">
                <span class:list={['filtre-vignette-image', s.photo ? 'duotone-photo' : 'duotone-media']}>
                  {s.photo && (
                    <Picture
                      src={s.photo}
                      formats={['avif', 'webp']}
                      widths={[132, 264]}
                      sizes="132px"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </span>
                <span class="mono-label font-normal text-pivot filtre-vignette-legende">
                  {s.titre} ({count})
                </span>
              </button>
            );
          })}
        </div>
      </div>

      {/* Quatre colonnes au palier large, et la gouttière vaut 16 px : la
          vignette est composée dans un repère de 300 × 200 pour être LUE entre
          274 et 296 px, et (1 152 − 3 × 16) / 4 = 276 px de carte, moins les
          2 px de filet du plan posé, donnent exactement 274.

          Il n'y a PAS de palier `xl` : le conteneur plafonne à 1 200 px, donc
          il vaut 1 152 dès 1 248 px de fenêtre. Une grille de trois colonnes à
          `lg` servirait 373 px à 1 279 — la sur-échelle de 1,24 qui épaissit
          tous les filets de 1 px du dessin de 24 %, le défaut même que le
          protocole des planches documente.

          `md:grid-cols-3` s'écarte des quatre autres grilles du site, qui vont
          de deux à quatre colonnes. Elles n'affichent que trois ou quatre
          cartes, où une colonne de plus laisse des orphelines ; ici il y en a
          vingt-trois, et la bande 768–1023 px passerait sans elle de 288 à
          366 px de vignette. Mesuré, pas supposé. */}
      <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mt-8" data-grille>
        {projets.map((projet) => (
          <li data-secteur={projet.data.secteur} class="min-w-0">
            <CarteProjet projet={projet} />
          </li>
        ))}
      </ul>

      {/* Ni légende de rang, ni compteur — deux mentions retirées le même jour
          pour la même raison : elles avaient cessé de dire quelque chose.

          La légende donnait la clé d'un rang de statut que la chronologie
          uniformisée a rendu muet. Le compteur, lui, annonçait « 23 fiches sur
          23 » : dans l'état par défaut, les deux nombres sont égaux par
          construction, puisque la page ne pagine pas. Et sous filtre, il ne
          disait rien de plus que la puce active, qui porte déjà son propre
          décompte — « Logements (8) ». C'est aussi ce qui rend son retrait sûr
          pour un lecteur d'écran : l'`aria-live` disparaît, mais l'information
          qu'il annonçait reste dans le libellé de la puce, elle-même signalée
          par `aria-pressed`. */}
    </div>
  </section>

  <CtaFinal />
</PageLayout>

<style>
  /* Les mesures des vignettes de filtre — les couleurs restent en classes
     dans le balisage. Le voilage (opacité 0,42, la valeur du film de
     l'accueil) porte sur la BOÎTE d'image, jamais sur la légende. */
  .filtres-vignettes {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .filtre-vignette {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 132px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }

  .filtre-vignette-image {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    opacity: 0.42;
    transition: opacity 300ms var(--ease-blueprint);
  }

  .filtre-vignette:hover .filtre-vignette-image,
  .filtre-vignette:focus-visible .filtre-vignette-image,
  .filtre-vignette[aria-pressed='true'] .filtre-vignette-image {
    opacity: 1;
  }

  .filtre-vignette-legende {
    font-size: 10px;
    line-height: 1.35;
  }
</style>

<script>
  function initFiltres() {
    const grille = document.querySelector<HTMLElement>('[data-grille]');
    if (!grille) return;
    if (grille.dataset.filtresBound) return;
    grille.dataset.filtresBound = '1';

    const filtres = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
    // `[data-secteur]` est porté par le `<li>`, l'élément que la grille
    // positionne : le masquer sur le `<a>` intérieur laisserait une cellule
    // vide dans le flux et trouerait la grille.
    const cartes = document.querySelectorAll<HTMLElement>('[data-secteur]');

    // Le filtre réduit la grille, sans transition d'apparition (charte v3).
    // Il ne tient plus de décompte : la puce active porte le sien.
    const appliquer = (secteur: string | null) => {
      cartes.forEach((carte) => {
        const match = secteur === 'tous' || carte.getAttribute('data-secteur') === secteur;
        carte.style.display = match ? '' : 'none';
      });
    };

    const activer = (btn: HTMLButtonElement) => {
      filtres.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      appliquer(btn.getAttribute('data-filtre'));
    };

    filtres.forEach((btn) => {
      btn.addEventListener('click', () => activer(btn));
    });

    /* La page se laisse filtrer par l'URL — `/references/?secteur=Logements` —
       depuis le 2026-08-26 : c'est par là que les clichés de la coupe de
       l'accueil arrivent. Un secteur inconnu ou sans fiche publiée (donc sans
       filtre) est ignoré : la grille reste complète, rien ne casse. */
    const demande = new URLSearchParams(window.location.search).get('secteur');
    if (demande) {
      const btn = [...filtres].find((b) => b.getAttribute('data-filtre') === demande);
      if (btn) activer(btn);
    }
  }

  document.addEventListener('astro:page-load', initFiltres);
</script>
