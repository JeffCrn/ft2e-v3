---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import CarteProjet from '../../components/blocs/CarteProjet.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';

const projets = (await getCollection('projets')).sort((a, b) => b.data.annee - a.data.annee);

const secteurs = ['Logement', 'Tertiaire', 'Santé', 'Sport', 'Industriel', 'Patrimoine'];
---

<PageLayout
  title="Références — FT2E"
  description="Plus de 150 projets livrés en Charente-Maritime, Vendée et Deux-Sèvres. Logement, tertiaire, santé, sport, patrimoine."
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Références', href: '/references' },
    ]}
    eyebrow="projets livrés — index filtrable"
    titre="Nos références"
    sousTitre="Une sélection de projets représentatifs de notre activité en Charente-Maritime, Vendée et Deux-Sèvres."
  />

  <section class="bg-cool-white py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="border-t border-line border-b py-3.5 grid grid-cols-1 md:grid-cols-[100px_1fr] gap-4 md:items-center mb-4">
        <p class="mono-label font-normal text-slate">secteur</p>
        <div class="flex flex-wrap" role="group" aria-label="Filtres par secteur">
          <button
            class="chip-blueprint -ml-px -mt-px cursor-pointer border-copper bg-paper text-marine"
            data-filtre="tous"
            aria-pressed="true"
          >
            Tous ({projets.length})
          </button>
          {secteurs.map((s) => {
            const count = projets.filter((p) => p.data.secteur === s).length;
            return count > 0 ? (
              <button
                class="chip-blueprint -ml-px -mt-px cursor-pointer hover:border-copper hover:text-marine"
                data-filtre={s}
                aria-pressed="false"
              >
                {s} ({count})
              </button>
            ) : null;
          })}
        </div>
      </div>

      <p class="mono-data text-slate mb-6" data-compteur data-total={projets.length} aria-live="polite">
        {projets.length} projets — sur {projets.length} publiés
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-grille>
        {projets.map((projet) => (
          <div data-secteur={projet.data.secteur}>
            <CarteProjet projet={projet} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaFinal />
</PageLayout>

<script>
  function initFiltres() {
    const grille = document.querySelector<HTMLElement>('[data-grille]');
    if (!grille) return;
    if (grille.dataset.filtresBound) return;
    grille.dataset.filtresBound = '1';

    const filtres = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
    const cartes = document.querySelectorAll<HTMLElement>('[data-secteur]');
    const compteur = document.querySelector<HTMLElement>('[data-compteur]');
    const total = compteur?.dataset.total ?? String(cartes.length);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const classesActives = ['border-copper', 'bg-paper', 'text-marine'];
    const classesInactives = ['hover:border-copper', 'hover:text-marine'];

    const appliquer = (secteur: string | null) => {
      let visible = 0;
      cartes.forEach((carte) => {
        const match = secteur === 'tous' || carte.getAttribute('data-secteur') === secteur;
        carte.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (compteur) compteur.textContent = `${visible} projet${visible > 1 ? 's' : ''} — sur ${total} publiés`;
    };

    filtres.forEach((btn) => {
      btn.addEventListener('click', () => {
        const secteur = btn.getAttribute('data-filtre');

        filtres.forEach((b) => {
          b.setAttribute('aria-pressed', 'false');
          b.classList.remove(...classesActives);
          b.classList.add(...classesInactives);
        });
        btn.setAttribute('aria-pressed', 'true');
        btn.classList.remove(...classesInactives);
        btn.classList.add(...classesActives);

        if (reduced) {
          appliquer(secteur);
          return;
        }

        grille.style.opacity = '0';
        grille.style.transform = 'scale(0.98)';
        setTimeout(() => {
          appliquer(secteur);
          requestAnimationFrame(() => {
            grille.style.opacity = '1';
            grille.style.transform = 'scale(1)';
          });
        }, 200);
      });
    });
  }

  document.addEventListener('astro:page-load', initFiltres);
</script>
