---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';
import PlancheReference from '../../components/blocs/PlancheReference.astro';
import { parAffaireDecroissante, titreCourt } from '../../lib/projets';

// Index des affaires — charte v3 : une nomenclature, pas une grille de cartes.
// Le rang de statut est porté par l'OPACITÉ du filet gauche 1 px
// (livré 22 % · en cours 16 % · archive 12 %) et par la graisse de
// l'intitulé (700 / 600 / 300), à chasse constante 112. Le statut est
// affiché en mono-label. Ni numéro d'affaire ni millésime d'ouverture
// (ADR-003) ; une colonne de chronologie a été essayée puis ajournée, la
// raison est consignée à l'ADR. Toutes les lignes sont sur une seule page ;
// le filtre réduit la liste, il ne pagine pas.
const projets = (await getCollection('projets')).sort(parAffaireDecroissante);

// Les sept secteurs d'activité, lus dans la collection `secteurs` (triée
// par ordre) — la même source que la section « secteurs » de l'accueil :
// le filtre reste aligné quel que soit le contenu.
const secteurs = (await getCollection('secteurs'))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .map((s) => s.data.titre);

const rangs = {
  livré: { filet: 'border-l-filet-1', graisse: 'font-bold', statut: 'livré' },
  'en cours': { filet: 'border-l-filet-2', graisse: 'font-semibold', statut: 'en cours' },
  archive: { filet: 'border-l-filet-3', graisse: 'font-light', statut: 'archive' },
} as const;

const lignes = projets.map((projet) => ({
  projet,
  rang: rangs[projet.data.statut],
  // Titre COURT : la colonne est en `md:truncate`, et la mesure au navigateur
  // donnait 14 titres longs coupés sur 23 — jusqu'à 103 px escamotés.
  titre: titreCourt(projet),
}));
---

<PageLayout
  title="Références — FT2E"
  description="Plus de 150 projets livrés en Charente-Maritime, Vendée et Deux-Sèvres. Logements, tertiaire et ERP, industriel, patrimoine, missions monotechniques."
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Références', href: '/references' },
    ]}
    eyebrow="index des affaires — nomenclature filtrable"
    titre="Nos références"
    sousTitre="Une sélection de projets représentatifs de notre activité en Charente-Maritime, Vendée et Deux-Sèvres."
  />

  <section class="py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      {/* La planche principale de l'écran : la nomenclature entière est un plan posé */}
      <div class="plan-pose p-5 md:p-10" data-plan>
        <div class="border-t border-b border-filet-2 py-3.5 grid grid-cols-1 md:grid-cols-[100px_1fr] gap-4 md:items-center mb-6">
          <p class="mono-label font-normal text-pivot">secteur</p>
          <div class="flex flex-wrap" role="group" aria-label="Filtres par secteur">
            <button
              class="chip-blueprint -ml-px -mt-px cursor-pointer"
              data-filtre="tous"
              aria-pressed="true"
            >
              Tous ({projets.length})
            </button>
            {secteurs.map((s) => {
              const count = projets.filter((p) => p.data.secteur === s).length;
              // Un secteur sans référence publiée n'apparaît pas au filtre :
              // une puce « (0) » qui ne filtre rien annonce une lacune au lieu
              // de servir. Le secteur reste présent sur /secteurs et à l'accueil.
              if (count === 0) return null;
              return (
                <button
                  class="chip-blueprint -ml-px -mt-px cursor-pointer"
                  data-filtre={s}
                  aria-pressed="false"
                >
                  {s} ({count})
                </button>
              );
            })}
          </div>
        </div>

        {/* En-tête de nomenclature */}
        <div
          class="hidden lg:grid lg:grid-cols-[160px_1fr_150px_88px] xl:grid-cols-[220px_1fr_150px_88px] gap-4 items-end pb-3 pl-4 border-b border-filet-1"
          aria-hidden="true"
        >
          <p class="mono-label font-normal text-[10px] text-pivot">vue</p>
          <p class="mono-label font-normal text-[10px] text-pivot">affaire</p>
          <p class="mono-label font-normal text-[10px] text-pivot">secteur</p>
          <p class="mono-label font-normal text-[10px] text-pivot">statut</p>
        </div>

        <ul role="list" data-grille>
          {lignes.map(({ projet, rang, titre }) => (
            <li data-secteur={projet.data.secteur}>
              <a
                href={`/references/${projet.id}`}
                class:list={[
                  'grid grid-cols-1 md:grid-cols-[160px_1fr] lg:grid-cols-[160px_1fr_150px_88px] xl:grid-cols-[220px_1fr_150px_88px] gap-x-4 gap-y-1 items-center',
                  'py-3.5 pl-4 pr-2 border-b border-l border-b-filet-2',
                  rang.filet,
                  'hover:bg-calcaire transition-colors duration-300 ease-[var(--ease-blueprint)]',
                ]}
              >
                {/* La miniature de nomenclature est décorative — `aria-hidden`,
                    masquée sous md : la charte veut ici une liste tabulaire, pas
                    une grille de cartes, et sous 768 px la vignette occuperait la
                    largeur entière en repoussant les titres hors de l'écran.

                    Sa colonne CROÎT avec le palier (2026-08-15), la place ayant
                    été libérée par le passage au titre court : 96 px à md, 160 à
                    lg, 220 à xl. Deux mesures bornent ces valeurs, l'une en
                    largeur, l'autre en hauteur.

                    En LARGEUR, le titre le plus long réclame 381 px : la colonne
                    de titre ne descend pas sous cette cote là où elle peut la
                    tenir (622 px restants à xl, 506 à lg). À md elle tombe à
                    314 et le `md:truncate` reprend son office — c'était déjà le
                    cas avant, à 354.

                    En HAUTEUR, une vignette 3:2 convertit toute largeur gagnée
                    en défilement : 220 px font une ligne de 176 et une liste de
                    4 040 px, contre 1 528 à l'origine. C'est ce qui a écarté la
                    taille de CONCEPTION (280 px, mono à 8,4) : elle porte la
                    ligne à 216 px et la liste à 4 960 pour un gain de lecture
                    marginal — à 220 le mono se rend à 6,6 px et les valeurs du
                    dessin (« 146 845 kWh/an », « 38 000 m³/h ») se lisent déjà.
                    Comparé au rendu, pas supposé. */}
                <span class="hidden md:block aspect-[3/2] overflow-hidden bg-papier border border-filet-3" aria-hidden="true">
                  <PlancheReference src={projet.data.planche} variante="vignette" />
                </span>
                <span class="min-w-0">
                  {/* `lg:truncate` : la coupe à l'ellipse ne sert que la LIGNE DE
                      TABLEAU, où le titre partage sa ligne avec le secteur et le
                      statut — donc à partir de lg seulement. En deçà, la ligne n'a
                      que deux colonnes (ou une), rien n'y impose une ligne unique,
                      et le titre s'y déplie sur deux lignes au besoin. */}
                  <span class:list={['type-intitule block text-[16px] md:text-[17px] lg:truncate text-encre', rang.graisse]}>
                    {titre}
                  </span>
                  <span class="lg:hidden mono-data text-[11px] text-pivot block mt-0.5">
                    {projet.data.secteur} · {rang.statut}
                    {projet.data.demo && <span class="mono-label font-normal text-[10px]"> [démo]</span>}
                  </span>
                </span>
                <span class="hidden lg:block text-sm text-pivot">
                  {projet.data.secteur}
                  {projet.data.demo && <span class="mono-label font-normal text-[10px] block">[démo]</span>}
                </span>
                <span class="hidden lg:block mono-label font-normal text-[10px] text-pivot">{rang.statut}</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="flex flex-col md:flex-row md:justify-between gap-2 mt-5">
          <p class="mono-label font-normal text-pivot">rang&nbsp;: opacité du filet — livré 22&nbsp;% · en cours 16&nbsp;% · archive 12&nbsp;%</p>
          <p class="mono-data text-pivot" data-compteur data-total={projets.length} aria-live="polite">
            {projets.length} lignes sur {projets.length}
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaFinal />
</PageLayout>

<script>
  function initFiltres() {
    const grille = document.querySelector<HTMLElement>('[data-grille]');
    if (!grille) return;
    if (grille.dataset.filtresBound) return;
    grille.dataset.filtresBound = '1';

    const filtres = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
    const rangees = document.querySelectorAll<HTMLElement>('[data-secteur]');
    const compteur = document.querySelector<HTMLElement>('[data-compteur]');
    const total = compteur?.dataset.total ?? String(rangees.length);

    // Le filtre réduit la liste, sans transition d'apparition (charte v3).
    const appliquer = (secteur: string | null) => {
      let visible = 0;
      rangees.forEach((ligne) => {
        const match = secteur === 'tous' || ligne.getAttribute('data-secteur') === secteur;
        ligne.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (compteur) compteur.textContent = `${visible} ligne${visible > 1 ? 's' : ''} sur ${total}`;
    };

    filtres.forEach((btn) => {
      btn.addEventListener('click', () => {
        filtres.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        appliquer(btn.getAttribute('data-filtre'));
      });
    });
  }

  document.addEventListener('astro:page-load', initFiltres);
</script>
