---
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import FicheTechnique from '../../components/blocs/FicheTechnique.astro';
import ProjetsSimilaires from '../../components/blocs/ProjetsSimilaires.astro';
import CoinsCuivre from '../../components/primitives/CoinsCuivre.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';
import JsonLd from '../../components/seo/JsonLd.astro';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({
    params: { slug: projet.id },
    props: { projet },
  }));
}

const { projet } = Astro.props;
const { titre, secteur, lieu, annee, performance, image_principale, image_principale_alt, demo } = projet.data;
const { Content } = await render(projet);

const imageExiste = fs.existsSync(path.join(process.cwd(), 'public', image_principale));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: titre,
  dateCreated: String(annee),
  locationCreated: {
    '@type': 'Place',
    name: lieu,
  },
  about: projet.data.secteur,
  keywords: projet.data.mission_ft2e.join(', '),
};
---

<PageLayout
  title={`${titre} — Référence FT2E`}
  description={`${titre} — ${projet.data.secteur}, ${lieu}. Mission FT2E : ${projet.data.mission_ft2e.join(', ')}.`}
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Références', href: '/references' },
      { label: titre, href: `/references/${projet.id}` },
    ]}
    eyebrow={`fiche d’affaire — ${secteur.toLowerCase()} — FT2E—${annee}`}
    titre={titre}
    sousTitre={`${lieu} · ${annee}`}
  />

  <section class="bg-papier py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7">
          <div class:list={['relative w-full aspect-[3/2] mb-10', imageExiste ? 'duotone-photo' : 'duotone-media']}>
            {imageExiste && (
              <img
                src={image_principale}
                alt={image_principale_alt}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            )}
            <CoinsCuivre taille={16} />
            <span class="absolute left-[12.5%] bottom-4 mono-label font-normal text-voile z-10" aria-hidden="true">
              {demo ? '[démo] ' : ''}{titre.toLowerCase()} — {lieu.toLowerCase()}
            </span>
          </div>

          <p class="mono-label font-normal text-pivot pb-2.5 border-b-2 border-encre">mission</p>

          <div
            class="mt-6 text-[15px] text-pivot leading-[1.65] space-y-6
                   [&>h2]:type-h2 [&>h2]:text-encre [&>h2]:text-[20px] [&>h2]:filet-top
                   [&>h2]:mt-9 [&>h2]:mb-3.5
                   [&>h2:first-child]:mt-0
                   [&>h3]:type-h2 [&>h3]:text-encre [&>h3]:text-[17px] [&>h3]:mt-8 [&>h3]:mb-3
                   [&>ul]:list-none [&>ul]:pl-0 [&>ul]:space-y-2
                   [&>ul>li]:border-l [&>ul>li]:border-line-strong [&>ul>li]:pl-4
                   [&_a]:text-encre [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-pivot
                   [&_strong]:text-encre [&_strong]:font-semibold"
          >
            <Content />
          </div>
        </div>

        <div class="lg:col-span-5">
          <FicheTechnique projet={projet} />

          {/* La seule réserve profonde de l'écran : les relevés mesurés (charte v2) */}
          {performance && (
            <div class="mt-6 bg-profond px-5 py-6">
              <p class="mono-label font-normal text-[10px] text-clair mb-4">performance{demo ? ' — [démo]' : ''}</p>
              <p
                class="font-heading font-semibold text-[26px] leading-[1.15] text-voile tabular-nums"
                style="font-stretch: 118%; letter-spacing: -0.02em;"
              >
                {performance}
              </p>
            </div>
          )}

          {demo && (
            <div class="mt-6 border border-line bg-calcaire px-4 py-3.5">
              <p class="mono-label text-pivot">contenu de démonstration</p>
              <p class="mt-2 text-[15px] text-pivot leading-[1.55]">
                Données de démonstration plausibles, à confirmer par FT2E en phase de production.
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <ProjetsSimilaires projetActuel={projet} />

  <CtaFinal titre={"Un projet similaire ?"} texte="Discutons de votre programme — nous identifierons les lots techniques à mobiliser." />

  <Fragment slot="json-ld">
    <JsonLd data={jsonLd} />
  </Fragment>
</PageLayout>
