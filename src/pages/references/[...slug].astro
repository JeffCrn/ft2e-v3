---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import FicheTechnique from '../../components/blocs/FicheTechnique.astro';
import SyntheseAffaire from '../../components/blocs/SyntheseAffaire.astro';
import RecitAffaire from '../../components/blocs/RecitAffaire.astro';
import ProjetsSimilaires from '../../components/blocs/ProjetsSimilaires.astro';
import PlancheReference from '../../components/blocs/PlancheReference.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { commune, libelleChronologie } from '../../lib/projets';
import { SITE_NAME, SITE_URL } from '../../lib/constants';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({
    params: { slug: projet.id },
    props: { projet },
  }));
}

const { projet } = Astro.props;
const { titre, ouvrage, secteur, lieu, annee, annee_livraison, reference, synthese, performance, planche, demo } = projet.data;
const { Content } = await render(projet);

// Chronologie publique (ADR-003) — `annee` et `reference` ne servent plus
// qu'au tri et au JSON-LD ci-dessous : ils ne sont plus affichés.
const jalons = libelleChronologie(projet);

// Nom court d'ouvrage et commune — les deux servent les métadonnées SEO
// ci-dessous et le sous-titre de la fiche.
//
// Le nom d'ouvrage vient du champ `ouvrage` quand la fiche le porte. À
// défaut, on retombe sur le premier segment du `titre` : ça dépanne quand
// le titre s'ouvre sur un nom propre, ça ne donne rien quand il n'en a pas
// — d'où le champ. Une fiche sans nom court reste publiable.
//
// `lieu` va de la commune seule à l'adresse complète : `commune()` en extrait
// le segment qui porte le code postal — l'unique implémentation, et c'est
// aussi elle qui compose la localisation affichée en sous-titre.
//
// ⚠ Une `legendeMedia` (« ouvrage · ville · surface ») se composait ici pour le
// cartouche de réserve de l'amendement A8. Elle a cessé d'être lue le
// 2026-08-15, quand la planche a remplacé le visuel photographique : une
// planche ne porte ni duotone, ni équerres, ni cartouche de légende — elle est
// déjà composée dans les jetons. Le calcul, lui, a survécu au nettoyage de
// clôture, et se refaisait sur chacune des 23 fiches à chaque build.
const nomOuvrage = ouvrage ?? titre.split(/\s*[:—]\s*|,\s/)[0].replace(/^[«»\s]+|[«»\s]+$/g, '');
const { ville, libelle: localisation } = commune(lieu);

// Métadonnées SEO (fin de chantier § 2.3) : composées sur le nom court
// d'ouvrage et la ville, jamais sur le `titre` descriptif — Zod l'admet
// jusqu'à 80 signes, aucun calibre de <title> n'y résiste. La ville s'omet
// quand le nom la porte déjà (« Abbaye de Sablonceaux ») ; l'article de la
// commune ne compte pas dans ce rapprochement (« au Bois-Plage-en-Ré »).
const villeNue = ville.replace(/^(le|la|les|l’|l')\s*/i, '');
const titrePage = `${
  nomOuvrage.toLowerCase().includes(villeNue.toLowerCase()) ? nomOuvrage : `${nomOuvrage}, ${ville}`
} — référence FT2E`;

// La description vise 160 signes au plus : titre, ville si le titre ne la
// porte pas, puis autant de missions que le calibre en accepte — au moins
// une, les premières du frontmatter étant les principales.
const villeDansTitre = titre.toLowerCase().includes(villeNue.toLowerCase());
const debutDescription = `${titre}${villeDansTitre ? '' : ` (${ville})`}. Mission FT2E : `;
const missionsRetenues: string[] = [];
for (const mission of projet.data.mission_ft2e) {
  const essai = [...missionsRetenues, mission].join(', ');
  if (debutDescription.length + essai.length + 1 > 160) break;
  missionsRetenues.push(mission);
}
if (missionsRetenues.length === 0) missionsRetenues.push(projet.data.mission_ft2e[0]);
const descriptionPage = `${debutDescription}${missionsRetenues.join(', ')}.`;

// `creator` rattache l'affaire au bureau par la même URL que le
// `ProfessionalService` de l'accueil : c'est ce qui fait de ces 23 fiches un
// portefeuille attribué, et non 23 œuvres sans auteur. `url` et `abstract`
// donnent aux moteurs génératifs de quoi citer la fiche sans la deviner.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: titre,
  ...(reference ? { identifier: reference } : {}),
  url: `${SITE_URL}/references/${projet.id}`,
  ...(synthese ? { abstract: synthese } : {}),
  dateCreated: String(annee),
  ...(annee_livraison ? { temporalCoverage: `${annee}/${annee_livraison}` } : {}),
  creator: {
    '@type': 'ProfessionalService',
    name: SITE_NAME,
    url: SITE_URL,
  },
  locationCreated: {
    '@type': 'Place',
    name: lieu,
  },
  about: projet.data.secteur,
  keywords: projet.data.mission_ft2e.join(', '),
};
---

<PageLayout
  title={titrePage}
  description={descriptionPage}
  ogImage={planche ? planche.replace(/\.svg$/, '.png') : undefined}
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Références', href: '/references' },
      { label: titre, href: `/references/${projet.id}` },
    ]}
    eyebrow={`fiche d’affaire — ${secteur.toLowerCase()}`}
    titre={titre}
    sousTitre={`${localisation} · ${jalons}`}
  />

  {/* La planche ouvre la fiche, sur toute la largeur du conteneur.
      Elle n'entre pas dans la colonne de gauche : celle-ci fait 581 px, où le
      mono de 10 px du dessin se rendrait à 3,9 px. Composée dans un repère de
      1200, elle se rend ici à 1152 — échelle 0,96 — et ses corps sont, à 4 %
      près, ceux de la charte. Elle ne prend ni duotone ni équerres : ces deux
      traitements appartiennent à la photographie, et la planche est déjà
      composée dans les jetons. */}
  <section class="pt-12 md:pt-14">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <PlancheReference src={planche} id={`planche-${projet.id}`} />
    </div>
  </section>

  <section class="py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        {/* La planche principale de l'écran : image d'appui et récit sur un plan posé */}
        <div class="lg:col-span-7 plan-pose p-5 md:p-8" data-plan>

          {/* Ordre de lecture verticale sur petit écran, arrêté le 2026-08-09
              après comparaison sur téléphone :
                1. le cartouche de données      (ci-dessous, lg:hidden)
                2. le relevé de performance     (ci-dessous, lg:hidden)
                3. la synthèse rédactionnelle
                4. le récit détaillé, replié
              Les données et le chiffre que la fiche défend arrivent d'abord ;
              la prose vient ensuite, d'un seul tenant — synthèse puis récit,
              sans cartouche intercalé entre les deux.

              Sur desktop cet ordre est sans effet : le cartouche et le relevé
              sont dans la colonne de droite, et la colonne de gauche lit
              image → synthèse → barre → récit dans les deux cas. */}

          {/* Sur petit écran, le cartouche technique ouvre la colonne ; la
              colonne de droite prend le relais dès lg.
              display:none retire l'instance inactive de l'arbre d'accessibilité. */}
          <div class="lg:hidden mb-8">
            <FicheTechnique projet={projet} />
          </div>

          {/* Copie mobile du relevé encré. Sur petit écran la colonne de
              droite bascule sous le récit, et la performance — ce que la fiche
              défend — se retrouvait après plusieurs écrans de texte. Même
              motif que la FicheTechnique ci-dessus : une seule des deux
              instances est rendue à la fois, `display:none` retirant l'autre
              de l'arbre d'accessibilité. La règle « une seule réserve profonde
              par écran » reste donc tenue. */}
          {performance && (
            <div class="plan-encre lg:hidden mb-8 px-6 py-7" data-plan>
              <p class="mono-label font-normal text-[10px] text-clair mb-4">performance{demo ? ' — [démo]' : ''}</p>
              <p class="releve-chiffre text-voile text-[24px] md:text-[28px] leading-[1.2] tracking-[-0.02em]">
                {performance}
              </p>
            </div>
          )}

          {/* 3. La synthèse rédactionnelle, après les données. */}
          {synthese && <SyntheseAffaire texte={synthese} />}

          {/* 4. La barre de dépliement marque la frontière entre les deux
              textes : la synthèse se lit toujours, le récit se demande. Elle
              se pose donc entre eux, et non au-dessus de la synthèse — sans
              quoi elle masquerait par défaut le seul texte que la fiche
              donne à lire d'emblée.

              (Son ancienne justification — éviter de repousser le relevé de
              performance au dépliement — est caduque depuis que le relevé
              est remonté au-dessus de la synthèse. Le placement, lui, ne
              change pas.)

              Sans synthèse, `depliable={false}` rend le récit tel qu'avant. */}
          <RecitAffaire depliable={Boolean(synthese)}>
            <Content />
          </RecitAffaire>
        </div>

        <div class="lg:col-span-5">
          <div class="hidden lg:block">
            <FicheTechnique projet={projet} />
          </div>

          {/* La seule réserve profonde de l'écran : la ligne encrée des relevés
              (charte v3 — plan rang 3, filet 3 px clair à gauche, ombre rang 3).
              Jamais de vert FT2E en texte sur ce fond. */}
          {performance && (
            <div class="plan-encre hidden lg:block mt-6 px-6 py-7" data-plan>
              <p class="mono-label font-normal text-[10px] text-clair mb-4">performance{demo ? ' — [démo]' : ''}</p>
              <p class="releve-chiffre text-voile text-[24px] md:text-[28px] leading-[1.2] tracking-[-0.02em]">
                {performance}
              </p>
            </div>
          )}

          {demo && (
            <div class="mt-6 border border-filet-2 bg-calcaire px-4 py-3.5">
              <p class="mono-label text-pivot">contenu de démonstration</p>
              <p class="mt-2 text-[15px] text-pivot leading-[1.55]">
                Données de démonstration plausibles, à confirmer par FT2E en phase de production.
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <ProjetsSimilaires projetActuel={projet} />

  <CtaFinal titre={"Un projet similaire ?"} texte="Discutons de votre programme — nous identifierons les lots techniques à mobiliser." />

  <Fragment slot="json-ld">
    <JsonLd data={jsonLd} />
  </Fragment>
</PageLayout>
