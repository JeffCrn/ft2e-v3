---
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import FicheTechnique from '../../components/blocs/FicheTechnique.astro';
import ProjetsSimilaires from '../../components/blocs/ProjetsSimilaires.astro';
import CoinsCuivre from '../../components/primitives/CoinsCuivre.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';
import JsonLd from '../../components/seo/JsonLd.astro';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({
    params: { slug: projet.id },
    props: { projet },
  }));
}

const { projet } = Astro.props;
const { titre, secteur, lieu, annee, image_principale, image_principale_alt, demo } = projet.data;
const { Content } = await render(projet);

const imageExiste = fs.existsSync(path.join(process.cwd(), 'public', image_principale));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: titre,
  dateCreated: String(annee),
  locationCreated: {
    '@type': 'Place',
    name: lieu,
  },
  about: projet.data.secteur,
  keywords: projet.data.mission_ft2e.join(', '),
};
---

<PageLayout
  title={`${titre} — Référence FT2E`}
  description={`${titre} — ${projet.data.secteur}, ${lieu}. Mission FT2E : ${projet.data.mission_ft2e.join(', ')}.`}
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Références', href: '/references' },
      { label: titre, href: `/references/${projet.id}` },
    ]}
    eyebrow={`fiche projet — ${secteur.toLowerCase()} — FT2E—${annee}`}
    titre={titre}
    sousTitre={`${lieu} · ${annee}`}
  />

  <section class="bg-cool-white py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7">
          <div class="relative mb-10" data-reveal>
            <div class:list={['w-full aspect-[16/9]', imageExiste ? 'duotone-photo' : 'duotone-media']}>
              {imageExiste && (
                <img
                  src={image_principale}
                  alt={image_principale_alt}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              )}
              <span class="absolute left-4 bottom-3 mono-label font-normal text-cool-white z-10" aria-hidden="true">
                {demo ? '[démo] ' : ''}{titre.toLowerCase()} — {lieu.toLowerCase()}
              </span>
            </div>
            <CoinsCuivre />
          </div>

          <div
            class="text-[17px] font-light text-slate leading-[1.6] space-y-6
                   [&>h2]:type-h2 [&>h2]:text-marine [&>h2]:text-[20px] [&>h2]:filet-top
                   [&>h2]:mt-9 [&>h2]:mb-3.5
                   [&>h2:first-child]:mt-0
                   [&>h3]:type-h2 [&>h3]:text-marine [&>h3]:text-[17px] [&>h3]:mt-8 [&>h3]:mb-3
                   [&>ul]:list-none [&>ul]:pl-0 [&>ul]:space-y-2
                   [&>ul>li]:border-l [&>ul>li]:border-copper [&>ul>li]:pl-4
                   [&_a]:text-marine [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-copper
                   [&_strong]:text-marine [&_strong]:font-semibold"
            data-reveal
          >
            <Content />
          </div>
        </div>

        <div class="lg:col-span-5" data-reveal>
          <FicheTechnique projet={projet} />
          {demo && (
            <div class="mt-6 border border-line bg-paper px-4 py-3.5">
              <p class="mono-label text-copper">contenu de démonstration</p>
              <p class="mt-2 text-[15px] font-light text-slate leading-[1.55]">
                Données de démonstration plausibles, à confirmer par FT2E en phase de production.
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <ProjetsSimilaires projetActuel={projet} />

  <CtaFinal titre={"Un projet similaire ?"} texte="Discutons de votre programme — nous identifierons les lots techniques à mobiliser." />

  <Fragment slot="json-ld">
    <JsonLd data={jsonLd} />
  </Fragment>
</PageLayout>
