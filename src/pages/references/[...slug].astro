---
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import FicheTechnique from '../../components/blocs/FicheTechnique.astro';
import SyntheseAffaire from '../../components/blocs/SyntheseAffaire.astro';
import RecitAffaire from '../../components/blocs/RecitAffaire.astro';
import ProjetsSimilaires from '../../components/blocs/ProjetsSimilaires.astro';
import CoinsCuivre from '../../components/primitives/CoinsCuivre.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { libelleChronologie } from '../../lib/projets';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({
    params: { slug: projet.id },
    props: { projet },
  }));
}

const { projet } = Astro.props;
const { titre, secteur, lieu, surface_m2, annee, annee_livraison, reference, synthese, performance, image_principale, image_principale_alt, demo } = projet.data;
const { Content } = await render(projet);

const imageExiste = fs.existsSync(path.join(process.cwd(), 'public', image_principale));

// Chronologie publique (ADR-003) — `annee` et `reference` ne servent plus
// qu'au tri et au JSON-LD ci-dessous : ils ne sont plus affichés.
const jalons = libelleChronologie(projet);

// Légende de média (amendement A8) : le cartouche de réserve porte
// « ouvrage · ville · surface », et non le titre entier — reprendre le h1
// n'était pas la spécification, et c'est ce qui le faisait déborder.
// `titre` est une phrase descriptive : l'ouvrage est son premier segment.
// `lieu` va de la commune seule à l'adresse complète : la ville est le
// segment qui porte le code postal, que la légende n'affiche pas.
const ouvrage = titre.split(/\s*[:—]\s*|,\s/)[0].replace(/^[«»\s]+|[«»\s]+$/g, '');
const ville = (lieu.match(/([^,]+?)\s*\(\d{5}\)/)?.[1] ?? lieu).trim();
const legendeMedia = [ouvrage, ville, surface_m2 ? `${surface_m2} m²` : null]
  .filter(Boolean)
  .join(' · ')
  .toLowerCase();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: titre,
  ...(reference ? { identifier: reference } : {}),
  dateCreated: String(annee),
  ...(annee_livraison ? { temporalCoverage: `${annee}/${annee_livraison}` } : {}),
  locationCreated: {
    '@type': 'Place',
    name: lieu,
  },
  about: projet.data.secteur,
  keywords: projet.data.mission_ft2e.join(', '),
};
---

<PageLayout
  title={`${titre} — Référence FT2E`}
  description={`${titre} — ${projet.data.secteur}, ${lieu}. Mission FT2E : ${projet.data.mission_ft2e.join(', ')}.`}
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Références', href: '/references' },
      { label: titre, href: `/references/${projet.id}` },
    ]}
    eyebrow={`fiche d’affaire — ${secteur.toLowerCase()}`}
    titre={titre}
    sousTitre={`${lieu} · ${jalons}`}
  />

  <section class="py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        {/* La planche principale de l'écran : image d'appui et récit sur un plan posé */}
        <div class="lg:col-span-7 plan-pose p-5 md:p-8" data-plan>
          <div class:list={['relative w-full aspect-[3/2] mb-10', imageExiste ? 'duotone-photo' : 'duotone-media']}>
            {imageExiste && (
              <img
                src={image_principale}
                alt={image_principale_alt}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            )}
            <CoinsCuivre taille={16} />
            {/* Cartouche de réserve (A8), visible aux deux breakpoints : la
                légende est corrigée, pas masquée. Le géométrie de pose vient
                de `.legende-media`, dérivée des équerres — ne pas la déplacer
                par des retraits en dur. */}
            <span class="cartouche-legende legende-media z-10" aria-hidden="true">
              {demo ? '[démo] ' : ''}{legendeMedia}
            </span>
          </div>

          {/* La synthèse précède le cartouche technique (variante retenue le
              2026-08-09) : sur mobile, le lecteur reçoit d'abord le texte qui
              dit de quoi il s'agit, puis les cotes. Sur desktop rien ne bouge,
              la FicheTechnique étant dans la colonne de droite. */}
          {synthese && <SyntheseAffaire texte={synthese} />}

          {/* Sur petit écran, le cartouche technique s'intercale entre la
              synthèse et le récit ; la colonne de droite prend le relais dès lg.
              display:none retire l'instance inactive de l'arbre d'accessibilité. */}
          <div class="lg:hidden mb-8">
            <FicheTechnique projet={projet} />
          </div>

          {/* Copie mobile du relevé encré. Sur petit écran la colonne de
              droite bascule sous le récit, et la performance — ce que la fiche
              défend — se retrouvait après plusieurs écrans de texte. Même
              motif que la FicheTechnique ci-dessus : une seule des deux
              instances est rendue à la fois, `display:none` retirant l'autre
              de l'arbre d'accessibilité. La règle « une seule réserve profonde
              par écran » reste donc tenue. */}
          {performance && (
            <div class="plan-encre lg:hidden mb-8 px-6 py-7" data-plan>
              <p class="mono-label font-normal text-[10px] text-clair mb-4">performance{demo ? ' — [démo]' : ''}</p>
              <p class="releve-chiffre text-voile text-[24px] md:text-[28px] leading-[1.2] tracking-[-0.02em]">
                {performance}
              </p>
            </div>
          )}

          {/* La barre de dépliement se pose juste avant le récit, et non
              soudée à la synthèse : sur mobile, soudée, elle repousserait le
              relevé de performance hors de l'écran à chaque dépliement. Sans
              synthèse, `depliable={false}` rend le récit tel qu'avant. */}
          <RecitAffaire depliable={Boolean(synthese)}>
            <Content />
          </RecitAffaire>
        </div>

        <div class="lg:col-span-5">
          <div class="hidden lg:block">
            <FicheTechnique projet={projet} />
          </div>

          {/* La seule réserve profonde de l'écran : la ligne encrée des relevés
              (charte v3 — plan rang 3, filet 3 px clair à gauche, ombre rang 3).
              Jamais de vert FT2E en texte sur ce fond. */}
          {performance && (
            <div class="plan-encre hidden lg:block mt-6 px-6 py-7" data-plan>
              <p class="mono-label font-normal text-[10px] text-clair mb-4">performance{demo ? ' — [démo]' : ''}</p>
              <p class="releve-chiffre text-voile text-[24px] md:text-[28px] leading-[1.2] tracking-[-0.02em]">
                {performance}
              </p>
            </div>
          )}

          {demo && (
            <div class="mt-6 border border-filet-2 bg-calcaire px-4 py-3.5">
              <p class="mono-label text-pivot">contenu de démonstration</p>
              <p class="mt-2 text-[15px] text-pivot leading-[1.55]">
                Données de démonstration plausibles, à confirmer par FT2E en phase de production.
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <ProjetsSimilaires projetActuel={projet} />

  <CtaFinal titre={"Un projet similaire ?"} texte="Discutons de votre programme — nous identifierons les lots techniques à mobiliser." />

  <Fragment slot="json-ld">
    <JsonLd data={jsonLd} />
  </Fragment>
</PageLayout>
