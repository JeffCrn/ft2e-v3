---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/blocs/Hero.astro';
import ChiffresCles from '../components/blocs/ChiffresCles.astro';
import AcronymeFT2E from '../components/blocs/AcronymeFT2E.astro';
import CartesExpertises from '../components/blocs/CartesExpertises.astro';
import SecteursPhares from '../components/blocs/SecteursPhares.astro';
import ReferencesRecentes from '../components/blocs/ReferencesRecentes.astro';
import EquipePreview from '../components/blocs/EquipePreview.astro';
import BandeauPartenaires from '../components/blocs/BandeauPartenaires.astro';
import CtaFinal from '../components/blocs/CtaFinal.astro';
import TraceFlux from '../components/primitives/TraceFlux.astro';
---

<PageLayout
  title="FT2E — Bureau d’études techniques, La Rochelle"
  description="Bureau d’études fluides, thermique, électricité, SSI, BIM à La Rochelle. Au service des architectes et MOA depuis 2008."
>
  <Hero
    variante="accueil"
    eyebrow="la rochelle — depuis 2008 — 7 personnes"
    titre={"L’ingénierie technique\\ndu bâtiment atlantique"}
    sousTitre="Bureau d’études pluridisciplinaire à La Rochelle. Fluides, thermique, électricité, sécurité incendie, BIM. Au service des architectes, maîtres d’ouvrage publics et promoteurs depuis 2008."
    ctaPrincipal={{ label: 'Parlons de votre projet', href: '/contact' }}
    ctaSecondaire={{ label: 'Nos références', href: '/references' }}
  />

  {/* Zone claire « câblée » : le tracé de flux cuivre longe la colonne de
      contenu et se dessine au défilement (marges larges uniquement). */}
  <div class="relative">
    <div
      class="hidden min-[1360px]:block absolute inset-y-0 left-1/2 -translate-x-1/2 w-full max-w-[1200px] pointer-events-none"
      aria-hidden="true"
    >
      <TraceFlux class="absolute top-10 bottom-10 -left-14 w-10" />
    </div>

    {/* Chaque grande section est un jalon : les nœuds du tracé se posent
        exactement sur les frontières entre jalons consécutifs. */}
    <div data-trace-jalon><ChiffresCles /></div>

    <div data-trace-jalon><AcronymeFT2E /></div>

    <div data-trace-jalon><CartesExpertises /></div>

    <div data-trace-jalon><SecteursPhares /></div>

    <div data-trace-jalon><ReferencesRecentes /></div>

    <div data-trace-jalon><EquipePreview /></div>
  </div>

  <BandeauPartenaires />

  <CtaFinal />
</PageLayout>
