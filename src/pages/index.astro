---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/blocs/Hero.astro';
import CarteExpertise from '../components/blocs/CarteExpertise.astro';
import CarteProjet from '../components/blocs/CarteProjet.astro';
import Bouton from '../components/primitives/Bouton.astro';
import CtaFinal from '../components/blocs/CtaFinal.astro';
import CoinsCuivre from '../components/primitives/CoinsCuivre.astro';
import { Picture } from 'astro:assets';
import { CHIFFRES_CLES } from '../lib/constants';
import { commune, parAffaireDecroissante, libelleChronologie, titreCourt } from '../lib/projets';
import { photoEquipe, CHEMIN_COLLECTIF } from '../lib/photos';

// Média du hero (écran 1 de la charte) : l'image recule dans sa colonne,
// elle ne porte pas le titre. Projet mis en avant le plus récent.
const enAvant = (await getCollection('projets'))
  .filter((p) => p.data.en_avant)
  .sort(parAffaireDecroissante)[0];

// Fiche vedette illustrée par une planche : le hero rend son APPUI —
// une troisième composition (552 x 368), dessinée pour la largeur où la
// colonne média la lit. La planche entière (1200) y tomberait à l'échelle
// 0,48 (mono de 10 px rendu à 4,8) et la vignette (300) grossie à 1,84
// épaissirait tous les filets de 1 px : ni l'une ni l'autre ne se transpose —
// même arithmétique que le protocole des planches, appliquée au hero.
// L'appui est inliné (il hérite des polices et des jetons de la page) et ne
// reçoit NI duotone NI équerres : ces deux traitements appartiennent à la
// photographie, et l'appui porte déjà son surtitre.
const heroAppui = enAvant?.data.planche
  ? fs.readFileSync(
      path.join(process.cwd(), 'public',
        enAvant.data.planche.replace(/planche\.svg$/, 'appui.svg')),
      'utf-8',
    )
  : null;

// Relevé clair : étiquette mono + chiffre, un seul chiffre plein par
// relevé — celui que la page défend (17 ans, depuis 2008).
const releves = CHIFFRES_CLES.map((c, i) => ({
  chiffre: `${'prefixe' in c ? c.prefixe : ''}${c.valeur.toLocaleString('fr-FR')}`,
  etiquette: [c.suffixe, c.label].filter(Boolean).join(' '),
  plein: i === 0,
  demo: c.demo,
}));

// L'acronyme déployé — quatre lettres, quatre champs d'ingénierie.
const acronyme = [
  { lettre: 'F', mot: 'Fluide', detail: 'CVC · plomberie · traitement d’air' },
  { lettre: 'T', mot: 'Thermique', detail: 'RE2020 · STD · audit énergétique' },
  { lettre: 'E', mot: 'Énergie', detail: 'EnR · photovoltaïque · FAE' },
  { lettre: 'E', mot: 'Électricité', detail: 'CFO/CFA · SSI · IRVE' },
];

const expertises = (await getCollection('expertises')).sort((a, b) => a.data.ordre - b.data.ordre);

const secteurs = (await getCollection('secteurs'))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .map((s) => ({
    ...s,
    numero: String(s.data.ordre).padStart(2, '0'),
  }));

// Grille « références récentes » : les fiches mises en avant d'abord, puis
// les plus récentes pour atteindre quatre. `en_avant` reste maître du média
// du hero (ci-dessus) mais ne conditionne plus le remplissage de la grille :
// une grille à quatre colonnes ne doit pas tomber à une carte parce que le
// corpus mis en avant a maigri.
const tousProjets = (await getCollection('projets')).sort(parAffaireDecroissante);
const projetsRecents = [
  ...tousProjets.filter((p) => p.data.en_avant),
  ...tousProjets.filter((p) => !p.data.en_avant),
].slice(0, 4);

const collectif = photoEquipe(CHEMIN_COLLECTIF);

// Maîtres d'ouvrage et clients réels cités dans la plaquette FT2E 2024
// (docs/20-source-plaquette-2024.md) — données vérifiées, pas de badge démo.
const partenaires = [
  'Fountaine Pajot',
  'Clairsienne',
  'Compagnie Vendéenne du Logement',
  'Dufour',
  'Catana Group',
  'Carl Zeiss Meditec',
  'Altarea',
  'Port de Plaisance de La Rochelle',
  'Groupe hospitalier La Rochelle-Ré-Aunis',
];
---

<PageLayout
  title="FT2E — Bureau d’études techniques, La Rochelle"
  description="Bureau d’études fluides, thermique, électricité, SSI, BIM à La Rochelle. Au service des architectes et MOA depuis 2008."
>
  {/* La seule vedette de la page (charte v3 : une vedette par page, accueil uniquement). */}
  <Hero
    variante="accueil"
    eyebrow="la rochelle — depuis 2008 — 7 personnes"
    titre={"L’ingénierie technique\\ndu bâtiment atlantique"}
    sousTitre="Bureau d’études pluridisciplinaire — fluides, thermique, électricité, sécurité incendie, BIM. Au service des architectes, des maîtres d’ouvrage publics et des promoteurs."
    ctaPrincipal={{ label: 'Parlons de votre projet', href: '/contact' }}
    ctaSecondaire={{ label: 'Nos références', href: '/references' }}
  >
    {enAvant && (
      <Fragment slot="media">
        {/* Sous `sm`, la vedette n'affiche AUCUN média : l'appui (composé pour
            ~552 px) y tomberait à l'échelle 0,62 — mono de 10 rendu à 6,2 px.
            Seule la carte-lien reste, c'est elle qui informe (décision FT2E du
            2026-08-14). La branche photographique a été retirée à la clôture
            du chantier des planches : `planche` est obligatoire au schéma,
            donc une fiche vedette a toujours son appui. */}
        <div class="plan-pose hidden sm:block" set:html={heroAppui} />
        {/* La carte-lien SUIT son visuel : seule sous le titre, sans le dessin
            qu'elle légende, elle se lit comme un bloc orphelin — on se demande
            ce qu'elle fait là (retour FT2E du 2026-08-14). L'appui étant masqué
            sous `sm`, la carte l'est aussi ; la vedette reste accessible par
            « Nos références ». */}
        <a
          href={`/references/${enAvant.id}`}
          class:list={[
            'hidden sm:flex',
            'flex-wrap items-baseline gap-x-4 gap-y-1 border border-filet-1 bg-calcaire px-4 py-3 transition-colors duration-300 ease-[var(--ease-blueprint)] hover:bg-papier',
          ]}
        >
          <span class="type-intitule text-encre text-[15px]">{titreCourt(enAvant)}</span>
          <span class="mono-data text-[11px] text-pivot ml-auto">{commune(enAvant.data.lieu).libelle} · {libelleChronologie(enAvant)}</span>
        </a>
      </Fragment>
    )}
  </Hero>

  <div class="relative">
    {/* ── 01 · Relevé clair (charte v3 § 10) : un seul chiffre plein ── */}
    <div>
      <section class="py-12 md:py-[76px]">
        <div class="max-w-[1200px] mx-auto px-4 md:px-6">
          <div class="flex items-center gap-3">
            <span class="puce-section" aria-hidden="true"></span>
            <span class="mono-label text-pivot">01 — relevé</span>
          </div>
          <h2 class="type-section text-[26px] mt-4">
            <span class="text-encre">Le bureau en chiffres</span>
            <span class="text-clair" aria-hidden="true">/dernier relevé</span>
          </h2>

          <div class="plan-pose mt-8" data-plan>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-filet-2">
              {releves.map((r) => (
                <div class="bg-papier p-6 flex flex-col">
                  <p class="mono-label text-pivot">— {r.etiquette}</p>
                  {/* ⚠ Borne basse à 1,9 rem et non 2,5. Mesuré à 390 px le
                      2026-08-16 : « +1 686 » fait 148 px dans une colonne
                      utile de 130 (115 à 360 px), et la page défile
                      latéralement. Une seule des quatre valeurs déborde, mais
                      le clamp est commun — les quatre passent donc de 40 à
                      30 px sur téléphone, le « 17 » en encre pleine compris.
                      Arbitrage FT2E du 2026-08-16 : garder les deux colonnes
                      plutôt que la taille des chiffres, l'alternative étant
                      une colonne unique qui allongeait la section de 216 px.
                      Au-delà de 555 px de fenêtre, rien ne change. */}
                  <p
                    class:list={[
                      'releve-chiffre mt-3 text-[clamp(1.9rem,4.5vw,3.75rem)]',
                      r.plein ? 'text-encre' : 'releve-retrait',
                    ]}
                  >
                    {r.chiffre}
                  </p>
                </div>
              ))}
            </div>
          </div>

        </div>
      </section>
    </div>

    {/* ── 02 · L'acronyme déployé + énoncé de méthode en plan qui déborde ── */}
    <div>
      <section class="py-12 md:py-[76px]">
        <div class="max-w-[1200px] mx-auto px-4 md:px-6">
          <div class="flex items-center gap-3">
            <span class="puce-section" aria-hidden="true"></span>
            <span class="mono-label text-pivot">02 — identité</span>
          </div>
          <h2 class="type-section text-[26px] mt-4">
            <span class="text-encre">Quatre lettres</span>
            <span class="text-clair" aria-hidden="true">/quatre champs d’ingénierie</span>
          </h2>

          <div class="plan-pose mt-8" data-plan>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-filet-2">
              {acronyme.map((champ) => (
                <div class="bg-papier p-5 transition-colors duration-300 ease-[var(--ease-blueprint)] hover:bg-calcaire">
                  <p class="font-heading font-bold text-[32px] leading-none text-profond" style="font-stretch: 125%;" aria-hidden="true">{champ.lettre}</p>
                  <h3 class="type-intitule text-encre text-[17px] mt-3">{champ.mot}</h3>
                  <p class="mono-label font-normal text-pivot mt-2 normal-case tracking-[.08em]">{champ.detail}</p>
                </div>
              ))}
            </div>
          </div>

        </div>
      </section>
    </div>

    {/* ── 03 · Quatre expertises ── */}
    <div>
      <section class="py-12 md:py-[76px]">
        <div class="max-w-[1200px] mx-auto px-4 md:px-6">
          <div class="flex items-center gap-3">
            <span class="puce-section" aria-hidden="true"></span>
            <span class="mono-label text-pivot">03 — expertises</span>
          </div>
          <h2 class="type-section text-[26px] mt-4">
            <span class="text-encre">De l’audit à la réception</span>
            <span class="text-clair" aria-hidden="true">/un interlocuteur unique</span>
          </h2>

          <div class="plan-pose mt-8" data-plan>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-filet-2">
              {expertises.map((expertise) => (
                <CarteExpertise expertise={expertise} />
              ))}
            </div>
          </div>
        </div>
      </section>
    </div>

    {/* ── 04 · Sept secteurs d'activité — liste tabulaire sur la trame ── */}
    <div>
      <section class="py-12 md:py-[76px]">
        <div class="max-w-[1200px] mx-auto px-4 md:px-6">
          <div class="flex items-center gap-3">
            <span class="puce-section" aria-hidden="true"></span>
            <span class="mono-label text-pivot">04 — secteurs</span>
          </div>
          <h2 class="type-section text-[26px] mt-4">
            <span class="text-encre">Sept secteurs d’activité</span>
            <span class="text-clair" aria-hidden="true">/centre ouest atlantique</span>
          </h2>

          <ul class="border-t border-filet-1 mt-8" role="list">
            {secteurs.map((secteur) => (
              <li class="border-b border-filet-3 transition-colors duration-300 ease-[var(--ease-blueprint)] hover:bg-calcaire">
                <a
                  href={`/secteurs/${secteur.id}`}
                  class="grid grid-cols-[44px_1fr] md:grid-cols-[44px_200px_1fr] gap-x-6 gap-y-1 py-4 items-baseline"
                >
                  <span class="mono-label font-normal text-pivot tabular-nums" aria-hidden="true">{secteur.numero}</span>
                  <h3 class="type-intitule text-encre text-[19px]">{secteur.data.titre}</h3>
                  <p class="col-start-2 md:col-start-3 text-[15px] text-pivot leading-[1.55]">{secteur.data.accroche}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>

    {/* ── 05 · Références récentes ── */}
    <div>
      <section class="py-12 md:py-[76px]">
        <div class="max-w-[1200px] mx-auto px-4 md:px-6">
          <div class="flex items-center gap-3">
            <span class="puce-section" aria-hidden="true"></span>
            <span class="mono-label text-pivot">05 — références</span>
          </div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mt-4">
            <h2 class="type-section text-[26px]">
              <span class="text-encre">Références récentes</span>
              <span class="text-clair" aria-hidden="true">/quelques exemples</span>
            </h2>
            <a href="/references" class="mono-label font-normal text-pivot hover:text-encre transition-colors duration-[260ms] ease-[var(--ease-blueprint)]">
              voir toutes les références →
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-8">
            {projetsRecents.map((projet) => (
              <CarteProjet projet={projet} />
            ))}
          </div>
        </div>
      </section>
    </div>

    {/* ── 06 · L'équipe en aperçu ── */}
    <div>
      <section class="py-12 md:py-[76px]">
        <div class="max-w-[1200px] mx-auto px-4 md:px-6">
          <div class="flex items-center gap-3">
            <span class="puce-section" aria-hidden="true"></span>
            <span class="mono-label text-pivot">06 — équipe</span>
          </div>
          <h2 class="type-section text-[26px] mt-4">
            <span class="text-encre">Sept profils</span>
            <span class="text-clair" aria-hidden="true">/une responsabilité partagée</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mt-8">
            <div class:list={['relative w-full aspect-[3/2]', collectif ? 'duotone-photo' : 'duotone-media']}>
              {collectif && (
                <Picture
                  src={collectif}
                  formats={['avif', 'webp']}
                  widths={[420, 700, 1024]}
                  sizes="(min-width: 1200px) 552px, (min-width: 768px) calc(50vw - 48px), calc(100vw - 32px)"
                  alt="L’équipe FT2E réunie dans ses locaux à La Rochelle"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              )}
              <CoinsCuivre taille={18} />
              <span class="cartouche-legende legende-media z-10" aria-hidden="true">l’équipe ft2e, la rochelle</span>
            </div>
            <div>
              <p class="text-[15px] text-pivot leading-[1.55]">
                Sept personnes — ingénieurs et projeteurs — qui suivent chacune leurs affaires de bout en bout, de l’étude au suivi de chantier.
              </p>
              <p class="mt-3 text-[15px] text-pivot leading-[1.55]">
                Une organisation à taille humaine, où la responsabilité est partagée et l’expertise mutualisée entre les quatre champs du nom.
              </p>
              <div class="mt-6">
                <Bouton href="/equipe" variante="primary">
                  Découvrir l’équipe
                </Bouton>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  {/* ── 07 · Maîtres d'ouvrage — bande calcaire, surface secondaire opaque sur la trame ── */}
  <section class="py-12 md:py-[76px] bg-calcaire border-t border-filet-1">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="flex items-center gap-3">
        <span class="puce-section" aria-hidden="true"></span>
        <span class="mono-label text-pivot">07 — maîtres d'ouvrage</span>
      </div>
      <h2 class="type-section text-[26px] mt-4">
        <span class="text-encre">Ils ont confié leurs projets à FT2E</span>
        <span class="text-clair" aria-hidden="true">/maîtres d'ouvrage et clients</span>
      </h2>
      <div class="flex flex-wrap gap-x-6 gap-y-2 mt-8">
        {partenaires.map((nom) => (
          <span class="type-intitule text-encre text-base">
            {nom}
          </span>
        ))}
      </div>
    </div>
  </section>

  <CtaFinal />
</PageLayout>
