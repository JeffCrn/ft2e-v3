---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import FAQ from '../../components/blocs/FAQ.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';
import CarteProjet from '../../components/blocs/CarteProjet.astro';
import JsonLd from '../../components/seo/JsonLd.astro';

export async function getStaticPaths() {
  const expertises = await getCollection('expertises');
  return expertises.map((expertise) => ({
    params: { slug: expertise.id },
    props: { expertise },
  }));
}

const { expertise } = Astro.props;
const { titre, accroche, livrables, typique_pour, faq, ordre } = expertise.data;
const { Content } = await render(expertise);

const numero = String(ordre).padStart(2, '0');

const projets = await getCollection('projets');
const missionsExpertise = expertise.data.missions_liees ?? [];
const projetsLies = projets
  .filter((p) => p.data.mission_ft2e.some((m) => missionsExpertise.includes(m)))
  .slice(0, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: titre,
  description: accroche,
  provider: {
    '@type': 'ProfessionalService',
    name: 'FT2E',
    url: 'https://ft2e.fr',
  },
  areaServed: ['La Rochelle', 'Charente-Maritime', 'Vendée', 'Deux-Sèvres'],
};
---

<PageLayout
  title={`${titre} — FT2E`}
  description={accroche}
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Expertises', href: '/expertises' },
      { label: titre, href: `/expertises/${expertise.id}` },
    ]}
    eyebrow={`expertise ${numero} — sur 6`}
    titre={titre}
    sousTitre={accroche}
  />

  {/* ─── Contenu (markdown) + panneau technique sur un plan posé ── */}
  <section class="py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="plan-pose p-5 md:p-10" data-plan>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          <div
            class="lg:col-span-7 max-w-[840px] text-[17px] text-pivot leading-[1.6] space-y-6
                   [&>h2]:text-encre [&>h2]:text-[20px] [&>h2]:border-t [&>h2]:border-filet-1 [&>h2]:pt-3.5
                   [&>h2]:mt-9 [&>h2]:mb-3.5
                   [&>h2:first-child]:mt-0
                   [&>h3]:text-encre [&>h3]:text-[17px] [&>h3]:font-semibold [&>h3]:[font-stretch:112%] [&>h3]:mt-8 [&>h3]:mb-3
                   [&>ul]:list-none [&>ul]:pl-0 [&>ul]:space-y-2
                   [&>ul>li]:border-l [&>ul>li]:border-filet-1 [&>ul>li]:pl-4
                   [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-2
                   [&_a]:text-encre [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-pivot
                   [&_strong]:text-encre [&_strong]:font-semibold"
          >
            <Content />
          </div>

          <aside class="lg:col-span-5">
            {livrables.length > 0 && (
              <Fragment>
                <h2 class="mono-label text-pivot mb-3.5">livrables</h2>
                <ul class="border border-filet-1 bg-calcaire list-none" role="list">
                  {livrables.map((l) => (
                    <li class="mono-data text-encre px-4 py-3 border-b border-filet-3 last:border-b-0">{l}</li>
                  ))}
                </ul>
              </Fragment>
            )}

            {typique_pour && typique_pour.length > 0 && (
              <Fragment>
                <h2 class="mono-label text-pivot mt-8 mb-3.5">typique pour</h2>
                <div class="flex flex-wrap gap-2">
                  {typique_pour.map((s) => (
                    <span class="etiquette-mission">{s}</span>
                  ))}
                </div>
              </Fragment>
            )}

            {faq && faq.length > 0 && (
              <Fragment>
                <h2 class="mono-label text-pivot mt-8 mb-3.5">questions fréquentes</h2>
                <FAQ items={faq} />
              </Fragment>
            )}
          </aside>
        </div>
      </div>
    </div>
  </section>

  {/* ─── Projets représentatifs ──────────────────── */}
  {projetsLies.length > 0 && (
    <section class="pb-16 md:pb-20">
      <div class="max-w-[1200px] mx-auto px-4 md:px-6">
        <div class="flex items-center gap-3">
          <span class="puce-section" aria-hidden="true"></span>
          <p class="mono-label text-pivot">références liées</p>
        </div>
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 mt-4 mb-6">
          <h2 class="type-section text-[22px] md:text-[24px]">
            <span class="text-encre">Projets représentatifs</span>
            <span class="text-clair" aria-hidden="true">/par mission</span>
          </h2>
          <a href="/references" class="mono-label font-normal text-pivot hover:text-encre motion-safe:transition-colors motion-safe:duration-[260ms] motion-safe:ease-[var(--ease-blueprint)]">
            voir toutes les références →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {projetsLies.map((p) => (
            <CarteProjet projet={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaFinal />

  <Fragment slot="json-ld">
    <JsonLd data={jsonLd} />
    {faq && faq.length > 0 && (
      <JsonLd data={{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((q) => ({
          '@type': 'Question',
          name: q.question,
          acceptedAnswer: { '@type': 'Answer', text: q.reponse },
        })),
      }} />
    )}
  </Fragment>
</PageLayout>
