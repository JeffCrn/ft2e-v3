---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import FAQ from '../../components/blocs/FAQ.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';
import CarteProjet from '../../components/blocs/CarteProjet.astro';
import JsonLd from '../../components/seo/JsonLd.astro';

export async function getStaticPaths() {
  const expertises = await getCollection('expertises');
  return expertises.map((expertise) => ({
    params: { slug: expertise.id },
    props: { expertise },
  }));
}

const { expertise } = Astro.props;
const { titre, accroche, livrables, typique_pour, faq, ordre } = expertise.data;
const { Content } = await render(expertise);

const numero = String(ordre).padStart(2, '0');

const projets = await getCollection('projets');
const missionsExpertise = expertise.data.missions_liees ?? [];
const projetsLies = projets
  .filter((p) => p.data.mission_ft2e.some((m) => missionsExpertise.includes(m)))
  .slice(0, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: titre,
  description: accroche,
  provider: {
    '@type': 'ProfessionalService',
    name: 'FT2E',
    url: 'https://ft2e.fr',
  },
  areaServed: ['La Rochelle', 'Charente-Maritime', 'Vendée', 'Deux-Sèvres'],
};
---

<PageLayout
  title={`${titre} — FT2E`}
  description={accroche}
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Expertises', href: '/expertises' },
      { label: titre, href: `/expertises/${expertise.id}` },
    ]}
    eyebrow={`expertise ${numero} — sur 6`}
    titre={titre}
    sousTitre={accroche}
  />

  {/* ─── Contenu (markdown) + panneau technique ── */}
  <section class="bg-cool-white py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div
        class="lg:col-span-7 text-[17px] font-light text-slate leading-[1.6] space-y-6
               [&>h2]:type-h2 [&>h2]:text-marine [&>h2]:text-[20px] [&>h2]:filet-top
               [&>h2]:mt-9 [&>h2]:mb-3.5
               [&>h2:first-child]:mt-0
               [&>h3]:type-h2 [&>h3]:text-marine [&>h3]:text-[17px] [&>h3]:mt-8 [&>h3]:mb-3
               [&>ul]:list-none [&>ul]:pl-0 [&>ul]:space-y-2
               [&>ul>li]:border-l [&>ul>li]:border-copper [&>ul>li]:pl-4
               [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-2
               [&_a]:text-marine [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-copper-text
               [&_strong]:text-marine [&_strong]:font-semibold"
        data-reveal
      >
        <Content />
      </div>

      <aside class="lg:col-span-5" data-reveal>
        {livrables.length > 0 && (
          <Fragment>
            <h2 class="mono-label text-slate mb-3.5">livrables</h2>
            <ul class="border border-line bg-paper list-none" role="list">
              {livrables.map((l) => (
                <li class="mono-data text-marine px-4 py-3 border-b border-line/60 last:border-b-0">{l}</li>
              ))}
            </ul>
          </Fragment>
        )}

        {typique_pour && typique_pour.length > 0 && (
          <Fragment>
            <h2 class="mono-label text-slate mt-8 mb-3.5">typique pour</h2>
            <div class="flex flex-wrap">
              {typique_pour.map((s) => (
                <span class="chip-blueprint -ml-px -mt-px">{s}</span>
              ))}
            </div>
          </Fragment>
        )}

        {faq && faq.length > 0 && (
          <Fragment>
            <h2 class="mono-label text-slate mt-8 mb-3.5">questions fréquentes</h2>
            <FAQ items={faq} />
          </Fragment>
        )}
      </aside>
    </div>
  </section>

  {/* ─── Projets représentatifs ──────────────────── */}
  {projetsLies.length > 0 && (
    <section class="bg-cool-white pb-16 md:pb-20">
      <div class="max-w-[1200px] mx-auto px-4 md:px-6">
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 mb-5" data-reveal>
          <h2 class="type-h2 text-marine text-[20px]">Projets représentatifs</h2>
          <a href="/references" class="mono-label font-normal text-slate hover:text-copper-text motion-safe:transition-colors motion-safe:duration-[400ms] motion-safe:ease-[var(--ease-blueprint)]">
            voir toutes les références <span class="chevron-arrow">→</span>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" data-reveal-stagger>
          {projetsLies.map((p) => (
            <CarteProjet projet={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaFinal />

  <Fragment slot="json-ld">
    <JsonLd data={jsonLd} />
    {faq && faq.length > 0 && (
      <JsonLd data={{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((q) => ({
          '@type': 'Question',
          name: q.question,
          acceptedAnswer: { '@type': 'Answer', text: q.reponse },
        })),
      }} />
    )}
  </Fragment>
</PageLayout>
