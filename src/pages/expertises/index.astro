---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';

const expertises = (await getCollection('expertises')).sort((a, b) => a.data.ordre - b.data.ordre);

// Le déroulé d'une mission complète — quatre temps (déplacé depuis la page Société le 2026-08-06).
const deroulesMission = [
  { n: '01', titre: 'L’accompagnement', texte: "Comprendre les besoins du maître d’ouvrage : visites de sites, réunions MOE/MOA, définition du programme. La proximité avec les projets rend cette disponibilité concrète." },
  { n: '02', titre: 'L’analyse', texte: "Faisabilité des besoins dans l’enveloppe budgétaire du projet. C’est ici que se jouent les choix techniques et leurs incidences financières — jusqu’aux études de faisabilité d’approvisionnement en énergie (FAE)." },
  { n: '03', titre: 'La conception', texte: "Études techniques conformes aux normes en vigueur, appuyées sur la veille réglementaire I-Reef et la qualification OPQIBI. Un lien étroit avec les fournisseurs maintient l’accès aux solutions nouvelles." },
  { n: '04', titre: 'Le suivi', texte: "Exécution conforme au cahier des charges et au planning : opérations préalables à la réception, levées de réserves, puis suivi des dysfonctionnements pendant l’année de parfait achèvement (GPA)." },
];
---

<PageLayout
  title="Expertises — FT2E"
  description="Audit et diagnostic, étude thermique, CVC, électricité CFO/CFA. Quatre métiers d’ingénierie pour vos projets de bâtiment en Charente-Maritime."
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Expertises', href: '/expertises' },
    ]}
    eyebrow="Domaines techniques"
    titre="Nos expertises"
    sousTitre="Quatre métiers d’ingénierie — l’audit et le diagnostic, la thermique réglementaire, le CVC, l’électricité CFO/CFA — mobilisés de l’étude de faisabilité à la réception des installations."
  />

  {/* ── 01 · L'approche : continuité conception-chantier + encart monotechnique ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="flex items-center gap-3">
        <span class="puce-section" aria-hidden="true"></span>
        <p class="mono-label text-pivot">01 — l’approche</p>
      </div>
      <h2 class="type-section text-[24px] md:text-[26px] mt-4 mb-8">
        <span class="text-encre">L’approche</span>
        <span class="text-clair" aria-hidden="true">/de la conception à la réalisation</span>
      </h2>

      <div class="plan-pose p-6 md:p-10" data-plan>
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-10 lg:gap-16 items-start">
          <div class="max-w-[840px] text-[17px] text-pivot leading-[1.6] space-y-6">
            <p>
              FT2E intervient à toutes les phases d’un projet de bâtiment. En amont, l’audit énergétique ou le diagnostic technique pose le cadre. En phase de conception, les ingénieurs dimensionnent les installations et rédigent les cahiers des charges. En phase DCE, ils produisent les pièces écrites des lots fluides, thermique, électricité et SSI. En phase chantier, ils assurent le visa des plans d’exécution, la coordination avec les entreprises titulaires et la réception des installations.
            </p>
            <p>
              Cette continuité entre la conception et la réalisation est ce qui distingue FT2E d’un bureau d’études intervenant uniquement en amont. Elle garantit que les choix techniques faits en conception sont effectivement réalisables — et réalisés — sur le chantier. L’ambition est constante&nbsp;: être un partenaire des projets, pas un simple prestataire d’études.
            </p>
          </div>

          <aside class="border border-filet-1 bg-calcaire p-6">
            <h3 class="mono-label text-pivot">au-delà des quatre métiers</h3>
            <p class="mt-4 text-[15px] text-pivot leading-[1.55]">
              Trois segments d’activité prolongent ces expertises et sont menés comme des missions à part entière — livrables, méthode et références sur leurs pages dédiées.
            </p>
            <ul class="mt-5 space-y-2.5 border-l border-filet-1 pl-4" role="list">
              {[
                { label: 'Monotechnique — Audit', href: '/secteurs/monotechnique' },
                { label: 'Coordination SSI', href: '/secteurs/coordination-ssi' },
                { label: 'Études d’exécution / BIM', href: '/secteurs/etudes-execution-bim' },
              ].map((segment) => (
                <li>
                  <a href={segment.href} class="mono-data text-encre underline underline-offset-2 hover:text-pivot transition-colors duration-[260ms] ease-[var(--ease-blueprint)]">
                    {segment.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </div>
  </section>

  {/* ── 02 · Les six expertises en cellules de liste (charte v3 § 10) ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="flex items-center gap-3">
        <span class="puce-section" aria-hidden="true"></span>
        <p class="mono-label text-pivot">02 — expertises</p>
      </div>
      <h2 class="type-section text-[24px] md:text-[26px] mt-4">
        <span class="text-encre">Quatre</span>
        <span class="text-clair" aria-hidden="true">/expertises</span>
      </h2>
      <p class="mono-label font-normal text-pivot mt-3">livrables, méthode et projets — le détail par domaine</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mt-8">
        {expertises.map((expertise) => {
          const numero = String(expertise.data.ordre).padStart(2, '0');
          return (
            <a href={`/expertises/${expertise.id}`} class="cellule-liste lg:min-h-[168px]">
              <span class="mono-label font-normal text-pivot tabular-nums" aria-hidden="true">{numero}</span>
              <span class="type-intitule text-encre text-[17px] md:text-[19px] mt-auto self-end text-right pt-6">
                {expertise.data.titre}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* ── 03 · Le déroulé d'une mission complète ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="flex items-center gap-3">
        <span class="puce-section" aria-hidden="true"></span>
        <p class="mono-label text-pivot">03 — déroulé d’une mission</p>
      </div>
      <h2 class="type-section text-[24px] md:text-[26px] mt-4">
        <span class="text-encre">Le déroulé</span>
        <span class="text-clair" aria-hidden="true">/d’une mission</span>
      </h2>
      <p class="mono-label font-normal text-pivot mt-3">des pré-études à l’année de parfait achèvement</p>

      <div class="plan-pose mt-8" data-plan>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-filet-2">
          {deroulesMission.map((temps) => (
            <div class="p-6 bg-papier">
              <span class="mono-label font-normal text-pivot tabular-nums" aria-hidden="true">{temps.n}</span>
              <h3 class="type-intitule text-encre text-[18px] mt-3">{temps.titre}</h3>
              <p class="mt-3 text-[15px] text-pivot leading-[1.55]">{temps.texte}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaFinal titre={"Quelle expertise pour votre projet ?"} texte="Décrivez-nous votre programme — nous identifierons les lots techniques à mobiliser." />
</PageLayout>
