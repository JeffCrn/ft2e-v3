---
import PageLayout from '../layouts/PageLayout.astro';
import HeroPage from '../components/blocs/HeroPage.astro';
import Bouton from '../components/primitives/Bouton.astro';
---

<PageLayout
  title="Page introuvable — FT2E"
  description="La page que vous cherchez n’existe pas ou a été déplacée."
  noindex={true}
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Page introuvable', href: '/404' },
    ]}
    eyebrow="erreur — référence introuvable"
    titre="Page introuvable"
    sousTitre="La page que vous cherchez n’existe pas ou a été déplacée. Revenez à l’accueil pour continuer votre navigation."
    size="compact"
  />

  <section class="pb-20 md:pb-28">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      {/* Le code d’erreur en relevé (charte v3 § 11) : le seul chiffre
          plein encre de l’écran. */}
      <p class="releve-chiffre text-encre text-[clamp(3.5rem,7vw,5.75rem)]" aria-hidden="true">404</p>
      <div class="mt-10">
        <Bouton href="/" variante="primary">Retour à l’accueil&nbsp;→</Bouton>
      </div>
    </div>
  </section>
</PageLayout>
