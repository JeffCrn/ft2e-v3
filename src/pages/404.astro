---
import PageLayout from '../layouts/PageLayout.astro';
import Bouton from '../components/primitives/Bouton.astro';
---

<PageLayout
  title="Page introuvable — FT2E"
  description="La page que vous cherchez n’existe pas ou a été déplacée."
  noindex={true}
>
  <section class="bg-cool-white py-24 md:py-32">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <p class="mono-label text-copper mb-6">erreur — référence introuvable</p>
      <p class="type-display text-marine text-[clamp(4rem,10vw,8rem)]" aria-hidden="true">404</p>
      <h1 class="type-h2 text-marine text-[22px] mt-6">
        Page introuvable
      </h1>
      <p class="mt-4 text-[17px] font-light text-slate leading-[1.6] max-w-[52ch]">
        La page que vous cherchez n’existe pas ou a été déplacée. Revenez à l’accueil pour continuer votre navigation.
      </p>
      <div class="mt-8">
        <Bouton href="/" variante="primary">Retour à l’accueil&nbsp;→</Bouton>
      </div>
    </div>
  </section>
</PageLayout>
