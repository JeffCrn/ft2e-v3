---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import BadgeDemo from '../../components/primitives/BadgeDemo.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';
import JsonLd from '../../components/seo/JsonLd.astro';

export async function getStaticPaths() {
  const articles = await getCollection('actualites');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { titre, chapo, date, auteur, categories, demo } = article.data;
const { Content } = await render(article);

const dateFormatee = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titre,
  description: chapo,
  datePublished: date.toISOString(),
  author: {
    '@type': 'Organization',
    name: auteur ?? 'FT2E',
  },
};
---

<PageLayout
  title={`${titre} — FT2E`}
  description={chapo}
  ogType="article"
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Actualités', href: '/actualites' },
      { label: titre, href: `/actualites/${article.id}` },
    ]}
    eyebrow={categories[0]}
    titre={titre}
    sousTitre={chapo}
  >
    <div slot="metadata" class="flex items-baseline gap-4 flex-wrap">
      <time datetime={date.toISOString().split('T')[0]} class="mono-data text-pivot">
        {dateFormatee}
      </time>
      {auteur && (
        <>
          <span class="text-pivot" aria-hidden="true">/</span>
          <span class="mono-data text-pivot">Par {auteur}</span>
        </>
      )}
      {demo && <BadgeDemo />}
    </div>
  </HeroPage>

  <article class="bg-papier py-14 md:py-16">
    <div class="max-w-[840px] mx-auto px-4 md:px-6">
      <div
        class="text-[17px] font-normal text-pivot leading-[1.6] space-y-6
               [&>h2]:type-h2 [&>h2]:text-encre [&>h2]:text-[20px] [&>h2]:filet-top
               [&>h2]:mt-9 [&>h2]:mb-3.5
               [&>h2:first-child]:mt-0
               [&>h3]:type-h2 [&>h3]:text-encre [&>h3]:text-[17px] [&>h3]:mt-8 [&>h3]:mb-3
               [&>ul]:list-none [&>ul]:pl-0 [&>ul]:space-y-2
               [&>ul>li]:border-l [&>ul>li]:border-line-strong [&>ul>li]:pl-4
               [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-2
               [&_a]:text-encre [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-pivot
               [&_strong]:text-encre [&_strong]:font-semibold"
       
      >
        <Content />
      </div>
    </div>
  </article>

  <CtaFinal />

  <Fragment slot="json-ld">
    <JsonLd data={jsonLd} />
  </Fragment>
</PageLayout>
