---
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import CarteProjet from '../../components/blocs/CarteProjet.astro';
import CoinsCuivre from '../../components/primitives/CoinsCuivre.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';

export async function getStaticPaths() {
  const secteurs = await getCollection('secteurs');
  return secteurs.map((secteur) => ({
    params: { slug: secteur.id },
    props: { secteur },
  }));
}

const { secteur } = Astro.props;
const { titre, accroche, image, image_alt, ordre } = secteur.data;
const { Content } = await render(secteur);

const numero = String(ordre).padStart(2, '0');
const imageExiste = fs.existsSync(path.join(process.cwd(), 'public', image));

const projetsSecteur = (await getCollection('projets'))
  .filter((p) => p.data.secteur === titre)
  .sort((a, b) => b.data.annee - a.data.annee);
---

<PageLayout
  title={`Secteur ${titre} — FT2E`}
  description={accroche}
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: titre, href: `/secteurs/${secteur.id}` },
    ]}
    eyebrow={`secteur ${numero} — sur 7`}
    titre={titre}
    sousTitre={accroche}
  />

  {/* ── Récit du secteur + image duotone sur un plan posé ── */}
  <section class="py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="plan-pose p-5 md:p-10" data-plan>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          <div
            class="lg:col-span-7 max-w-[840px] text-[17px] text-pivot leading-[1.6] space-y-6
                   [&_a]:text-encre [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-pivot
                   [&_strong]:text-encre [&_strong]:font-semibold"
          >
            <Content />
          </div>

          <div class="lg:col-span-5">
            <div class="relative">
              <div class:list={['w-full aspect-[3/2]', imageExiste ? 'duotone-photo' : 'duotone-media']}>
                {imageExiste && (
                  <img
                    src={image}
                    alt={image_alt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                )}
                <span class:list={['absolute left-4 bottom-3 mono-label font-normal z-10', imageExiste ? 'text-voile' : 'text-pivot']} aria-hidden="true">
                  secteur {titre.toLowerCase()}
                </span>
              </div>
              <CoinsCuivre />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Projets du secteur ── */}
  {projetsSecteur.length > 0 && (
    <section class="pb-16 md:pb-20">
      <div class="max-w-[1200px] mx-auto px-4 md:px-6">
        <div class="flex items-center gap-3">
          <span class="puce-section" aria-hidden="true"></span>
          <p class="mono-label text-pivot">références du secteur</p>
        </div>
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 mt-4 mb-6">
          <h2 class="type-section text-[22px] md:text-[24px]">
            <span class="text-encre">Références</span>
            <span class="text-clair" aria-hidden="true">/{titre.toLowerCase()}</span>
          </h2>
          <a href="/references" class="mono-label font-normal text-pivot hover:text-encre motion-safe:transition-colors motion-safe:duration-[260ms] motion-safe:ease-[var(--ease-blueprint)]">
            voir toutes les références →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {projetsSecteur.slice(0, 4).map((p) => (
            <CarteProjet projet={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaFinal />
</PageLayout>
