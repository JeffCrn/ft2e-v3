---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroPage from '../../components/blocs/HeroPage.astro';
import CarteProjet from '../../components/blocs/CarteProjet.astro';
import CoinsCuivre from '../../components/primitives/CoinsCuivre.astro';
import CtaFinal from '../../components/blocs/CtaFinal.astro';
import FAQ from '../../components/blocs/FAQ.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { parAffaireDecroissante } from '../../lib/projets';
import { photoSecteur } from '../../lib/photos';

export async function getStaticPaths() {
  const secteurs = await getCollection('secteurs');
  return secteurs.map((secteur) => ({
    params: { slug: secteur.id },
    props: { secteur },
  }));
}

const { secteur } = Astro.props;
const { titre, accroche, cliches, ordre, livrables, faq } = secteur.data;
const { Content } = await render(secteur);

const numero = String(ordre).padStart(2, '0');

/* Le premier cliché du CORPUS illustre la page du secteur — stable d'un
   build à l'autre, contrairement au film de l'accueil qui est tiré.
   `photoSecteur` rend null si le fichier n'est pas encore poussé : la
   page bascule alors sur la hachure, elle ne casse pas. */
const [cliche] = cliches;
const photo = photoSecteur(cliche.image);

const projetsSecteur = (await getCollection('projets'))
  .filter((p) => p.data.secteur === titre)
  .sort(parAffaireDecroissante);
---

<PageLayout
  title={`Secteur ${titre} — FT2E`}
  description={accroche}
>
  <HeroPage
    breadcrumbs={[
      { label: 'Accueil', href: '/' },
      { label: titre, href: `/secteurs/${secteur.id}` },
    ]}
    eyebrow={`secteur ${numero} — sur 7`}
    titre={titre}
    sousTitre={accroche}
  />

  {/* ── Récit du secteur + image duotone sur un plan posé ── */}
  <section class="py-14 md:py-16">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6">
      <div class="plan-pose p-5 md:p-10" data-plan>
        {/* Trois éléments de grille, et non deux colonnes imbriquées : c'est ce
            qui permet à l'image de passer EN TÊTE sur petit écran sans être
            dupliquée dans le DOM, et de rester en haut de la colonne de droite
            sur grand écran. L'ordre du DOM est l'ordre mobile — image, récit,
            livrables et FAQ ; le placement explicite (`lg:col-start`,
            `lg:row-start`) recompose les deux colonnes au-delà de `lg`.

            `lg:gap-y-8` reproduit exactement l'écart de 32 px que portait le
            `mt-8` du premier titre quand image et livrables vivaient dans le
            même conteneur — d'où le `first:mt-0` sur les titres ci-dessous,
            sans quoi l'écart serait compté deux fois. */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-x-16 lg:gap-y-8 items-start">
          <div class="lg:col-start-8 lg:col-span-5 lg:row-start-1">
            <div class="relative">
              <div class:list={['w-full aspect-[3/2]', photo ? 'duotone-photo' : 'duotone-media']}>
                {photo && (
                  <Picture
                    src={photo}
                    formats={['avif', 'webp']}
                    widths={[400, 640, 880]}
                    sizes="(min-width: 1024px) 440px, calc(100vw - 40px)"
                    alt={cliche.alt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                )}
                <span class="cartouche-legende legende-media z-10" aria-hidden="true">
                  {cliche.legende}
                </span>
              </div>
              <CoinsCuivre />
            </div>
          </div>

          <div
            class="lg:col-start-1 lg:col-span-7 lg:row-start-1 lg:row-span-2 max-w-[840px] text-[17px] text-pivot leading-[1.6] space-y-6
                   [&>h2]:text-encre [&>h2]:text-[20px] [&>h2]:border-t [&>h2]:border-filet-1 [&>h2]:pt-3.5
                   [&>h2]:mt-9 [&>h2]:mb-3.5
                   [&>h3]:text-encre [&>h3]:text-[17px] [&>h3]:font-semibold [&>h3]:[font-stretch:112%] [&>h3]:mt-8 [&>h3]:mb-3
                   [&_a]:text-encre [&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-[3px] [&_a:hover]:decoration-2
                   [&_strong]:text-encre [&_strong]:font-semibold"
          >
            <Content />
          </div>

          <div class="lg:col-start-8 lg:col-span-5 lg:row-start-2">
            {livrables && livrables.length > 0 && (
              <Fragment>
                <h2 class="mono-label text-pivot mt-8 first:mt-0 mb-3.5">livrables</h2>
                <ul class="border border-filet-1 bg-calcaire list-none" role="list">
                  {livrables.map((l) => (
                    <li class="mono-data text-encre px-4 py-3 border-b border-filet-3 last:border-b-0">{l}</li>
                  ))}
                </ul>
              </Fragment>
            )}

            {faq && faq.length > 0 && (
              <Fragment>
                <h2 class="mono-label text-pivot mt-8 first:mt-0 mb-3.5">questions fréquentes</h2>
                <FAQ items={faq} />
              </Fragment>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Projets du secteur ── */}
  {projetsSecteur.length > 0 && (
    <section class="pb-16 md:pb-20">
      <div class="max-w-[1200px] mx-auto px-4 md:px-6">
        <div class="flex items-center gap-3">
          <span class="puce-section" aria-hidden="true"></span>
          <p class="mono-label text-pivot">références du secteur</p>
        </div>
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 mt-4 mb-6">
          <h2 class="type-section text-[22px] md:text-[24px]">
            <span class="text-encre">Références</span>
            <span class="text-clair" aria-hidden="true">/{titre.toLowerCase()}</span>
          </h2>
          <a href="/references" class="mono-label font-normal text-pivot hover:text-encre motion-safe:transition-colors motion-safe:duration-[260ms] motion-safe:ease-[var(--ease-blueprint)]">
            voir toutes les références →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {projetsSecteur.slice(0, 4).map((p) => (
            <CarteProjet projet={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaFinal />

  <Fragment slot="json-ld">
    {faq && faq.length > 0 && (
      <JsonLd data={{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((q) => ({
          '@type': 'Question',
          name: q.question,
          acceptedAnswer: { '@type': 'Answer', text: q.reponse },
        })),
      }} />
    )}
  </Fragment>
</PageLayout>
